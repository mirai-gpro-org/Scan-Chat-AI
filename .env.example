# --- Gemini ---
# サーバ側で使用する Gemini REST / Vision API キー
GEMINI_API_KEY=

# --- Supabase ---
# クライアント公開用
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# サーバ専用（service_role）
SUPABASE_SERVICE_ROLE_KEY=

# --- HP/EC #1 連携 (app_bridge / Edge Functions) ---
# Web は #1 の app_bridge スキーマのみを read-only で参照する。
# 未設定なら dev フォールバック (customer モックスキーマ) を使用。
# #1 Project URL
HP_BRIDGE_SUPABASE_URL=
# HP 発行の restricted ロール (app_bridge_readonly) JWT / キー（サーバ専用）
HP_BRIDGE_READONLY_KEY=
# HP Edge Function のベース URL (resolve-customer / kit-self-report)。通常は #1 Project URL。
HP_EDGE_BASE_URL=
# サーバー間共有シークレット（x-resolve-secret ヘッダ）。HP 生成・Vault 等で受領。クライアント非公開。
RESOLVE_SHARED_SECRET=

# --- テストフェーズ: ダミー表示フォールバック ---
# 実データ(検査履歴/お知らせ)が空の顧客に共通のダミーを表示する。
# 既定 ON。本番で切るときだけ false を設定。
PUBLIC_DEMO_FALLBACK=true

# --- 音声 LiveAPI (Chatty-sp Cloud Run) ---
# クライアントから WebSocket 接続するエンドポイント
PUBLIC_VOICE_BACKEND_URL=

# --- AI スキャン結果の S3 書き出し (Elith 連携・テスト) ---
# サーバ専用。AWS_REGION が「書き出し有効化スイッチ」。
#   未設定 → 変換のみ(ドライラン)。設定 → S3 へ自動アップロード。
AWS_REGION=ap-northeast-1
# 書き出し先バケット (既定: wellfort-ai-input)。変更時のみ設定。
AWS_S3_BUCKET=wellfort-ai-input
# バケット内共通プレフィックス (既定: scan-accuracy-test/・末尾スラッシュ自動付与)
AWS_S3_PREFIX=scan-accuracy-test/
# 明示クレデンシャル (任意。未指定なら IAM ロール等 SDK 既定チェーンを使用)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3 互換エンドポイント (MinIO 等。任意)
AWS_S3_ENDPOINT=

# --- admin バッチ連携 (wellfort-site → Scan-Chat-AI API の Bearer 認証) ---
# 仕様: wellfort_admin_lab_upload_spec §6-1。wellfort-site 側は SCAN_CHAT_AI_API_KEY に同値。
# 未設定(dev)なら認証省略。
ADMIN_API_KEY=
