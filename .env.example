# --- Gemini ---
# サーバ側で使用する Gemini REST / Vision API キー
GEMINI_API_KEY=

# --- Supabase ---
# クライアント公開用
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# サーバ専用（service_role）
SUPABASE_SERVICE_ROLE_KEY=

# --- 音声 LiveAPI (Chatty-sp Cloud Run) ---
# クライアントから WebSocket 接続するエンドポイント
PUBLIC_VOICE_BACKEND_URL=

# --- AI スキャン結果の S3 書き出し (Elith 連携・テスト) ---
# サーバ専用。未設定でもアプリは動作し、書き出しは「変換のみ(ドライラン)」になる。
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-1
# バケット内共通プレフィックス (任意・末尾スラッシュは自動付与)
AWS_S3_PREFIX=scan-accuracy-test/
# 明示クレデンシャル (任意。未指定なら SDK 既定のチェーンを使用)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3 互換エンドポイント (MinIO 等。任意)
AWS_S3_ENDPOINT=
