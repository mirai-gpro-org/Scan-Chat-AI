{
  "name": "scan-chat-ai",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Scan-Chat Medical AI — pilot scaffold (Astro + Tailwind + Vercel + Gemini)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "verify:blood-csv": "esbuild scripts/verify-blood-csv-structure.ts --bundle --platform=node --format=esm | node --input-type=module",
    "verify:report-model": "esbuild scripts/verify-report-model.ts --bundle --platform=node --format=esm --log-level=error \"--define:import.meta.env={}\" | node --input-type=module",
    "verify:sheet-contract": "esbuild scripts/verify-sheet-contract.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/verify-sheet-contract.mjs && node node_modules/.cache/verify-sheet-contract.mjs",
    "verify:screen": "node scripts/verify-screen.mjs",
    "verify:report": "npm run verify:report-model && npm run verify:sheet-contract && npm run verify:demo-gate",
    "verify:demo-gate": "node scripts/verify-demo-gate.mjs",
    "verify:intake-scope": "tsx scripts/verify-intake-scope.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^8.2.11",
    "@aws-sdk/client-s3": "^3.1072.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@google/genai": "^2.6.0",
    "@lucide/astro": "^1.31.0",
    "@supabase/supabase-js": "^2.46.1",
    "astro": "^5.18.2",
    "marked": "^18.0.4",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
