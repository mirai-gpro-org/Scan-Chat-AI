---
interface Props {
  /** 進捗 0-100 */
  value?: number;
  /** 補助ラベル（"問診の進捗" など） */
  label?: string;
  /** 現在進行中のセクションタイトル（"4. 睡眠について" など） */
  section?: string;
  id?: string;
}

const { value = 0, label = '問診の進捗状況', section = '', id = 'progress-bar' } = Astro.props;
const clamped = Math.max(0, Math.min(100, value));
---

<div class="w-full" data-progress-root={id}>
  <div class="mb-1 flex items-center justify-between text-xs text-slate-600">
    <span>
      {label}
      {section && (
        <span class="ml-1 font-medium text-slate-800" data-progress-section>{section}</span>
      )}
      {!section && (
        <span class="ml-1 font-medium text-slate-800" data-progress-section></span>
      )}
    </span>
    <span data-progress-text>{clamped}%</span>
  </div>
  <div
    class="h-2 w-full overflow-hidden rounded-full bg-slate-200"
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={clamped}
  >
    <div
      class="h-full rounded-full bg-brand-600 transition-[width] duration-300 ease-out"
      style={`width: ${clamped}%`}
      data-progress-fill
    >
    </div>
  </div>
</div>
