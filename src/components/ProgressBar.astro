---
interface Props {
  /** 進捗 0-100 */
  value?: number;
  label?: string;
  id?: string;
}

const { value = 0, label, id = 'progress-bar' } = Astro.props;
const clamped = Math.max(0, Math.min(100, value));
---

<div class="w-full" data-progress-root={id}>
  {label && (
    <div class="mb-1 flex items-center justify-between text-xs text-slate-600 dark:text-slate-300">
      <span>{label}</span>
      <span data-progress-text>{clamped}%</span>
    </div>
  )}
  <div
    class="h-2 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800"
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={clamped}
  >
    <div
      class="h-full rounded-full bg-brand-600 transition-[width] duration-300 ease-out"
      style={`width: ${clamped}%`}
      data-progress-fill
    >
    </div>
  </div>
</div>
