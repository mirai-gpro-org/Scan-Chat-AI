---
/**
 * Google One Tap (GSI client) + Supabase Auth 統合。
 *
 * 動作:
 *   1. Google GSI client を非同期ロード
 *   2. One Tap UI を自動表示 (PUBLIC_GOOGLE_CLIENT_ID が設定済 + ?u= が無いとき)
 *   3. 認証成功 → Supabase signInWithIdToken で session 作成
 *   4. デモ用 email → diagnostic_user_id mapping を解決
 *   5. URL に ?u=<uuid> を付けて reload (既存ルーティングと互換)
 *
 * 環境変数: PUBLIC_GOOGLE_CLIENT_ID
 *   未設定なら何もレンダリングしない (フォールバック: ?u= 直渡し)
 */
const clientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ?? '';
const enabled = !!clientId;
---

{enabled && (
  <>
    {/* Google Identity Services client (async load) */}
    <script async defer src="https://accounts.google.com/gsi/client"></script>

    {/* One Tap init (callback は下の <script> で window に登録) */}
    <div
      id="g_id_onload"
      data-client_id={clientId}
      data-callback="__scanChatOnGoogleSignIn"
      data-auto_prompt="true"
      data-cancel_on_tap_outside="false"
      data-context="signin"
    ></div>

    <script>
      import { createClient } from '@supabase/supabase-js';

      const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL as string;
      const supabaseAnon = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string;

      /** デモ専用: 特定メールアドレスをシード済 user に強制マッピング */
      const DEMO_EMAIL_TO_UID: Record<string, string> = {
        'hamada@eentry.co.jp': 'd0000001-0000-0000-0000-000000000000',
      };

      /** すでに ?u= が URL にある場合は One Tap を抑制 (フォールバックモード) */
      const params = new URLSearchParams(window.location.search);
      if (params.has('u') && params.get('u')) {
        // GSI が読み込まれた後に cancel
        const cancelOneTap = () => {
          const g = (window as unknown as { google?: { accounts?: { id?: { cancel: () => void } } } }).google;
          if (g?.accounts?.id) g.accounts.id.cancel();
        };
        // 数回試行 (GSI 読込タイミング不定)
        setTimeout(cancelOneTap, 500);
        setTimeout(cancelOneTap, 1500);
        setTimeout(cancelOneTap, 3000);
      }

      type GsiResponse = { credential: string };

      // Google One Tap のコールバック (data-callback の名前と一致)
      (window as unknown as Record<string, unknown>).__scanChatOnGoogleSignIn = async (response: GsiResponse) => {
        try {
          if (!supabaseUrl || !supabaseAnon) {
            console.error('PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY が未設定');
            return;
          }
          const sb = createClient(supabaseUrl, supabaseAnon);

          // Google ID Token を Supabase Auth に渡してセッション作成
          const { data, error } = await sb.auth.signInWithIdToken({
            provider: 'google',
            token: response.credential,
          });
          if (error) {
            console.error('Supabase auth error:', error);
            alert(`認証エラー: ${error.message}`);
            return;
          }
          const user = data.user;
          const email = user?.email?.toLowerCase() ?? '';
          if (!email) return;

          // デモ用: 既知のメールアドレスはシード済 user にマッピング
          const fixed = DEMO_EMAIL_TO_UID[email];
          if (fixed) {
            const url = new URL(window.location.href);
            url.searchParams.set('u', fixed);
            window.location.replace(url.toString());
            return;
          }

          // 一般ユーザー: app_users へ upsert
          const sub = (user.user_metadata as Record<string, string> | undefined)?.sub ?? '';
          const displayName = (user.user_metadata as Record<string, string> | undefined)?.full_name ?? email;
          const csb = sb.schema('diagnosis');
          await csb.from('app_users').upsert(
            {
              auth_user_id: user.id,
              google_sub: sub,
              display_name_cache: displayName,
              eligibility_checked_at: new Date().toISOString(),
            } as never,
            { onConflict: 'auth_user_id' },
          );

          // 取得し直して diagnostic_user_id を URL に付与
          const { data: appUser } = await csb
            .from('app_users')
            .select('diagnostic_user_id')
            .eq('auth_user_id', user.id)
            .maybeSingle();
          if (appUser?.diagnostic_user_id) {
            const url = new URL(window.location.href);
            url.searchParams.set('u', appUser.diagnostic_user_id);
            window.location.replace(url.toString());
          } else {
            // diagnostic_user_id が未生成 → リロードのみ
            window.location.reload();
          }
        } catch (err) {
          console.error('One Tap callback error:', err);
        }
      };
    </script>
  </>
)}
