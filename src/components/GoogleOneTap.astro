---
/**
 * Google One Tap (GSI client) + Supabase Auth 統合。
 *
 * JavaScript API 方式 (g_id_onload は使わない) で初期化する。
 * HTML data-callback 方式だと、GSI client 初期化時に
 * `window[data-callback]` が未定義 → "callback is not a function"
 * エラーで config が捨てられる race condition があるため。
 *
 * 動作:
 *   1. Google GSI client を非同期ロード (<script is:inline async>)
 *   2. bundled module: handleCredentialResponse() を定義
 *   3. google.accounts.id が ready になったら initialize() で
 *      function 参照を直接渡し、prompt() で One Tap 起動
 *   4. 認証成功 → signInWithIdToken → ?u=<uid> に redirect
 *
 * iOS Safari / ITP ブラウザ対応: itp_support: true
 *
 * 環境変数: PUBLIC_GOOGLE_CLIENT_ID
 *   未設定なら何もレンダリングしない (フォールバック: ?u= 直渡し)
 */
const clientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ?? '';
const enabled = !!clientId;
---

{enabled && (
  <>
    {/* Google Identity Services client (async load) */}
    <script is:inline async defer src="https://accounts.google.com/gsi/client"></script>

    <script>
      import { createClient } from '@supabase/supabase-js';

      const supabaseUrl  = import.meta.env.PUBLIC_SUPABASE_URL as string;
      const supabaseAnon = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string;
      const clientId     = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID as string;

      /** デモ専用: 特定メールアドレスをシード済 user に強制マッピング */
      const DEMO_EMAIL_TO_UID: Record<string, string> = {
        'unfix.hamada@gmail.com':   '14410d5a-d515-4fe9-9a8e-bbb1040021ac',
        'miyazawa@wellfort.co.jp':  '1c1ded05-6cce-4880-a5d8-3f964a43ba54',
        'shindo@wellfort.co.jp':    '46b3651a-f14b-46bd-a24f-fe01256a1709',
        'ohkawa@wellfort.co.jp':    '7cbe6588-5a99-4068-9c40-5fa2427c7122',
        'okabe@wellfort.co.jp':     'f9d47b45-45ad-4ffc-bad3-1bf4de130a1c',
        'honda@wellfort.co.jp':     'c0000020-0000-0000-0000-000000000000',
        'hamada@eentry.co.jp':      'd0000001-0000-0000-0000-000000000000',
      };

      type GsiCredentialResponse = { credential: string };
      type GsiId = {
        initialize: (cfg: Record<string, unknown>) => void;
        prompt: (cb?: (n: unknown) => void) => void;
        cancel: () => void;
      };

      async function handleCredentialResponse(response: GsiCredentialResponse) {
        console.log('[OneTap] callback fired, credential length:', response.credential?.length ?? 0);
        try {
          if (!supabaseUrl || !supabaseAnon) {
            console.error('[OneTap] PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY が未設定');
            alert('Supabase 環境変数が未設定です');
            return;
          }
          const sb = createClient(supabaseUrl, supabaseAnon);

          console.log('[OneTap] calling signInWithIdToken…');
          const { data, error } = await sb.auth.signInWithIdToken({
            provider: 'google',
            token: response.credential,
          });
          if (error) {
            console.error('[OneTap] Supabase auth error:', error);
            alert(`認証エラー: ${error.message}`);
            return;
          }
          const user = data.user;
          const email = user?.email?.toLowerCase() ?? '';
          console.log('[OneTap] signInWithIdToken OK, email:', email, 'uid:', user?.id);
          if (!email) {
            alert('Google から email を取得できませんでした');
            return;
          }

          const url = new URL(window.location.href);
          if (url.pathname === '/' || url.pathname === '') url.pathname = '/dashboard';

          const fixed = DEMO_EMAIL_TO_UID[email];
          if (fixed) {
            url.searchParams.set('u', fixed);
            console.log('[OneTap] demo email match → redirect:', url.toString());
            window.location.replace(url.toString());
            return;
          }

          console.log('[OneTap] non-demo email, upserting app_users…');
          const sub = (user.user_metadata as Record<string, string> | undefined)?.sub ?? '';
          const displayName = (user.user_metadata as Record<string, string> | undefined)?.full_name ?? email;
          const csb = sb.schema('diagnosis');
          const { error: upsertErr } = await csb.from('app_users').upsert(
            {
              auth_user_id: user.id,
              google_sub: sub,
              display_name_cache: displayName,
              eligibility_checked_at: new Date().toISOString(),
            } as never,
            { onConflict: 'auth_user_id' },
          );
          if (upsertErr) {
            console.error('[OneTap] app_users upsert error:', upsertErr);
            alert(`プロフィール登録失敗: ${upsertErr.message}`);
            return;
          }

          const { data: appUser } = await csb
            .from('app_users')
            .select('diagnostic_user_id')
            .eq('auth_user_id', user.id)
            .maybeSingle();
          if (appUser?.diagnostic_user_id) {
            url.searchParams.set('u', appUser.diagnostic_user_id);
            console.log('[OneTap] redirect:', url.toString());
            window.location.replace(url.toString());
          } else {
            console.warn('[OneTap] no diagnostic_user_id for', user.id);
            alert('お客様情報が見つかりません。サポートまでご連絡ください。');
          }
        } catch (err) {
          console.error('[OneTap] callback exception:', err);
          alert(`サインイン処理エラー: ${err instanceof Error ? err.message : String(err)}`);
        }
      }

      /** GSI client が ready になるまで待つ */
      function whenGsiReady(cb: (gsi: GsiId) => void, attempts = 50): void {
        const gsi = (window as unknown as { google?: { accounts?: { id?: GsiId } } }).google?.accounts?.id;
        if (gsi) { cb(gsi); return; }
        if (attempts <= 0) return;
        setTimeout(() => whenGsiReady(cb, attempts - 1), 100);
      }

      console.log('[OneTap] module loaded, clientId:', clientId ? `${clientId.slice(0, 10)}…` : '(missing)');

      whenGsiReady((gsi) => {
        console.log('[OneTap] GSI ready, initializing…');
        gsi.initialize({
          client_id: clientId,
          callback: handleCredentialResponse,
          auto_select: false,
          cancel_on_tap_outside: false,
          itp_support: true,
          context: 'signin',
        });

        const params = new URLSearchParams(window.location.search);
        if (params.has('u') && params.get('u')) {
          console.log('[OneTap] ?u= present, skip prompt');
          return;
        }

        console.log('[OneTap] calling prompt()');
        gsi.prompt((notification: unknown) => {
          console.log('[OneTap] prompt notification:', notification);
        });
      });
    </script>
  </>
)}
