---
import AppIcon from '../AppIcon.astro';
import type { MeasurementItem } from '../../lib/measurement-queries';

/**
 * 検査値 1 項目のカード。
 *
 * 【原則】アプリは判定を作らない。
 *   表示するのは 検査票の値・単位・基準値 と、**検査機関が付けた** flag / assessment のみ。
 *   「要警戒」「正常」等のアプリ独自ラベルは付けない (旧実装の level/comment は撤去)。
 */

interface Props {
  item: MeasurementItem;
  /** 原本へのリンク (任意) */
  href?: string | null;
}
const { item, href = null } = Astro.props as Props;

const flagged = item.flag != null;
const flagText = item.flag === 'H' ? '基準値より高い' : '基準値より低い';

// 基準値は検査票の表記をそのまま組み立てる (アプリで丸めたり言い換えたりしない)。
const refText =
  item.refLow && item.refHigh ? `${item.refLow}〜${item.refHigh}`
  : item.refHigh ? `〜${item.refHigh}`
  : item.refLow ? `${item.refLow}〜`
  : null;

const Tag = href ? 'a' : 'div';
---

<Tag
  href={href ?? undefined}
  class={`flex flex-col gap-1.5 rounded-2xl border bg-white p-4 transition-colors ${
    flagged ? 'border-status-watch' : 'border-slate-200'
  } ${href ? 'hover:border-brand-400' : ''}`}
>
  <span class="text-sm font-medium text-slate-600">{item.name}</span>

  <span class="flex items-baseline gap-1.5">
    <span class="tnum text-3xl font-bold text-slate-900">{item.value ?? '—'}</span>
    {item.unit && <span class="text-sm text-slate-600">{item.unit}</span>}
  </span>

  {/* 検査機関が印を付けたときだけ出す。印が無い＝アプリが「基準値内」と判定してよい
      わけではないため、null では何も表示しない。 */}
  {flagged && (
    <span class="status-pill status-watch self-start">
      <AppIcon name="watch" size={14} />
      {flagText}
    </span>
  )}

  {refText && <span class="tnum text-sm text-slate-600">基準値 {refText}</span>}

  {item.assessment && (
    <span class="text-sm text-slate-600">検査機関の判定コード: {item.assessment}</span>
  )}

  {href && (
    <span class="mt-1 inline-flex items-center gap-1 text-sm font-medium text-brand-700">
      <AppIcon name="report" size={16} />原本を見る
    </span>
  )}
</Tag>
