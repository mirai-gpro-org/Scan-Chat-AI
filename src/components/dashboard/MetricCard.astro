---
import type { MetricCard as MetricCardType } from '../../lib/elith-parser';
import { riskColor } from '../../lib/elith-parser';

interface Props {
  metric: MetricCardType;
  /** 原本 PDF への deep link (artifact ID + ?u= + page) — 任意 */
  href?: string | null;
}
const { metric, href = null } = Astro.props as Props;
const color = riskColor(metric.level);
const levelText: Record<MetricCardType['level'], string> = {
  high: '要警戒',
  slightly_high: '要注意',
  normal: '正常',
  slightly_low: 'やや低い',
  low: '低い',
};
const baseClass = `flex flex-col gap-1 rounded-2xl border-2 ${color.bg} ${color.border} p-3 shadow-sm transition hover:shadow-md`;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href ?? undefined}
  class={`${baseClass} ${href ? 'cursor-pointer hover:-translate-y-0.5' : ''}`}
  title={href ? '原本の検査結果を見る' : undefined}
>
  <div class="flex items-center justify-between">
    <span class="text-xs font-medium text-slate-600 dark:text-slate-300">{metric.label}</span>
    <span class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-medium ${color.chip}`}>
      <span class={`h-1.5 w-1.5 rounded-full ${color.dot}`}></span>
      {levelText[metric.level]}
    </span>
  </div>
  <div class="flex items-baseline gap-1">
    <span class={`text-2xl font-bold tabular-nums ${color.text}`}>{metric.value}</span>
    <span class="text-xs text-slate-500 dark:text-slate-400">{metric.unit}</span>
  </div>
  {metric.reference && (
    <span class="text-[10px] text-slate-500 dark:text-slate-400">基準: {metric.reference}</span>
  )}
  {metric.comment && (
    <p class="mt-1 text-[11px] leading-snug text-slate-600 dark:text-slate-300">{metric.comment}</p>
  )}
  {href && (
    <span class="mt-1 text-[10px] text-brand-600 dark:text-brand-300">📄 原本を見る ›</span>
  )}
</Tag>
