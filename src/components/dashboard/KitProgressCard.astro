---
import type { KitShipment } from '../../types/supabase';
import { shipmentLabel, testTypeLabel, formatJpDate } from '../../lib/dashboard-queries';

interface Props {
  shipments: (KitShipment & { lab_name: string | null })[];
  nextTestAt?: string | null;
  planName?: string | null;
}
const { shipments, nextTestAt, planName } = Astro.props as Props;
const active = shipments.filter((s) => !s.lab_completed_at).slice(0, 2);
const STEPS = ['出荷準備', '発送済', 'お受取', '返送', '検査会社受領', '検査完了'];
---

<section class="card">
  <header class="mb-3 flex items-center justify-between">
    <h2 class="flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
      <span>📦</span><span>検査キット進捗</span>
    </h2>
    {planName && (
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
        {planName}
      </span>
    )}
  </header>

  {active.length === 0 ? (
    <div class="rounded-xl border border-dashed border-slate-300 p-4 text-center text-xs text-slate-500 dark:border-slate-700">
      進行中のキットはありません
      {nextTestAt && (
        <p class="mt-2 text-[11px]">
          次回検査: <span class="font-medium text-slate-700 dark:text-slate-200">{formatJpDate(nextTestAt)}</span>
        </p>
      )}
    </div>
  ) : (
    <div class="space-y-3">
      {active.map((s) => {
        const tt = testTypeLabel(s.test_type);
        const status = shipmentLabel(s);
        return (
          <article class="rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-900">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="text-lg">{tt.emoji}</span>
                <div>
                  <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">{tt.name}</h3>
                  <p class="text-[10px] text-slate-500">{s.lab_name ?? '検査会社未定'}</p>
                </div>
              </div>
              <span class={`text-xs font-medium ${status.color}`}>{status.label}</span>
            </div>

            {/* 6 ステップステッパー */}
            <div class="mt-3 grid grid-cols-6 gap-1">
              {STEPS.map((_, i) => (
                <div
                  class={`h-1 rounded-full transition ${
                    i < status.step ? 'bg-brand-500' : i === status.step - 1 ? 'bg-gradient-to-r from-brand-500 to-cyan-400' : 'bg-slate-200 dark:bg-slate-700'
                  }`}
                ></div>
              ))}
            </div>

            <div class="mt-2 flex items-center justify-between text-[10px] text-slate-500">
              <span>{formatJpDate(s.shipped_at)} 発送</span>
              {s.tracking_no && (
                s.carrier_tracking_url ? (
                  <a href={s.carrier_tracking_url} target="_blank" rel="noopener" class="font-medium text-brand-600 hover:underline">
                    📍 追跡 {s.tracking_no}
                  </a>
                ) : (
                  <span>📍 {s.tracking_no}</span>
                )
              )}
            </div>

            {/* 自己申告ボタン */}
            {!s.user_received_at && s.shipped_at && (
              <button
                type="button"
                class="mt-3 w-full rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-xs font-medium text-amber-800 transition hover:bg-amber-100 dark:border-amber-700 dark:bg-amber-900/30 dark:text-amber-200"
              >
                📦 受け取りました
              </button>
            )}
            {s.user_received_at && !s.user_returned_at && (
              <button
                type="button"
                class="mt-3 w-full rounded-lg border border-blue-300 bg-blue-50 px-3 py-2 text-xs font-medium text-blue-800 transition hover:bg-blue-100 dark:border-blue-700 dark:bg-blue-900/30 dark:text-blue-200"
              >
                💉 返送しました
              </button>
            )}
          </article>
        );
      })}
    </div>
  )}

  {nextTestAt && active.length > 0 && (
    <p class="mt-3 text-[11px] text-slate-500">
      次回検査予定: <span class="font-medium text-slate-700 dark:text-slate-200">{formatJpDate(nextTestAt)}</span>
    </p>
  )}
</section>
