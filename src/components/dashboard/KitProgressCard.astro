---
import AppIcon from '../../components/AppIcon.astro';
import type { KitShipment } from '../../types/supabase';
import { shipmentLabel, testTypeLabel, formatJpDate } from '../../lib/dashboard-queries';

interface Props {
  shipments: (KitShipment & { lab_name: string | null })[];
  nextTestAt?: string | null;
  planName?: string | null;
  diagnosticUserId: string;
}
const { shipments, nextTestAt, planName, diagnosticUserId } = Astro.props as Props;
const active = shipments.filter((s) => !s.lab_completed_at).slice(0, 2);
const STEPS = ['出荷準備', '発送済', 'お受取', '返送', '検査会社受領', '検査完了'];
---

<section class="card">
  <header class="mb-3 flex items-center justify-between">
    <h2 class="flex items-center gap-2 text-sm font-bold text-slate-800">
      <span><AppIcon name="kit" size={20} /></span><span>検査キット進捗</span>
    </h2>
    {planName && (
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-600">
        {planName}
      </span>
    )}
  </header>

  {active.length === 0 ? (
    <div class="rounded-xl border border-dashed border-slate-300 p-4 text-center text-xs text-slate-500">
      進行中のキットはありません
      {nextTestAt && (
        <p class="mt-2 text-[11px]">
          次回検査: <span class="font-medium text-slate-700">{formatJpDate(nextTestAt)}</span>
        </p>
      )}
    </div>
  ) : (
    <div class="space-y-3">
      {active.map((s) => {
        const tt = testTypeLabel(s.test_type);
        const status = shipmentLabel(s);
        return (
          <article class="rounded-xl border border-slate-200 bg-white p-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <AppIcon name={tt.icon} size={24} class="text-slate-600" />
                <div>
                  <h3 class="text-sm font-semibold text-slate-800">{tt.name}</h3>
                  <p class="text-[10px] text-slate-500">{s.lab_name ?? '検査会社未定'}</p>
                </div>
              </div>
              <span class={`text-xs font-medium ${status.color}`}>{status.label}</span>
            </div>

            {/* 6 ステップステッパー */}
            <div class="mt-3 grid grid-cols-6 gap-1">
              {STEPS.map((_, i) => (
                <div
                  class={`h-1 rounded-full transition ${
                    i < status.step ? 'bg-brand-500' : i === status.step - 1 ? 'bg-brand-600' : 'bg-slate-200'
                  }`}
                ></div>
              ))}
            </div>

            <div class="mt-2 flex items-center justify-between text-[10px] text-slate-500">
              <span>{formatJpDate(s.shipped_at)} 発送</span>
              {s.tracking_no && (
                s.carrier_tracking_url ? (
                  <a href={s.carrier_tracking_url} target="_blank" rel="noopener" class="font-medium text-brand-600 hover:underline">
                    <AppIcon name="location" size={20} /> 追跡 {s.tracking_no}
                  </a>
                ) : (
                  <span><AppIcon name="location" size={20} /> {s.tracking_no}</span>
                )
              )}
            </div>

            {/* 自己申告ボタン */}
            {!s.user_received_at && s.shipped_at && (
              <button
                type="button"
                data-self-report
                data-shipment-id={s.id}
                data-action="received"
                class="mt-3 w-full rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-xs font-medium text-amber-800 transition hover:bg-amber-100 disabled:cursor-wait disabled:opacity-60"
              >
                <AppIcon name="kit" size={20} /> 受け取りました
              </button>
            )}
            {s.user_received_at && !s.user_returned_at && (
              <button
                type="button"
                data-self-report
                data-shipment-id={s.id}
                data-action="returned"
                class="mt-3 w-full rounded-lg border border-blue-300 bg-blue-50 px-3 py-2 text-xs font-medium text-blue-800 transition hover:bg-blue-100 disabled:cursor-wait disabled:opacity-60"
              >
                <AppIcon name="syringe" size={20} /> 返送しました
              </button>
            )}
          </article>
        );
      })}
    </div>
  )}

  {nextTestAt && active.length > 0 && (
    <p class="mt-3 text-[11px] text-slate-500">
      次回検査予定: <span class="font-medium text-slate-700">{formatJpDate(nextTestAt)}</span>
    </p>
  )}
</section>

<script is:inline define:vars={{ diagnosticUserId }}>
  document.addEventListener('click', async (e) => {
    const btn = e.target?.closest?.('button[data-self-report]');
    if (!btn) return;
    const shipmentId = btn.dataset.shipmentId;
    const action = btn.dataset.action;
    if (!shipmentId || !action) return;

    const verb = action === 'received' ? 'お受取' : '返送';
    if (!confirm(`本当に「${verb}」を申告しますか？`)) return;

    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = '送信中…';

    try {
      const res = await fetch(`/api/kit/${shipmentId}/self-report`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, diagnosticUserId }),
      });
      const payload = await res.json().catch(() => ({}));
      if (!res.ok || !payload.ok) {
        throw new Error(payload.error || `HTTP ${res.status}`);
      }
      // 成功 → ページ再読込で UI 更新
      window.location.reload();
    } catch (err) {
      alert(`申告に失敗しました: ${err instanceof Error ? err.message : String(err)}`);
      btn.disabled = false;
      btn.textContent = originalText;
    }
  });
</script>
