---
import AppIcon from '../../components/AppIcon.astro';
import type { SituationalCard } from '../../lib/elith-parser';

interface Props {
  cards: SituationalCard[];
}
const { cards } = Astro.props as Props;
---

<section>
  <header class="mb-2 flex items-center justify-between">
    <h2 class="text-sm font-bold text-slate-800">
      <AppIcon name="meal" size={20} /> シチュエーション別アドバイス
    </h2>
    <span class="text-xs text-slate-500">← スワイプ →</span>
  </header>
  <div class="-mx-5 overflow-x-auto px-5 pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <div class="flex snap-x snap-mandatory gap-3" style="width: max-content;">
      {cards.length === 0 ? (
        <div class="snap-start rounded-2xl border border-slate-200 bg-white p-4 text-center text-xs text-slate-500" style="width: 250px;">
          現在カードはありません
        </div>
      ) : (
        cards.map((c) => (
          <article class="snap-start rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition-colors" style="width: 250px;">
            <div class="flex items-center gap-2">
              <span class="grid h-8 w-8 place-items-center rounded-lg bg-mist text-brand-700">
                <AppIcon name={c.icon} size={20} />
              </span>
              <span class="text-xs font-medium uppercase tracking-wider text-slate-500">{c.scene}</span>
            </div>
            <h3 class="mt-2 text-sm font-bold text-slate-800">{c.title}</h3>
            <p class="mt-1 line-clamp-3 text-xs leading-relaxed text-slate-600">{c.body}</p>
            <a href="#" class="mt-2 inline-flex text-xs font-medium text-brand-600 hover:underline">
              詳しく見る →
            </a>
          </article>
        ))
      )}
    </div>
  </div>
</section>
