---
import AppIcon from '../../components/AppIcon.astro';
import ServiceActionRow from './ServiceActionRow.astro';

/**
 * AI ヘルスコーチ の枠。
 *
 * 【ローンチ時は未提供 (発注者指定 2026-08)】「準備中」として押せない状態で見せる。
 *   提供開始時は下の `READY` を true にするだけでリンクに戻る。
 *
 * オンライン相談は**別枠** (OnlineConsultCard.astro)。性質が違う (AI とスタッフ) ので
 * 1 つの枠に混ぜない。
 */
interface Props {
  greeting: string;
  /** Elith summary 1 行目 */
  summaryHint?: string | null;
  /** ?u= 伝搬用 */
  diagnosticUserId?: string;
}
const { greeting, summaryHint, diagnosticUserId } = Astro.props as Props;

const READY = false;

const opener = summaryHint
  ? `${greeting}、${summaryHint.slice(0, 60)}...`
  : `${greeting}、検査結果や生活習慣について何でも聞いてください。`;
const href = diagnosticUserId ? `/coach?u=${encodeURIComponent(diagnosticUserId)}` : '/coach';
---

<section class="rounded-2xl bg-mist p-4" aria-labelledby="coach-title">
  <div class="flex items-start gap-3">
    <div class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand-600 text-white">
      <AppIcon name="coach" size={22} />
    </div>
    <div class="flex-1">
      <h3 id="coach-title" class="text-base font-bold text-navy-800">AI ヘルスコーチ</h3>
      <p class="mt-1 text-sm text-slate-700">{opener}</p>
    </div>
  </div>

  <div class="mt-3">
    <ServiceActionRow label="コーチに相談する" icon="interview" href={href} ready={READY} />
  </div>
</section>
