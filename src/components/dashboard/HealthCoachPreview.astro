---
import AppIcon from '../../components/AppIcon.astro';

/**
 * AI ヘルスコーチ セクション。
 *
 * 【ローンチ時は両機能とも未提供 (発注者指定 2026-08)】
 *   - コーチに相談する
 *   - オンライン相談を予約
 *   どちらも「準備中」として**押せない状態**で見せる。押せそうに見えて何も起きない
 *   のが一番よくないので、リンクではなく disabled なボタンにして状態を明示する。
 *   状態表示は デザイン規則どおり アイコン + テキスト + 色 の 3 点セット (status.unknown)。
 *
 * 提供開始時は `READY` を true にするか、各項目の `ready` を立てて `<a>` に戻す。
 */
interface Props {
  greeting: string;
  /** Elith summary 1 行目 */
  summaryHint?: string | null;
  /** ?u= 伝搬用 */
  diagnosticUserId?: string;
}
const { greeting, summaryHint, diagnosticUserId } = Astro.props as Props;

const opener = summaryHint
  ? `${greeting}、${summaryHint.slice(0, 60)}...`
  : `${greeting}、検査結果や生活習慣について何でも聞いてください。`;

const q = diagnosticUserId ? `?u=${encodeURIComponent(diagnosticUserId)}` : '';

const ACTIONS = [
  { key: 'chat',    label: 'コーチに相談する',    icon: 'interview' as const, href: `/coach${q}`, ready: false },
  { key: 'booking', label: 'オンライン相談を予約', icon: 'calendar'  as const, href: null,        ready: false },
];
---

<section class="rounded-2xl bg-mist p-4">
  <div class="flex items-start gap-3">
    <div class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand-600 text-white">
      <AppIcon name="coach" size={22} />
    </div>
    <div class="flex-1">
      <h3 class="text-base font-bold text-navy-800">AI ヘルスコーチ</h3>
      <p class="mt-1 text-sm text-slate-700">{opener}</p>
    </div>
  </div>

  <ul class="mt-3 flex flex-col gap-2">
    {ACTIONS.map((a) => (
      <li>
        {a.ready && a.href ? (
          <a
            href={a.href}
            class="flex min-h-touch w-full items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-3 py-2 text-base text-slate-800 transition hover:border-brand-400"
          >
            <span class="flex items-center gap-2">
              <AppIcon name={a.icon} size={20} class="text-brand-700" />
              {a.label}
            </span>
            <AppIcon name="next" size={18} class="text-brand-700" />
          </a>
        ) : (
          <button
            type="button"
            disabled
            aria-disabled="true"
            class="flex min-h-touch w-full cursor-not-allowed items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-3 py-2 text-base text-slate-600"
          >
            <span class="flex items-center gap-2">
              <AppIcon name={a.icon} size={20} class="text-slate-500" />
              {a.label}
            </span>
            <span class="status-pill status-unknown shrink-0">
              <AppIcon name="clock" size={14} />準備中
            </span>
          </button>
        )}
      </li>
    ))}
  </ul>
</section>
