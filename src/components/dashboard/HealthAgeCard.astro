---
/**
 * 健康年齢 (生物学的年齢 / CABA v4d) カード。
 * 生物学的年齢を大きく表示し、実年齢との差をバッジで示す。
 * 血液回で一部項目を据え置いた場合・必須項目が欠けた場合は注記を出す。
 */
import type { HealthAgeLatest } from '../../lib/dashboard-queries';

interface Props {
  latest: HealthAgeLatest;
}
const { latest } = Astro.props;

const bio = latest.biologicalAge;
const delta = latest.delta;
const sourceLabel = latest.sourceKind === 'blood' ? '血液検査' : '人間ドック';

// 差分バッジ (実年齢比)
let badgeText = '実年齢と同等';
let badgeClass = 'bg-sky-100 text-sky-700 dark:bg-sky-900/40 dark:text-sky-300';
let bioColor = 'text-sky-600 dark:text-sky-400';
if (delta != null) {
  if (delta > 2) {
    badgeText = `実年齢より ${delta.toFixed(1)} 歳 老化`;
    badgeClass = 'bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300';
    bioColor = 'text-rose-600 dark:text-rose-400';
  } else if (delta < -2) {
    badgeText = `実年齢より ${Math.abs(delta).toFixed(1)} 歳 若い`;
    badgeClass = 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300';
    bioColor = 'text-emerald-600 dark:text-emerald-400';
  }
}

const carried = latest.carried ?? [];
const missing = latest.missing ?? [];
---

<section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
  <header class="mb-2 flex items-center justify-between">
    <h2 class="text-sm font-bold text-slate-800 dark:text-slate-100">🎂 健康年齢</h2>
    <span class="text-[10px] text-slate-500">CABA v4d ／ {sourceLabel}</span>
  </header>

  {bio != null ? (
    <div class="flex items-end justify-between gap-3">
      <div>
        <div class={`text-5xl font-semibold leading-none ${bioColor}`}>{bio.toFixed(1)}<span class="ml-1 text-base font-medium text-slate-500">歳</span></div>
        <div class="mt-1 text-xs text-slate-500">生物学的年齢 ／ 実年齢 {latest.chronologicalAge} 歳</div>
      </div>
      <span class={`shrink-0 rounded-full px-3 py-1 text-xs font-medium ${badgeClass}`}>{badgeText}</span>
    </div>
  ) : (
    <div class="text-sm text-slate-500">
      必須項目が不足しているため算出できませんでした。
      {missing.length > 0 && <span class="text-slate-400">（不足: {missing.join(', ')}）</span>}
    </div>
  )}

  {(carried.length > 0 || (bio != null && missing.length > 0)) && (
    <p class="mt-3 border-t border-slate-100 pt-2 text-[11px] leading-relaxed text-slate-400 dark:border-slate-800">
      {carried.length > 0 && <span>※ 一部の項目 ({carried.join(', ')}) は直近の人間ドック値を据え置いて再計算しています。</span>}
      {bio != null && missing.length > 0 && <span>※ 一部の項目が欠落しているため参考値です。</span>}
    </p>
  )}
</section>
