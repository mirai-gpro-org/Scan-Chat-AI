---
import AppIcon from '../../components/AppIcon.astro';
import type { TestArtifact } from '../../types/supabase';
import { testTypeLabel, formatJpDate } from '../../lib/dashboard-queries';

interface Props {
  artifacts: TestArtifact[];
  diagnosticUserId?: string;
}
const { artifacts, diagnosticUserId } = Astro.props as Props;
const uidQs = diagnosticUserId ? `?u=${encodeURIComponent(diagnosticUserId)}` : '';
---

<section class="card">
  <header class="mb-3 flex items-center justify-between">
    <h2 class="flex items-center gap-2 text-sm font-bold text-slate-800">
      <span><AppIcon name="trend" size={20} /></span><span>検査履歴</span>
    </h2>
    <span class="text-xs text-slate-500">{artifacts.length} 件</span>
  </header>

  {artifacts.length === 0 ? (
    <p class="rounded-xl bg-slate-50 px-3 py-6 text-center text-xs text-slate-500">
      過去の検査履歴はありません
    </p>
  ) : (
    <ul class="space-y-2">
      {artifacts.slice(0, 6).map((a) => {
        const tt = testTypeLabel(a.test_type);
        const isThreeMode = a.display_mode === 'three_mode';
        return (
          <li>
            <a
              href={`/result/${a.id}${uidQs}`}
              class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-3 transition-colors hover:border-brand-300"
            >
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-mist text-base">
                <AppIcon name={tt.icon} size={20} class="text-brand-700" />
              </span>
              <div class="flex-1">
                <div class="flex items-baseline justify-between gap-2">
                  <h3 class="text-sm font-medium text-slate-800">{tt.name}</h3>
                  <time class="text-xs text-slate-500">{formatJpDate(a.test_date)}</time>
                </div>
                <div class="mt-0.5 flex items-center gap-2 text-xs text-slate-500">
                  <span>{a.lab_name ?? a.source}</span>
                  {a.page_count && a.page_count > 1 && <span>· {a.page_count}pg</span>}
                  {isThreeMode && (
                    <span class="rounded-full bg-cyan-100 px-1.5 py-0.5 font-medium text-cyan-700">
                      3 モード
                    </span>
                  )}
                  {a.source === 'user_upload' && (
                    <span class="rounded-full bg-slate-100 px-1.5 py-0.5 text-slate-600">
                      自分でUP
                    </span>
                  )}
                </div>
              </div>
              <span class="text-slate-400">›</span>
            </a>
          </li>
        );
      })}
    </ul>
  )}
</section>
