---
import AppIcon from '../AppIcon.astro';
import { formatJpDate } from '../../lib/dashboard-queries';

/**
 * AI疾病予防レポート (Elith 診断結果) への導線タイル。
 *
 * 【優先度】Welltect の売りの一つなので、他の検査セクションより優先して見せる
 *   (発注者指示 2026-08)。大きさは検査カードと同寸のまま、**面を brand 塗り**にして
 *   優先度を出す。画面で brand 塗りはこの 1 枚だけ — 塗りが複数あると主役が消えて
 *   このタイルが検査カードに埋もれるため、AI スキャン等は淡色ペアに落としてある。
 *
 * 【コントラスト実測】白文字 on brand-600 = 4.70:1 (AA 4.5 ✓) /
 *   白ボタンの brand-700 文字 = 7.09:1。文字を薄くしない (opacity を掛けない)。
 *
 * ページ数などレポート固有のメタは、型に無い列を推測で出さない (ミッション④)。
 * 出すのは受領日だけ。
 */
interface Props {
  href: string;
  /** Elith から受領した日 (diagnosis_results.received_at)。無ければ日付行を出さない。 */
  receivedAt?: string | null;
}
const { href, receivedAt = null } = Astro.props as Props;
---

<section class="flex flex-col gap-3 rounded-2xl border border-brand-600 bg-brand-600 p-4 text-white sm:p-5">
  <div class="flex items-center gap-3">
    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white/20">
      <AppIcon name="report" size={20} />
    </span>
    <span class="flex min-w-0 flex-col">
      <span class="text-base font-bold">AI疾病予防レポート</span>
      {receivedAt && <span class="tnum whitespace-nowrap text-sm">{formatJpDate(receivedAt)}</span>}
    </span>
  </div>

  <a
    href={href}
    class="flex min-h-touch items-center justify-center gap-1.5 rounded-xl bg-white px-3 text-base font-semibold text-brand-700 transition hover:bg-brand-50"
  >
    レポートを読む<AppIcon name="next" size={18} />
  </a>

  <span class="text-sm">
    <span class="whitespace-nowrap">サマリー</span> ／
    <span class="whitespace-nowrap">要注意の抜粋</span> ／
    <span class="whitespace-nowrap">全編PDF</span>
  </span>
</section>
