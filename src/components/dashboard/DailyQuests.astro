---
import type { DailyQuest } from '../../lib/elith-parser';

interface Props {
  quests: DailyQuest[];
}
const { quests } = Astro.props as Props;
---

<section class="card border-brand-200 dark:border-brand-500/30" style="background: linear-gradient(180deg, rgba(99,102,241,0.04) 0%, rgba(255,255,255,0) 60%);">
  <header class="mb-3 flex items-center justify-between">
    <h2 class="flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
      <span class="text-base">💡</span>
      <span>本日の健康クエスト</span>
    </h2>
    <span class="text-[10px] text-slate-500">{quests.length} 件</span>
  </header>

  <ul class="space-y-2">
    {quests.length === 0 ? (
      <li class="rounded-xl bg-slate-50 px-3 py-3 text-center text-xs text-slate-500 dark:bg-slate-800/40">
        本日のクエストはありません
      </li>
    ) : (
      quests.map((q, i) => (
        <li class="rounded-xl border border-slate-200 bg-white p-3 transition hover:border-brand-300 hover:shadow-sm dark:border-slate-700 dark:bg-slate-900">
          <div class="flex items-start gap-2">
            <input
              type="checkbox"
              id={`quest-${i}`}
              class="mt-0.5 h-4 w-4 rounded border-slate-400 text-brand-600 focus:ring-brand-500"
            />
            <label for={`quest-${i}`} class="flex-1 cursor-pointer">
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-sm font-medium text-slate-800 dark:text-slate-100">{q.text}</span>
                {q.display && (
                  <span class="text-[11px] tabular-nums text-slate-500">{q.display}</span>
                )}
              </div>
              {typeof q.progress === 'number' && q.progress > 0 && (
                <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-brand-500 to-cyan-400 transition-[width] duration-500"
                    style={`width: ${Math.min(100, Math.max(0, q.progress * 100))}%`}
                  ></div>
                </div>
              )}
            </label>
          </div>
        </li>
      ))
    )}
  </ul>
</section>
