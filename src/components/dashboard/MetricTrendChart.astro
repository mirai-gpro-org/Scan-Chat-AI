---
/**
 * 主要 3 指標 (尿酸 / 最高血圧 / 空腹時血糖) の数値変動グラフ。
 * 各指標を 1 つのミニ折れ線 SVG として横並びに表示。
 * 基準値上限を赤点線で重ねる。
 */
import type { MetricTrendSeries } from '../../lib/dashboard-queries';

interface Props {
  series: MetricTrendSeries[];
}
const { series } = Astro.props as Props;

const W = 280;
const H = 100;
const PAD_L = 30;
const PAD_R = 8;
const PAD_T = 12;
const PAD_B = 22;

function buildPath(points: { x: number; y: number }[]): string {
  if (points.length === 0) return '';
  return points.map((p, i) => (i === 0 ? `M ${p.x} ${p.y}` : `L ${p.x} ${p.y}`)).join(' ');
}

function formatShortDate(iso: string): string {
  const d = new Date(iso);
  return `${d.getMonth() + 1}/${d.getDate()}`;
}

interface Computed {
  s: MetricTrendSeries;
  minY: number;
  maxY: number;
  pts: { x: number; y: number; v: number; raw: string; date: string }[];
  refY: number | null;
  trendColor: string;
  diff: number;
}

const computed: Computed[] = series.map((s) => {
  const values = s.points.map((p) => p.value);
  let minY = Math.min(...values);
  let maxY = Math.max(...values);
  if (s.referenceUpper) {
    minY = Math.min(minY, s.referenceUpper);
    maxY = Math.max(maxY, s.referenceUpper);
  }
  // padding 5%
  const span = Math.max(maxY - minY, 1);
  minY -= span * 0.1;
  maxY += span * 0.1;

  const innerW = W - PAD_L - PAD_R;
  const innerH = H - PAD_T - PAD_B;
  const xStep = s.points.length > 1 ? innerW / (s.points.length - 1) : 0;

  const pts = s.points.map((p, i) => ({
    x: PAD_L + xStep * i,
    y: PAD_T + innerH * (1 - (p.value - minY) / (maxY - minY)),
    v: p.value,
    raw: p.raw,
    date: p.date,
  }));

  const refY = s.referenceUpper
    ? PAD_T + innerH * (1 - (s.referenceUpper - minY) / (maxY - minY))
    : null;

  const first = s.points[0]?.value ?? 0;
  const last  = s.points[s.points.length - 1]?.value ?? 0;
  const diff = last - first;
  const overRef = s.referenceUpper ? last > s.referenceUpper : false;
  // 上昇かつ基準超え → 赤、上昇 → オレンジ、下降 → 緑、変化なし → グレー
  const trendColor =
    diff > 0 && overRef ? '#dc2626' :
    diff > 0            ? '#f59e0b' :
    diff < 0            ? '#10b981' :
                          '#64748b';

  return { s, minY, maxY, pts, refY, trendColor, diff };
});
---

{series.length === 0 ? null : (
  <section class="card">
    <header class="mb-3 flex items-center justify-between">
      <h2 class="flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
        <span>📈</span><span>数値変動</span>
      </h2>
      <span class="text-[10px] text-slate-500">{series[0]?.points.length} 回分</span>
    </header>

    <div class="flex flex-col gap-4 sm:grid sm:grid-cols-3 sm:gap-3">
      {computed.map(({ s, pts, refY, trendColor, diff }) => {
        const last = s.points[s.points.length - 1];
        const arrow = diff > 0 ? '↗' : diff < 0 ? '↘' : '→';
        return (
          <article class="rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-900">
            <div class="mb-1 flex items-baseline justify-between gap-2">
              <h3 class="text-xs font-semibold text-slate-700 dark:text-slate-200">{s.label}</h3>
              <span class="text-[10px] text-slate-500">単位 {s.unit}</span>
            </div>
            <div class="mb-1 flex items-baseline gap-2">
              <span class="text-xl font-bold tabular-nums" style={`color: ${trendColor}`}>{last.raw}</span>
              <span class="text-xs font-medium" style={`color: ${trendColor}`}>
                {arrow} {diff > 0 ? '+' : ''}{diff.toFixed(diff % 1 === 0 ? 0 : 1)}
              </span>
            </div>
            <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto" role="img" aria-label={`${s.label}の推移`}>
              {/* 基準値ライン */}
              {refY !== null && (
                <>
                  <line x1={PAD_L} y1={refY} x2={W - PAD_R} y2={refY}
                    stroke="#ef4444" stroke-width="1" stroke-dasharray="3 3" opacity="0.5" />
                  <text x={W - PAD_R} y={refY - 2} text-anchor="end"
                    class="fill-red-500" style="font-size: 9px">
                    基準 {s.referenceUpper}
                  </text>
                </>
              )}
              {/* グリッド (X 軸) */}
              <line x1={PAD_L} y1={H - PAD_B} x2={W - PAD_R} y2={H - PAD_B}
                stroke="#cbd5e1" stroke-width="1" />
              {/* 折れ線 */}
              <path d={buildPath(pts)} fill="none" stroke={trendColor} stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
              {/* 点 */}
              {pts.map((p) => (
                <>
                  <circle cx={p.x} cy={p.y} r="3.5" fill="white" stroke={trendColor} stroke-width="2" />
                  <text x={p.x} y={H - PAD_B + 14} text-anchor="middle"
                    class="fill-slate-500" style="font-size: 9px">
                    {formatShortDate(p.date)}
                  </text>
                </>
              ))}
            </svg>
          </article>
        );
      })}
    </div>

    <p class="mt-3 text-[10px] text-slate-500">
      ※ 赤点線は基準値上限。緑↘=改善、橙↗=要観察、赤↗=基準超え
    </p>
  </section>
)}
