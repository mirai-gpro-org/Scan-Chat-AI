---
/**
 * 主要 3 指標 (尿酸 / 最高血圧 / 空腹時血糖) の数値変動グラフ。
 * 各指標を 1 つのミニ折れ線 SVG として横並びに表示。
 * 基準値上限を赤点線で重ねる。
 */
import type { MetricTrendSeries } from '../../lib/dashboard-queries';

interface Props {
  series: MetricTrendSeries[];
}
const { series } = Astro.props as Props;

const W = 280;
const H = 100;
const PAD_L = 30;
const PAD_R = 8;
const PAD_T = 12;
const PAD_B = 22;

function buildPath(points: { x: number; y: number }[]): string {
  if (points.length === 0) return '';
  return points.map((p, i) => (i === 0 ? `M ${p.x} ${p.y}` : `L ${p.x} ${p.y}`)).join(' ');
}

function formatJpDate(iso: string): string {
  const d = new Date(iso);
  const weekday = ['日', '月', '火', '水', '木', '金', '土'][d.getDay()];
  return `${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()} (${weekday})`;
}

function commentFor(label: string, first: number, last: number, ref: number | undefined, diff: number): string {
  const overRef = ref != null && last > ref;
  const dir = diff > 0 ? '上昇' : diff < 0 ? '低下' : '横ばい';
  if (overRef && diff > 0) {
    return `${label}は ${dir}傾向で基準値を超えています。生活習慣の見直しと、医師への相談を検討しましょう。`;
  }
  if (overRef) {
    return `${label}は基準値を超えていますが ${dir} 傾向です。引き続き経過観察を。`;
  }
  if (diff > 0) {
    return `${label}は ${dir} 傾向です。基準値内ではありますが、注意して見守りましょう。`;
  }
  if (diff < 0) {
    return `${label}は ${dir} 傾向で改善が見られます。この調子で継続を。`;
  }
  return `${label}は安定しています。現状を維持しましょう。`;
}

interface Computed {
  s: MetricTrendSeries;
  minY: number;
  maxY: number;
  pts: { x: number; y: number; v: number; raw: string; date: string }[];
  refY: number | null;
  trendColor: string;
  diff: number;
}

const computed: Computed[] = series.map((s) => {
  const values = s.points.map((p) => p.value);
  let minY = Math.min(...values);
  let maxY = Math.max(...values);
  if (s.referenceUpper) {
    minY = Math.min(minY, s.referenceUpper);
    maxY = Math.max(maxY, s.referenceUpper);
  }
  // padding 5%
  const span = Math.max(maxY - minY, 1);
  minY -= span * 0.1;
  maxY += span * 0.1;

  const innerW = W - PAD_L - PAD_R;
  const innerH = H - PAD_T - PAD_B;
  const xStep = s.points.length > 1 ? innerW / (s.points.length - 1) : 0;

  const pts = s.points.map((p, i) => ({
    x: PAD_L + xStep * i,
    y: PAD_T + innerH * (1 - (p.value - minY) / (maxY - minY)),
    v: p.value,
    raw: p.raw,
    date: p.date,
  }));

  const refY = s.referenceUpper
    ? PAD_T + innerH * (1 - (s.referenceUpper - minY) / (maxY - minY))
    : null;

  const first = s.points[0]?.value ?? 0;
  const last  = s.points[s.points.length - 1]?.value ?? 0;
  const diff = last - first;
  const overRef = s.referenceUpper ? last > s.referenceUpper : false;
  // 上昇かつ基準超え → 赤、上昇 → オレンジ、下降 → 緑、変化なし → グレー
  const trendColor =
    diff > 0 && overRef ? '#dc2626' :
    diff > 0            ? '#f59e0b' :
    diff < 0            ? '#10b981' :
                          '#64748b';

  return { s, minY, maxY, pts, refY, trendColor, diff };
});
---

{/* 大型グラフ用のパラメータ (モーダル内で使う) */}
{(() => null)()}
{series.length === 0 ? null : (
  <section class="card">
    <header class="mb-3 flex items-center justify-between">
      <h2 class="flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
        <span>📈</span><span>数値変動</span>
      </h2>
      <span class="text-[10px] text-slate-500">{series[0]?.points.length} 回分</span>
    </header>

    <div class="flex flex-col gap-4 sm:grid sm:grid-cols-3 sm:gap-3">
      {computed.map(({ s, pts, refY, trendColor, diff }, idx) => {
        const last = s.points[s.points.length - 1];
        const arrow = diff > 0 ? '↗' : diff < 0 ? '↘' : '→';
        return (
          <article
            data-trend-open={idx}
            role="button"
            tabindex="0"
            aria-label={`${s.label} の数値変動 詳細`}
            class="cursor-pointer rounded-xl border border-slate-200 bg-white p-3 transition-colors hover:border-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-900"
          >
            <div class="mb-1 flex items-baseline justify-between gap-2">
              <h3 class="text-xs font-semibold text-slate-700 dark:text-slate-200">{s.label}</h3>
              <span class="text-[10px] text-slate-500">単位 {s.unit}</span>
            </div>
            <div class="mb-1 flex items-baseline gap-2">
              <span class="text-xl font-bold tabular-nums" style={`color: ${trendColor}`}>{last.raw}</span>
              <span class="text-xs font-medium" style={`color: ${trendColor}`}>
                {arrow} {diff > 0 ? '+' : ''}{diff.toFixed(diff % 1 === 0 ? 0 : 1)}
              </span>
            </div>
            <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto" role="img" aria-label={`${s.label}の推移`}>
              {refY !== null && (
                <>
                  <line x1={PAD_L} y1={refY} x2={W - PAD_R} y2={refY}
                    stroke="#ef4444" stroke-width="1" stroke-dasharray="3 3" opacity="0.5" />
                  <text x={W - PAD_R} y={refY - 2} text-anchor="end"
                    class="fill-red-500" style="font-size: 9px">
                    基準 {s.referenceUpper}
                  </text>
                </>
              )}
              <line x1={PAD_L} y1={H - PAD_B} x2={W - PAD_R} y2={H - PAD_B}
                stroke="#cbd5e1" stroke-width="1" />
              <path d={buildPath(pts)} fill="none" stroke={trendColor} stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
              {pts.map((p) => (
                <>
                  <circle cx={p.x} cy={p.y} r="3.5" fill="white" stroke={trendColor} stroke-width="2" />
                  <text x={p.x} y={H - PAD_B + 14} text-anchor="middle"
                    class="fill-slate-500" style="font-size: 9px">
                    {`${new Date(p.date).getMonth() + 1}/${new Date(p.date).getDate()}`}
                  </text>
                </>
              ))}
            </svg>
            <div class="mt-2 inline-flex w-full items-center justify-center gap-1 rounded-lg bg-slate-50 px-2 py-1.5 text-[11px] font-medium text-brand-600 pointer-events-none dark:bg-slate-800 dark:text-brand-300">
              詳細を見る ›
            </div>
          </article>
        );
      })}
    </div>

    <p class="mt-3 text-[10px] text-slate-500">
      ※ 赤点線は基準値上限。緑↘=改善、橙↗=要観察、赤↗=基準超え
    </p>
  </section>
)}

{/* ━━━━ 詳細モーダル (各指標分を予め DOM 配置、hidden で隠す) ━━━━ */}
{computed.map(({ s, refY, trendColor, diff }, idx) => {
  const last = s.points[s.points.length - 1];
  const first = s.points[0];
  const arrow = diff > 0 ? '↗' : diff < 0 ? '↘' : '→';
  const comment = commentFor(s.label, first.value, last.value, s.referenceUpper, diff);

  // 大型 SVG (モーダル用):
  //   - viewBox は実画面解像度に近い 600x300 に揃え、subpixel 整列を確保
  //   - 1 viewBox unit ≈ 1 CSS px に対応するのでベクター→ラスタライズ時に
  //     hinting が崩れず、テキストの輪郭がシャープに出る
  const MW = 600;
  const MH = 300;
  const ML = 48, MR = 16, MT = 18, MB = 36;
  const innerW = MW - ML - MR;
  const innerH = MH - MT - MB;
  const values = s.points.map((p) => p.value);
  let mMin = Math.min(...values);
  let mMax = Math.max(...values);
  if (s.referenceUpper) {
    mMin = Math.min(mMin, s.referenceUpper);
    mMax = Math.max(mMax, s.referenceUpper);
  }
  const mSpan = Math.max(mMax - mMin, 1);
  mMin -= mSpan * 0.1;
  mMax += mSpan * 0.1;
  const xStep = s.points.length > 1 ? innerW / (s.points.length - 1) : 0;
  const mPts = s.points.map((p, i) => ({
    x: ML + xStep * i,
    y: MT + innerH * (1 - (p.value - mMin) / (mMax - mMin)),
    v: p.value, raw: p.raw, date: p.date,
  }));
  const mRefY = s.referenceUpper
    ? MT + innerH * (1 - (s.referenceUpper - mMin) / (mMax - mMin))
    : null;
  const mPath = mPts.length === 0 ? '' :
    mPts.map((p, i) => (i === 0 ? `M ${p.x} ${p.y}` : `L ${p.x} ${p.y}`)).join(' ');

  // Y 軸目盛 (4 段階)
  const yTicks = Array.from({ length: 4 }, (_, i) => ({
    val: mMin + (mMax - mMin) * (i / 3),
    ty: MT + innerH * (1 - i / 3),
  }));
  const fmtY = (n: number) => n.toFixed(s.unit === 'mmHg' ? 0 : 1);

  return (
    <div
      id={`trend-modal-${idx}`}
      data-trend-modal
      hidden
      class="fixed inset-0 z-50 flex items-end sm:items-center justify-center"
      role="dialog"
      aria-modal="true"
      aria-labelledby={`trend-modal-title-${idx}`}
    >
      <div data-trend-close class="fixed inset-0 z-40"></div>
      <div
        class="relative z-10 mx-auto w-full max-w-3xl rounded-t-3xl sm:rounded-2xl border border-slate-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-800 max-h-[92vh] overflow-y-auto"
      >
        <header class="sticky top-0 z-10 flex items-center justify-between gap-3 border-b border-slate-200 bg-white px-5 py-3 dark:border-slate-700 dark:bg-slate-800">
          <div class="flex items-baseline gap-2">
            <h2 id={`trend-modal-title-${idx}`} class="text-base font-bold text-slate-800 dark:text-slate-100">
              📈 {s.label} の数値変動
            </h2>
            <span class="text-[11px] text-slate-500">単位 {s.unit}</span>
          </div>
          <button
            type="button"
            data-trend-close
            aria-label="閉じる"
            class="grid h-8 w-8 place-items-center rounded-full text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800"
          >✕</button>
        </header>

        <div class="space-y-4 px-5 py-4">
          {/* 最新値 + トレンド */}
          <div class="flex items-baseline gap-3">
            <span class="text-3xl font-bold tabular-nums" style={`color: ${trendColor}`}>{last.raw}</span>
            <span class="text-base font-medium" style={`color: ${trendColor}`}>
              {arrow} {diff > 0 ? '+' : ''}{diff.toFixed(diff % 1 === 0 ? 0 : 1)} {s.unit}
            </span>
            <span class="text-xs text-slate-500">最新 / 初回比</span>
          </div>

          {/* 大型グラフ */}
          <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
            <svg
              viewBox={`0 0 ${MW} ${MH}`}
              preserveAspectRatio="xMidYMid meet"
              class="w-full"
              style="height: clamp(260px, 55vh, 520px); text-rendering: geometricPrecision; shape-rendering: geometricPrecision; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Hiragino Sans', 'Noto Sans JP', sans-serif;"
              role="img"
              aria-label={`${s.label}の推移 (拡大)`}
            >
              {/* Y 軸グリッド */}
              {yTicks.map((t) => (
                <>
                  <line x1={ML} y1={t.ty} x2={MW - MR} y2={t.ty}
                    stroke="#e2e8f0" stroke-width="1" opacity="0.8" />
                  <text x={ML - 6} y={t.ty + 4} text-anchor="end"
                    fill="#64748b" style="font-size: 11px;">
                    {fmtY(t.val)}
                  </text>
                </>
              ))}
              {/* 基準値ライン */}
              {mRefY !== null && (
                <>
                  <line x1={ML} y1={mRefY} x2={MW - MR} y2={mRefY}
                    stroke="#ef4444" stroke-width="1.5" stroke-dasharray="6 4" opacity="0.8" />
                  <text x={MW - MR} y={mRefY - 4} text-anchor="end"
                    fill="#dc2626" style="font-size: 11px; font-weight: 600;">
                    基準上限 {s.referenceUpper}
                  </text>
                </>
              )}
              {/* X 軸 */}
              <line x1={ML} y1={MH - MB} x2={MW - MR} y2={MH - MB}
                stroke="#94a3b8" stroke-width="1.5" />
              {/* 折れ線 */}
              <path d={mPath} fill="none" stroke={trendColor} stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
              {/* 点 + 値ラベル + 日付 */}
              {mPts.map((p) => (
                <>
                  <circle cx={p.x} cy={p.y} r="5" fill="white" stroke={trendColor} stroke-width="2.5" />
                  <text x={p.x} y={p.y - 11} text-anchor="middle"
                    fill="#1e293b" style="font-size: 13px; font-weight: 700;">
                    {p.raw}
                  </text>
                  <text x={p.x} y={MH - MB + 14} text-anchor="middle"
                    fill="#64748b" style="font-size: 10px;">
                    {`${new Date(p.date).getFullYear()}/${new Date(p.date).getMonth() + 1}/${new Date(p.date).getDate()}`}
                  </text>
                </>
              ))}
            </svg>
          </div>

          {/* コメント */}
          <div class="rounded-xl border border-amber-200 bg-amber-50/80 px-4 py-3 dark:border-amber-700/50 dark:bg-amber-900/20">
            <h3 class="mb-1 text-xs font-bold text-amber-900 dark:text-amber-200">💬 アドバイス</h3>
            <p class="text-[13px] leading-relaxed text-amber-900 dark:text-amber-100">{comment}</p>
          </div>

          {/* 詳細データ表 */}
          <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
            <table class="w-full table-auto text-sm">
              <thead class="bg-slate-50 dark:bg-slate-800">
                <tr>
                  <th class="px-3 py-2 text-left font-medium text-slate-600 dark:text-slate-300">検査日</th>
                  <th class="px-3 py-2 text-right font-medium text-slate-600 dark:text-slate-300">値 ({s.unit})</th>
                  <th class="px-3 py-2 text-right font-medium text-slate-600 dark:text-slate-300">前回比</th>
                  <th class="px-3 py-2 text-right font-medium text-slate-600 dark:text-slate-300">基準</th>
                </tr>
              </thead>
              <tbody>
                {s.points.map((p, i) => {
                  const prev = i > 0 ? s.points[i - 1] : null;
                  const delta = prev ? p.value - prev.value : 0;
                  const over = s.referenceUpper != null && p.value > s.referenceUpper;
                  return (
                    <tr class="border-t border-slate-100 dark:border-slate-800">
                      <td class="px-3 py-2 text-slate-700 dark:text-slate-200">{formatJpDate(p.date)}</td>
                      <td class={`px-3 py-2 text-right tabular-nums ${over ? 'text-red-600 font-semibold' : 'text-slate-700 dark:text-slate-200'}`}>
                        {p.raw}
                      </td>
                      <td class={`px-3 py-2 text-right text-[12px] tabular-nums ${delta > 0 ? 'text-amber-600' : delta < 0 ? 'text-emerald-600' : 'text-slate-400'}`}>
                        {prev ? `${delta > 0 ? '+' : ''}${delta.toFixed(delta % 1 === 0 ? 0 : 1)}` : '-'}
                      </td>
                      <td class="px-3 py-2 text-right text-[12px] text-slate-400">{s.referenceUpper ? `〜${s.referenceUpper}` : '-'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <p class="text-[11px] text-slate-500">
            ※ 赤点線=基準値上限。前回比は橙=上昇、緑=改善。
          </p>
        </div>

        <footer class="sticky bottom-0 border-t border-slate-200 bg-white px-5 py-3 dark:border-slate-700 dark:bg-slate-800">
          <button
            type="button"
            data-trend-close
            class="btn-primary w-full"
          >閉じる</button>
        </footer>
      </div>
    </div>
  );
})}

<script is:inline>
  (function () {
    function openModal(id) {
      const el = document.getElementById(id);
      if (!el) return;
      el.hidden = false;
      document.body.style.overflow = 'hidden';
    }
    function closeAll() {
      document.querySelectorAll('[data-trend-modal]').forEach((el) => {
        el.hidden = true;
      });
      document.body.style.overflow = '';
    }
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const opener = target.closest('[data-trend-open]');
      if (opener) {
        const idx = opener.getAttribute('data-trend-open');
        openModal('trend-modal-' + idx);
        return;
      }
      if (target.closest('[data-trend-close]')) {
        closeAll();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });
  })();
</script>
