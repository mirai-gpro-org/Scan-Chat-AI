---
import AppIcon from '../AppIcon.astro';
import type { MetricTrendSeries } from '../../lib/dashboard-queries';

/**
 * 検査値の推移グラフ。
 *
 * 【原則】アプリは独自に分析・解釈しない。
 *   ここで描くのは (1) 検査票の実測値 (2) 検査票由来の基準帯 (3) 検査機関が付けた flag のみ。
 *   助言文・傾向コメントは生成しない (旧 commentFor() は削除した)。
 *
 * 「前回比」は直前の測定値との差であり、arithmetic であって判定ではない。
 *   ※ 旧実装は最初と最新の差 (last - first) を「差」として出していた。表記と計算が
 *     食い違っていたため、直前の点との差に修正した。
 */

interface Props {
  series: MetricTrendSeries[];
  title?: string;
}
const { series, title = '検査値の推移' } = Astro.props as Props;

const W = 320;
const H = 116;
const PAD_L = 40;
const PAD_R = 12;
const PAD_T = 14;
const PAD_B = 26;

function jpDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return `${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()}`;
}
function shortDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return `${d.getMonth() + 1}/${d.getDate()}`;
}

/** 1 系列分の描画データ (座標・基準帯・前回比) を組み立てる。 */
function build(s: MetricTrendSeries) {
  const vals = s.points.map((p) => p.value);
  const refs = [s.referenceUpper, s.referenceLower].filter((v): v is number => v != null);
  const lo0 = Math.min(...vals, ...refs);
  const hi0 = Math.max(...vals, ...refs);
  const pad = (hi0 - lo0 || Math.abs(hi0) || 1) * 0.18;
  const lo = lo0 - pad;
  const hi = hi0 + pad;

  const x = (i: number) =>
    s.points.length === 1
      ? PAD_L + (W - PAD_L - PAD_R) / 2
      : PAD_L + (i * (W - PAD_L - PAD_R)) / (s.points.length - 1);
  const y = (v: number) => PAD_T + ((hi - v) / (hi - lo || 1)) * (H - PAD_T - PAD_B);

  const pts = s.points.map((p, i) => ({ ...p, x: x(i), y: y(p.value) }));
  const path = pts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');

  // 基準帯 (上限/下限が分かる範囲で塗る)
  const bandTop = s.referenceUpper != null ? y(s.referenceUpper) : PAD_T;
  const bandBottom = s.referenceLower != null ? y(s.referenceLower) : H - PAD_B;
  const hasBand = s.referenceUpper != null || s.referenceLower != null;

  const last = s.points[s.points.length - 1];
  const prev = s.points.length >= 2 ? s.points[s.points.length - 2] : null;
  const diff = prev ? last.value - prev.value : null;
  const decimals = Math.max(
    ...s.points.map((p) => (String(p.raw).split('.')[1]?.length ?? 0)),
    0,
  );

  return { pts, path, bandTop, bandBottom, hasBand, last, prev, diff, decimals, lo, hi };
}

const charts = series.filter((s) => s.points.length > 0).map((s) => ({ s, d: build(s) }));
---

<section class="card">
  <h2 class="mb-1 flex items-center gap-2 text-base font-bold text-navy-800">
    <AppIcon name="trend" size={20} class="text-brand-700" />
    <span>{title}</span>
  </h2>
  <p class="mb-4 text-sm text-slate-600">
    検査票に記載された実測値と基準値をそのまま表示しています。
  </p>

  {charts.length === 0 ? (
    <p class="rounded-xl bg-slate-100 px-4 py-6 text-center text-base text-slate-600">
      推移を表示できる検査値がまだありません。検査が 2 回以上完了すると表示されます。
    </p>
  ) : (
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {charts.map(({ s, d }) => (
        <figure class="rounded-xl border border-slate-200 bg-white p-4">
          <figcaption class="mb-2 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <span class="text-base font-semibold text-navy-800">{s.label}</span>
            <span class="flex items-baseline gap-1.5">
              <span class="tnum text-2xl font-bold text-slate-900">{d.last.raw}</span>
              {s.unit && <span class="text-sm text-slate-600">{s.unit}</span>}
            </span>
          </figcaption>

          <div class="mb-2 flex flex-wrap items-center gap-2">
            {d.last.flag === 'H' && (
              <span class="status-pill status-watch">
                <AppIcon name="watch" size={14} />基準値より高い
              </span>
            )}
            {d.last.flag === 'L' && (
              <span class="status-pill status-watch">
                <AppIcon name="watch" size={14} />基準値より低い
              </span>
            )}
            {d.last.flag == null && (
              <span class="status-pill status-ok">
                <AppIcon name="ok" size={14} />基準値内
              </span>
            )}
            {d.diff != null && (
              <span class="tnum inline-flex items-center gap-1 text-sm text-slate-600">
                <AppIcon
                  name={d.diff > 0 ? 'up' : d.diff < 0 ? 'down' : 'flat'}
                  size={14}
                />
                前回比 {d.diff > 0 ? '+' : ''}{d.diff.toFixed(d.decimals)}
              </span>
            )}
          </div>

          <svg
            viewBox={`0 0 ${W} ${H}`}
            class="h-auto w-full"
            role="img"
            aria-label={`${s.label} の推移。最新 ${d.last.raw}${s.unit}（${jpDate(d.last.date)}）`}
          >
            {d.hasBand && (
              <rect
                x={PAD_L} y={d.bandTop}
                width={W - PAD_L - PAD_R}
                height={Math.max(0, d.bandBottom - d.bandTop)}
                class="fill-status-ok-bg"
              />
            )}
            {s.referenceUpper != null && (
              <line
                x1={PAD_L} x2={W - PAD_R} y1={d.bandTop} y2={d.bandTop}
                class="stroke-status-ok" stroke-width="1" stroke-dasharray="4 3"
              />
            )}
            {s.referenceLower != null && (
              <line
                x1={PAD_L} x2={W - PAD_R} y1={d.bandBottom} y2={d.bandBottom}
                class="stroke-status-ok" stroke-width="1" stroke-dasharray="4 3"
              />
            )}

            <line x1={PAD_L} x2={W - PAD_R} y1={H - PAD_B} y2={H - PAD_B} class="stroke-slate-200" stroke-width="1" />

            <path d={d.path} fill="none" class="stroke-brand-600" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round" />

            {d.pts.map((p, i) => (
              <>
                <circle
                  cx={p.x} cy={p.y} r={i === d.pts.length - 1 ? 4.5 : 3}
                  class={p.flag ? 'fill-status-watch' : 'fill-brand-600'}
                />
                {i === d.pts.length - 1 && (
                  <circle cx={p.x} cy={p.y} r="7.5" fill="none" class="stroke-brand-600" stroke-width="1.5" />
                )}
              </>
            ))}

            {[d.pts[0], d.pts[d.pts.length - 1]].map((p, i) =>
              d.pts.length > 1 || i === 0 ? (
                <text
                  x={p.x} y={H - PAD_B + 15}
                  text-anchor={i === 0 ? 'start' : 'end'}
                  class="fill-slate-600"
                  style="font-size:11px"
                >{shortDate(p.date)}</text>
              ) : null,
            )}

            {[
              { v: d.hi, y: PAD_T },
              { v: d.lo, y: H - PAD_B },
            ].map((t) => (
              <text
                x={PAD_L - 6} y={t.y + 4} text-anchor="end"
                class="fill-slate-500" style="font-size:11px"
              >{t.v.toFixed(d.decimals)}</text>
            ))}
          </svg>

          <p class="mt-1 text-sm text-slate-600">
            {jpDate(d.pts[0].date)} 〜 {jpDate(d.last.date)} ・ {d.pts.length} 回
            {(s.referenceLower != null || s.referenceUpper != null) && (
              <>
                {' ／ 基準値 '}
                <span class="tnum">
                  {s.referenceLower != null ? s.referenceLower : ''}
                  {s.referenceLower != null && s.referenceUpper != null ? '〜' : ''}
                  {s.referenceUpper != null ? s.referenceUpper : ' 以上'}
                </span>
              </>
            )}
          </p>
        </figure>
      ))}
    </div>
  )}
</section>
