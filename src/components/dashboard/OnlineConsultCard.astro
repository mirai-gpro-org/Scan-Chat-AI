---
import AppIcon from '../../components/AppIcon.astro';

/**
 * 医師との面談 (オプション)。AI ヘルスコーチ (AI が相手) とは性質が違うので枠を分ける。
 * v1.0 で旧「オンライン相談」から改称し、予約導線を外部サービスへ繋いだ (発注者指示 2026-08)。
 *
 * 【説明文を置いていない理由】サービス内容 (相手・時間・料金・予約方法) をこちらで確認できて
 *   いないため。事実でないことを書かない (ミッション④)。出しているのは
 *   「押すと外部サイトが開く」という、リンク先から確認できる事実だけ。
 *   文面が確定したら Wellfort から受け取ってここに載せる。
 */
const HREF = 'https://ishachoku.com/create-user/?company_id=224';
---

<section class="rounded-2xl bg-mist p-4 sm:p-5" aria-labelledby="consult-title">
  {/* スマホ (390px) は「面談を予約する」を横に置くと見出しが 1 文字ずつ折れるので、
      ボタンを次の行へ落とす (basis-full → sm 以上で auto)。 */}
  <div class="flex flex-wrap items-center gap-3">
    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand-600 text-white">
      <AppIcon name="doctor" size={22} />
    </span>
    <h3 id="consult-title" class="min-w-0 flex-1 text-base font-bold text-navy-800">医師との面談（オプション）</h3>
    <a
      href={HREF}
      target="_blank"
      rel="noopener"
      class="flex min-h-touch shrink-0 basis-full items-center justify-center gap-2 rounded-xl border border-navy-400 bg-white px-4 text-base font-semibold text-slate-800 transition hover:bg-brand-50 sm:basis-auto"
    >
      <AppIcon name="calendar" size={18} />面談を予約する<AppIcon name="external" size={16} class="text-slate-600" />
    </a>
  </div>
  <p class="mt-2.5 text-sm text-slate-700">外部サイト（ishachoku.com）が新しいタブで開きます。</p>
</section>
