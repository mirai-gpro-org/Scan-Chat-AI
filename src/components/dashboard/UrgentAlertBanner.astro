---
import type { UrgentAlert } from '../../lib/elith-parser';

interface Props {
  alert: UrgentAlert | null;
}
const { alert } = Astro.props as Props;
---

{alert && (
  <section
    class="relative overflow-hidden rounded-2xl border-2 border-red-400 bg-status-action-bg p-4"
    role="alert"
  >
    <div class="absolute -right-6 -top-6 h-24 w-24 rounded-full bg-red-200/40 blur-xl"></div>
    <div class="relative">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-red-700">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-red-600"></span>
        </span>
        <span>URGENT ALERT</span>
      </div>
      <h2 class="mt-1 text-lg font-bold text-red-800">
        {alert.title}
      </h2>
      <p class="mt-1 text-sm leading-relaxed text-red-900/90">
        {alert.body}
      </p>
      {alert.cta && (
        <button
          type="button"
          class="mt-3 inline-flex items-center justify-center rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow transition hover:bg-red-700 active:scale-95"
        >
          {alert.cta} →
        </button>
      )}
    </div>
  </section>
)}
