---
/**
 * AI ヘルスコーチ ページ。
 *
 * ユーザーの AI 診断結果 (Elith JSON 全 10 セクション + 検査履歴 + メトリック)
 * をサーバ側で context として読み込み、Gemini に「丸ごと」渡すことで
 * 結果を引用しながら答えるヘルスコーチを実現する。
 *
 * 3 種類の回答パターン:
 *   ① AI 診断結果から答えられる → 結果を引用
 *   ② 一般的な健康知識 → 「一般的に言われていますが」と但し書き
 *   ③ 医療アドバイス相当 → 拒否文言
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { buildCoachContext } from '../lib/coach-context';

export const prerender = false;

const url = new URL(Astro.request.url);
const rawU = url.searchParams.get('u');
const diagnosticUserId = rawU && /^[0-9a-f-]{36}$/i.test(rawU) ? rawU : null;

// SSR: ユーザーの AI 診断結果を読み込んで context を構築
const ctx = diagnosticUserId ? await buildCoachContext(diagnosticUserId).catch(() => null) : null;
const hasContext = !!ctx;
const displayName = ctx?.displayName ?? 'お客様';
const sectionCount = ctx?.sections.length ?? 0;
const urgentAlert = ctx?.urgentAlert ?? null;

const opener = hasContext
  ? `${displayName}、こんにちは 🌱 検査結果と AI 診断レポートを読み込みました。健康に関するご質問にお答えします。`
  : 'AI ヘルスコーチへようこそ。';
---

<BaseLayout title="AI ヘルスコーチ | Wellfort">
  <header class="hero-gradient px-5 pt-5 pb-3">
    <div class="flex items-center justify-between">
      <a
        href={diagnosticUserId ? `/dashboard?u=${encodeURIComponent(diagnosticUserId)}` : '/dashboard'}
        class="text-xs text-slate-500 hover:text-slate-700 dark:text-slate-400"
      >‹ ダッシュボード</a>
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <h1 class="text-base font-semibold">AI ヘルスコーチ</h1>
      </div>
      <button
        id="reset-btn"
        type="button"
        class="text-xs text-slate-500 hover:text-slate-800 dark:text-slate-400"
      >リセット</button>
    </div>
    {hasContext && (
      <p class="mt-2 text-[11px] text-slate-600 dark:text-slate-300">
        {displayName} の AI 診断結果 (Elith {sectionCount} セクション) を参照中
      </p>
    )}
  </header>

  {!diagnosticUserId && (
    <main class="flex flex-1 flex-col items-center justify-center gap-3 px-5 text-center">
      <span class="text-4xl">🔒</span>
      <h2 class="text-base font-semibold">ユーザー指定が必要です</h2>
      <p class="text-xs text-slate-500">ダッシュボードから AI ヘルスコーチを開いてください。</p>
      <a href="/dashboard" class="btn-primary mt-2">ダッシュボードへ</a>
    </main>
  )}

  {diagnosticUserId && !hasContext && (
    <main class="flex flex-1 flex-col items-center justify-center gap-3 px-5 text-center">
      <span class="text-4xl">📋</span>
      <h2 class="text-base font-semibold">AI 診断結果が見つかりません</h2>
      <p class="text-xs text-slate-500">検査結果が表示されているかダッシュボードでご確認ください。</p>
      <a
        href={`/dashboard?u=${encodeURIComponent(diagnosticUserId)}`}
        class="btn-primary mt-2"
      >ダッシュボードへ</a>
    </main>
  )}

  {hasContext && (
    <main
      id="coach-main"
      class="flex flex-1 flex-col px-5 pb-4"
      data-diagnostic-user-id={diagnosticUserId}
    >
      {urgentAlert && (
        <div class="mt-3 rounded-xl border border-red-300 bg-red-50 px-3 py-2 text-xs text-red-900 dark:border-red-700/60 dark:bg-red-900/30 dark:text-red-100">
          <strong>🔴 緊急留意事項:</strong> {urgentAlert.title}
        </div>
      )}

      <!-- 初期ロード表示 (チャット履歴がまだ無い時) -->
      <div
        id="coach-loading"
        class="mt-4 flex flex-col items-center gap-3 rounded-2xl bg-gradient-to-br from-brand-50 via-cyan-50 to-emerald-50 p-5 text-center dark:from-brand-900/20 dark:via-cyan-900/20 dark:to-emerald-900/20"
      >
        <div class="grid h-12 w-12 place-items-center rounded-full bg-gradient-to-br from-brand-500 to-cyan-500 text-white shadow-md">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="10" rx="2"/>
            <circle cx="12" cy="5" r="2"/>
            <path d="M12 7v4"/>
          </svg>
        </div>
        <p class="text-sm font-medium text-slate-800 dark:text-slate-100">{opener}</p>
        <p class="text-[11px] text-slate-500">
          例: 「尿酸値が高めですが、食事で気をつけることは？」<br/>
          例: 「朝食は毎日食べた方がいいですか？」
        </p>
      </div>

      <!-- チャットログ -->
      <div
        id="coach-log"
        class="mt-3 flex-1 space-y-3 overflow-y-auto"
        style="min-height: 30vh;"
        aria-live="polite"
      ></div>

      <!-- 入力フォーム -->
      <form id="coach-form" class="mt-3 flex items-end gap-2">
        <textarea
          id="coach-input"
          rows="1"
          maxlength="500"
          class="min-h-[44px] flex-1 resize-none rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100 dark:border-slate-700 dark:bg-slate-900"
          placeholder="健康に関する質問を入力..."
        ></textarea>
        <button
          id="coach-send"
          type="submit"
          class="btn-primary shrink-0 px-4 py-2.5 text-sm"
        >送信</button>
      </form>
      <p class="mt-1 text-center text-[10px] text-slate-400">
        ※ 医療アドバイスには該当しません。診断・治療は主治医にご相談ください。
      </p>
    </main>
  )}
</BaseLayout>

<script>
  interface CoachMessage {
    role: 'user' | 'assistant';
    text: string;
    at: string;
  }

  const STORAGE_KEY_PREFIX = 'coach.history.';

  function $opt<T extends HTMLElement = HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }
  function $<T extends HTMLElement = HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Element #${id} not found`);
    return el as T;
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  /**
   * 簡易 Markdown レンダラ (太字 / 改行のみ。LLM が出す表現の範囲で十分)
   */
  function renderMarkdown(text: string): string {
    const escaped = escapeHtml(text);
    return escaped
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/\n/g, '<br/>');
  }

  document.addEventListener('DOMContentLoaded', () => {
    const main = $opt('coach-main');
    if (!main) return; // context 無し時はスキップ

    const diagnosticUserId = main.dataset.diagnosticUserId ?? '';
    if (!diagnosticUserId) return;

    const storageKey = STORAGE_KEY_PREFIX + diagnosticUserId;
    const logEl = $('coach-log');
    const loadingEl = $opt('coach-loading');
    const form = $<HTMLFormElement>('coach-form');
    const input = $<HTMLTextAreaElement>('coach-input');
    const sendBtn = $<HTMLButtonElement>('coach-send');
    const resetBtn = $<HTMLButtonElement>('reset-btn');

    let history: CoachMessage[] = loadHistory();
    let sending = false;

    function loadHistory(): CoachMessage[] {
      try {
        const raw = localStorage.getItem(storageKey);
        if (!raw) return [];
        const arr = JSON.parse(raw);
        if (!Array.isArray(arr)) return [];
        return arr.filter(
          (m): m is CoachMessage =>
            m &&
            typeof m.text === 'string' &&
            (m.role === 'user' || m.role === 'assistant'),
        );
      } catch {
        return [];
      }
    }

    function saveHistory() {
      try {
        // 直近 30 件のみ保持 (ストレージ膨張防止)
        localStorage.setItem(storageKey, JSON.stringify(history.slice(-30)));
      } catch { /* ignore */ }
    }

    function renderHistory() {
      logEl.innerHTML = '';
      for (const m of history) {
        logEl.appendChild(makeBubble(m));
      }
      if (loadingEl) loadingEl.hidden = history.length > 0;
      scrollToBottom();
    }

    function makeBubble(m: CoachMessage): HTMLDivElement {
      const wrap = document.createElement('div');
      const isUser = m.role === 'user';
      wrap.className = isUser ? 'flex justify-end' : 'flex justify-start';
      const bubble = document.createElement('div');
      bubble.className = isUser
        ? 'max-w-[80%] rounded-2xl rounded-br-md bg-brand-600 px-3.5 py-2 text-sm text-white shadow-sm'
        : 'max-w-[85%] rounded-2xl rounded-bl-md border border-slate-200 bg-white px-3.5 py-2 text-sm leading-relaxed text-slate-800 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100';
      bubble.innerHTML = renderMarkdown(m.text);
      wrap.appendChild(bubble);
      return wrap;
    }

    function pushMessage(m: CoachMessage) {
      history.push(m);
      saveHistory();
      logEl.appendChild(makeBubble(m));
      if (loadingEl) loadingEl.hidden = true;
      scrollToBottom();
    }

    function scrollToBottom() {
      requestAnimationFrame(() => {
        logEl.scrollTop = logEl.scrollHeight;
      });
    }

    function makePending(): { el: HTMLDivElement; remove: () => void } {
      const wrap = document.createElement('div');
      wrap.className = 'flex justify-start';
      const bubble = document.createElement('div');
      bubble.className =
        'max-w-[85%] rounded-2xl rounded-bl-md border border-slate-200 bg-white px-3.5 py-2 text-sm text-slate-500 shadow-sm dark:border-slate-700 dark:bg-slate-900';
      bubble.innerHTML =
        '<span class="inline-flex items-center gap-1"><span class="h-1.5 w-1.5 animate-bounce rounded-full bg-slate-400" style="animation-delay:0ms"></span><span class="h-1.5 w-1.5 animate-bounce rounded-full bg-slate-400" style="animation-delay:120ms"></span><span class="h-1.5 w-1.5 animate-bounce rounded-full bg-slate-400" style="animation-delay:240ms"></span><span class="ml-2 text-xs">あなたのAI診断結果を読込んでいます。少々お待ちください。</span></span>';
      wrap.appendChild(bubble);
      logEl.appendChild(wrap);
      scrollToBottom();
      return {
        el: wrap,
        remove: () => wrap.remove(),
      };
    }

    function makeError(msg: string): HTMLDivElement {
      const wrap = document.createElement('div');
      wrap.className = 'flex justify-start';
      const bubble = document.createElement('div');
      bubble.className =
        'max-w-[85%] rounded-2xl rounded-bl-md border border-red-200 bg-red-50 px-3.5 py-2 text-sm text-red-700 shadow-sm dark:border-red-700/60 dark:bg-red-900/30 dark:text-red-100';
      bubble.textContent = `⚠️ ${msg}`;
      wrap.appendChild(bubble);
      return wrap;
    }

    async function sendMessage(text: string) {
      if (sending) return;
      sending = true;
      sendBtn.disabled = true;
      input.disabled = true;

      pushMessage({ role: 'user', text, at: new Date().toISOString() });

      const pending = makePending();

      try {
        const res = await fetch('/api/coach/ask', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            diagnosticUserId,
            message: text,
            history: history.slice(0, -1).map((m) => ({ role: m.role, text: m.text })),
          }),
        });
        pending.remove();

        if (!res.ok) {
          const body = await res.json().catch(() => null) as { error?: string } | null;
          const msg = body?.error ?? `送信に失敗しました (HTTP ${res.status})`;
          logEl.appendChild(makeError(msg));
          scrollToBottom();
        } else {
          const data = await res.json() as { answer: string; generatedAt: string };
          pushMessage({
            role: 'assistant',
            text: data.answer,
            at: data.generatedAt ?? new Date().toISOString(),
          });
        }
      } catch (err) {
        pending.remove();
        const detail = err instanceof Error ? err.message : String(err);
        logEl.appendChild(makeError(`通信エラー: ${detail}`));
        scrollToBottom();
      } finally {
        sending = false;
        sendBtn.disabled = false;
        input.disabled = false;
        input.value = '';
        autoResize();
        input.focus();
      }
    }

    function autoResize() {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 120) + 'px';
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;
      void sendMessage(text);
    });

    input.addEventListener('input', autoResize);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        const text = input.value.trim();
        if (text) void sendMessage(text);
      }
    });

    resetBtn.addEventListener('click', () => {
      if (history.length === 0) return;
      if (!confirm('会話履歴をリセットしますか?')) return;
      history = [];
      saveHistory();
      renderHistory();
    });

    renderHistory();
    input.focus();
  });
</script>
