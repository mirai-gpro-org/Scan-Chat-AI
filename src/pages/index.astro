---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Scan-Chat Medical AI">
  <header class="px-5 pt-6 pb-3">
    <h1 class="text-2xl font-bold tracking-tight">Scan-Chat Medical AI</h1>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
      モードを選んでください。
    </p>
  </header>

  <main class="flex flex-1 flex-col gap-4 px-5 pb-8">
    <a href="/scan" class="card flex items-center gap-4 transition hover:-translate-y-0.5">
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-700">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 7V5a2 2 0 0 1 2-2h2"/>
          <path d="M17 3h2a2 2 0 0 1 2 2v2"/>
          <path d="M21 17v2a2 2 0 0 1-2 2h-2"/>
          <path d="M7 21H5a2 2 0 0 1-2-2v-2"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </div>
      <div class="flex-1">
        <h2 class="text-base font-semibold">スキャン</h2>
        <p class="text-sm text-slate-600 dark:text-slate-300">
          カメラで体表を撮影し AI 解析
        </p>
      </div>
      <span aria-hidden class="text-slate-400">›</span>
    </a>

    <a href="/chat" class="card flex items-center gap-4 transition hover:-translate-y-0.5">
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent-500/10 text-accent-600">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
      </div>
      <div class="flex-1">
        <h2 class="text-base font-semibold">チャット</h2>
        <p class="text-sm text-slate-600 dark:text-slate-300">
          テキスト / 音声で問診
        </p>
      </div>
      <span aria-hidden class="text-slate-400">›</span>
    </a>

    <p class="mt-6 text-center text-xs text-slate-500">
      Pilot v0.1.0 — AI の応答は診断・処方ではありません
    </p>
  </main>
</BaseLayout>
