---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;

const url = new URL(Astro.request.url);
const rawU = url.searchParams.get('u');
const u = rawU && /^[0-9a-f-]{8,36}$/i.test(rawU) ? rawU : null;
const qs = u ? `?u=${encodeURIComponent(u)}` : '';
---

<BaseLayout title="Scan-Chat Medical AI">
  <header class="hero-gradient px-5 pt-8 pb-5">
    <p class="text-xs font-medium uppercase tracking-wider text-brand-700/80 dark:text-brand-300/80">
      Scan-Chat Medical AI
    </p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight">
      AI が、健康を聞く。
    </h1>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
      話す・選ぶ・タップする — あなたに合った方法で。
    </p>
  </header>

  <main class="flex flex-1 flex-col gap-3 px-5 pb-8">
    {/* ━━━ ダッシュボード (メイン) ━━━ */}
    <a
      href={`/dashboard${qs}`}
      class="card flex items-center gap-4 border-brand-200 transition hover:-translate-y-0.5 hover:shadow-md dark:border-brand-500/30"
    >
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-cyan-500 text-white shadow-md">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="7" height="9" x="3" y="3" rx="1" />
          <rect width="7" height="5" x="14" y="3" rx="1" />
          <rect width="7" height="9" x="14" y="12" rx="1" />
          <rect width="7" height="5" x="3" y="16" rx="1" />
        </svg>
      </div>
      <div class="flex-1">
        <h2 class="text-base font-semibold">ダッシュボード</h2>
        <p class="text-xs text-slate-600 dark:text-slate-300">
          検査結果・進捗・今日の気付きを一覧
        </p>
      </div>
      <span aria-hidden class="text-slate-400">›</span>
    </a>

    {/* ━━━ AI 問診 (大きめ) ━━━ */}
    <a
      href={`/chat${qs}`}
      class="group relative flex items-center gap-4 overflow-hidden rounded-2xl border border-brand-200 bg-gradient-to-br from-brand-500 via-indigo-500 to-cyan-500 p-5 text-white shadow-lg shadow-brand-500/20 transition hover:-translate-y-0.5 hover:shadow-xl"
    >
      <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-white/10 blur-2xl transition group-hover:bg-white/20"></div>
      <div class="relative flex h-14 w-14 items-center justify-center rounded-2xl bg-white/15 backdrop-blur">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 2v2"/>
          <path d="M5 2v2"/>
          <path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/>
          <path d="M8 15a6 6 0 0 0 12 0v-3"/>
          <circle cx="20" cy="10" r="2"/>
        </svg>
      </div>
      <div class="relative flex-1">
        <h2 class="text-lg font-bold tracking-tight">AI 問診を始める</h2>
        <p class="mt-0.5 text-sm text-white/85">
          音声・テキストどちらでも約 5 分
        </p>
      </div>
      <span class="relative text-xl">→</span>
    </a>

    {/* ━━━ AI スキャン ━━━ */}
    <a
      href={`/scan${qs}`}
      class="card flex items-center gap-4 transition hover:-translate-y-0.5"
    >
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/>
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
          <path d="M12 11h4"/>
          <path d="M12 16h4"/>
          <path d="M8 11h.01"/>
          <path d="M8 16h.01"/>
        </svg>
      </div>
      <div class="flex-1">
        <h2 class="text-base font-semibold">AI スキャン</h2>
        <p class="text-xs text-slate-600 dark:text-slate-300">
          検査表をカメラ撮影 → AI 転記
        </p>
      </div>
      <span aria-hidden class="text-slate-400">›</span>
    </a>

    <p class="mt-6 text-center text-xs text-slate-500">
      Pilot v0.1.0 — AI の応答は診断・処方ではありません
    </p>
  </main>
</BaseLayout>
