---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Scan-Chat Medical AI">
  <header class="hero-gradient px-5 pt-8 pb-5">
    <p class="text-xs font-medium uppercase tracking-wider text-brand-700/80 dark:text-brand-300/80">
      Scan-Chat Medical AI
    </p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight">
      AI が、健康を聞く。
    </h1>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
      話す・選ぶ・タップする — あなたに合った方法で。
    </p>
  </header>

  <main class="flex flex-1 flex-col gap-4 px-5 pb-8">
    <a
      href="/chat"
      class="group relative flex items-center gap-4 overflow-hidden rounded-2xl border border-brand-200 bg-gradient-to-br from-brand-500 via-indigo-500 to-cyan-500 p-5 text-white shadow-lg shadow-brand-500/20 transition hover:-translate-y-0.5 hover:shadow-xl"
    >
      <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-white/10 blur-2xl transition group-hover:bg-white/20"></div>
      <div class="relative flex h-14 w-14 items-center justify-center rounded-2xl bg-white/15 backdrop-blur">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/>
          <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
          <line x1="12" y1="19" x2="12" y2="22"/>
        </svg>
      </div>
      <div class="relative flex-1">
        <h2 class="text-lg font-bold tracking-tight">AI 問診を始める</h2>
        <p class="mt-0.5 text-sm text-white/85">
          音声・テキストどちらでも約 5 分
        </p>
      </div>
      <span class="relative text-xl">→</span>
    </a>

    <a
      href="/scan"
      class="card flex items-center gap-4 transition hover:-translate-y-0.5"
    >
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 7V5a2 2 0 0 1 2-2h2"/>
          <path d="M17 3h2a2 2 0 0 1 2 2v2"/>
          <path d="M21 17v2a2 2 0 0 1-2 2h-2"/>
          <path d="M7 21H5a2 2 0 0 1-2-2v-2"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </div>
      <div class="flex-1">
        <h2 class="text-base font-semibold">スキャン</h2>
        <p class="text-sm text-slate-600 dark:text-slate-300">
          検査表をカメラで撮影 → AI 転記
        </p>
      </div>
      <span aria-hidden class="text-slate-400">›</span>
    </a>

    <p class="mt-6 text-center text-xs text-slate-500">
      Pilot v0.1.0 — AI の応答は診断・処方ではありません
    </p>
  </main>
</BaseLayout>
