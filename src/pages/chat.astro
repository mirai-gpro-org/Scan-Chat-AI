---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgressBar from '../components/ProgressBar.astro';
import SuggestChips from '../components/SuggestChips.astro';
---

<BaseLayout title="チャット | Scan-Chat Medical AI">
  <header class="flex items-center justify-between px-5 pt-6 pb-3">
    <a href="/" class="text-sm text-brand-600 hover:underline">‹ 戻る</a>
    <h1 class="text-lg font-semibold">問診チャット</h1>
    <span class="w-10"></span>
  </header>

  <div class="px-5 pb-2">
    <ProgressBar value={0} label="問診の進捗状況" section="" id="chat-progress" />
  </div>

  <div
    id="chat-resume"
    class="mx-5 mb-2 rounded-xl border border-amber-300 bg-amber-50 px-3 py-2 text-xs text-amber-900 dark:border-amber-700/60 dark:bg-amber-900/30 dark:text-amber-100"
    hidden
  >
    前回の続きから再開しました。
  </div>

  <div class="flex items-center justify-between px-5 pb-2">
    <span id="chat-status" class="text-xs text-slate-500">未接続</span>
    <span class="text-xs text-slate-500">Gemini Live 3.1</span>
  </div>

  <main class="flex flex-1 flex-col gap-3 px-5 pb-3">
    <div
      id="chat-log"
      class="card flex-1 space-y-3 overflow-y-auto"
      style="min-height: 45vh;"
    >
    </div>

    <SuggestChips id="chat-suggest" suggestions={["こんにちは", "問診を始めたい", "前回の続きから"]} />

    <div class="flex justify-center">
      <button
        id="mic-btn"
        class="btn-primary rounded-full px-6 py-3 text-base shadow-md"
        type="button"
      >
        🎙️ 話す
      </button>
    </div>

    <details class="text-xs text-slate-500">
      <summary class="cursor-pointer select-none">⌨️ 代わりに入力する</summary>
      <div class="mt-2 flex items-end gap-2">
        <textarea
          id="chat-input"
          class="min-h-[44px] flex-1 resize-none rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100 dark:border-slate-700 dark:bg-slate-900"
          rows="1"
          placeholder="テキストで送信（音声セッション中のみ有効）"
        ></textarea>
        <button id="chat-send" class="btn-primary shrink-0" type="button">送信</button>
      </div>
    </details>
  </main>
</BaseLayout>

<script>
  import { initLiveController } from '../scripts/chat/live-controller';

  function $<T extends HTMLElement = HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Element #${id} not found`);
    return el as T;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const progressRoot = document.querySelector<HTMLElement>('[data-progress-root="chat-progress"]');
    void initLiveController({
      log: $('chat-log'),
      micBtn: $<HTMLButtonElement>('mic-btn'),
      textInput: $<HTMLTextAreaElement>('chat-input'),
      textSend: $<HTMLButtonElement>('chat-send'),
      status: $('chat-status'),
      progressFill: progressRoot?.querySelector<HTMLElement>('[data-progress-fill]') ?? null,
      progressText: progressRoot?.querySelector<HTMLElement>('[data-progress-text]') ?? null,
      progressSection: progressRoot?.querySelector<HTMLElement>('[data-progress-section]') ?? null,
      resumeBanner: document.getElementById('chat-resume'),
      suggestRoot: document.getElementById('chat-suggest'),
    });
  });
</script>
