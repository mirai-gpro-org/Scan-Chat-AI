---
import AppIcon from '../components/AppIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveViewer } from '../lib/viewer';

export const prerender = false;

const url = new URL(Astro.request.url);
// 入場は Cookie で本人を判定する (`src/lib/viewer.ts`)。`?u=` は admin の代理表示のみ。
const viewer = await resolveViewer(Astro);
const diagnosticUserId = viewer.uid;
---

<BaseLayout title="AI 問診 | Welltect" width="flow">
  <!--
    進行状況を常に見せるため sticky。選択画面 (choice-picker) はこのヘッダの
    高さを測って**その下から**開くので、全画面の選択中も進捗バーが隠れない。
    z-30 = スクリム(z-40)/パネル(z-50) より下だが、幾何的に重ならないので問題ない。
  -->
  <header id="chat-header" class="hero-gradient sticky top-0 z-30 px-5 pt-5 pb-3">
    <div class="flex items-center justify-between">
      <a href={diagnosticUserId ? `/?u=${encodeURIComponent(diagnosticUserId)}` : '/'} class="text-sm text-slate-600 hover:text-slate-900">
        ‹ メニュー
      </a>
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <h1 class="text-base font-semibold">AI 問診</h1>
      </div>
      <button
        id="reset-btn"
        type="button"
        class="text-xs text-slate-500 hover:text-slate-800"
      >
        リセット
      </button>
    </div>

    <div class="mt-3 flex items-center gap-1.5" id="section-dots" aria-label="セクション進捗">
      <!-- セクション dot は問診定義 (SECTIONS) に合わせて動的生成 -->
    </div>

    <div class="mt-2 flex items-center justify-between gap-3 text-xs">
      <span id="section-label" class="font-medium text-slate-700">準備中…</span>
      <!-- 表記は「問診完了まであと N%」(N=残り)。文言は live-controller の renderProgress が正。 -->
      <span id="progress-text" class="shrink-0 font-medium text-brand-700">問診完了まであと 100%</span>
    </div>
  </header>

  <div class="flex items-center justify-between px-5 pt-2 pb-1">
    <div class="inline-flex rounded-full bg-slate-100 p-1" role="tablist" id="mode-toggle">
      <button type="button" data-mode="voice" class="mode-pill on" role="tab" aria-selected="true">
        <AppIcon name="mic" size={20} /> 音声
      </button>
      <button type="button" data-mode="text" class="mode-pill" role="tab" aria-selected="false">
        ⌨ テキスト
      </button>
    </div>
    <span id="chat-status" class="text-xs text-slate-500">未接続</span>
  </div>

  <div
    id="chat-resume"
    class="mx-5 mt-1 rounded-xl border border-amber-300 bg-amber-50 px-3 py-2 text-xs text-amber-900"
    hidden
  >
    前回の続きから再開します。
  </div>

  <main
    id="chat-main"
    class="flex flex-1 flex-col gap-3 px-5 pt-3 pb-4"
    data-diagnostic-user-id={diagnosticUserId ?? ''}
  >
    <div
      id="chat-log"
      class="card flex-1 space-y-3 overflow-y-auto"
      style="min-height: 22vh; max-height: 45vh;"
      aria-live="polite"
      aria-atomic="false"
    >
      <div id="chat-empty" class="flex h-full flex-col items-center justify-center gap-2 py-6 text-center text-slate-400">
        <AppIcon name="interview" size={32} class="text-slate-500" />
        <p class="text-xs">下の <span class="font-medium text-brand-600"><AppIcon name="doctor" size={20} /> 問診を開始</span> から始めてください</p>
      </div>
    </div>

    <section
      id="answer-panel"
      class="card border-brand-200"
    >
      <!-- ━━━ START HERO（未接続時のみ表示） ━━━ -->
      <div id="start-hero" class="flex flex-col items-center gap-3 py-2">
        <!-- 冒頭の免責事項 (医療アドバイス・診断ではない旨) -->
        <p class="w-full rounded-lg bg-slate-50 px-3 py-2 text-center text-xs leading-relaxed text-slate-500">
          このAI問診で提供される情報は、医療上のアドバイスや診断として利用されるものではありません。必要な場合は、必ず医療専門家にご相談ください。
        </p>
        <p class="text-center text-xs text-slate-500">
          下のボタンで問診を開始します
        </p>
        <button
          id="start-btn"
          type="button"
          class="mic-fab mic-fab-hero"
          aria-label="問診を開始する"
        >
          <svg
            class="mic-icon"
            width="44" height="44" viewBox="0 0 24 24"
            fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M11 2v2"/>
            <path d="M5 2v2"/>
            <path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/>
            <path d="M8 15a6 6 0 0 0 12 0v-3"/>
            <circle cx="20" cy="10" r="2"/>
          </svg>
          <span class="mic-label mt-1 text-xs font-semibold">問診を開始</span>
        </button>
        <div class="mt-1 flex items-center gap-2 rounded-full bg-slate-50 px-3 py-1.5 text-xs text-slate-600">
          <span><AppIcon name="mic" size={20} /> 話す</span>
          <span class="text-slate-400">/</span>
          <span><AppIcon name="point" size={20} /> 選んでタップ</span>
          <span class="text-slate-400">—</span>
          <span class="font-medium text-brand-700">どちらでも OK</span>
        </div>
      </div>

      <!-- ━━━ QA AREA（接続時のみ表示） ━━━ -->
      <div id="qa-area" hidden>
        <div class="mb-3 flex items-start gap-2">
          <div id="question-text" class="flex-1 text-sm font-medium leading-relaxed text-slate-800">
            …
          </div>
          <button
            id="mic-btn"
            type="button"
            class="mic-fab compact shrink-0"
            aria-label="問診を中止"
          >
            <span class="mic-icon flex items-center justify-center"><AppIcon name="blocked" size={22} /></span>
            <span class="mic-label text-xs">中止</span>
          </button>
          <button
            id="speaker-btn"
            type="button"
            class="speaker-fab shrink-0"
            aria-label="音声の ON/OFF"
            title="音声 ON/OFF"
          >
            <svg
              class="speaker-ico speaker-ico-on"
              width="22" height="22" viewBox="0 0 24 24"
              fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true"
            >
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
            </svg>
            <svg
              class="speaker-ico speaker-ico-off"
              width="22" height="22" viewBox="0 0 24 24"
              fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true"
            >
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
              <line x1="22" y1="9" x2="16" y2="15"/>
              <line x1="16" y1="9" x2="22" y2="15"/>
            </svg>
            <span class="speaker-label text-xs">音声</span>
          </button>
        </div>

        <!-- 二刀流ヒント（widget 表示時のみ） -->
        <div
          id="dual-hint"
          class="mb-2 flex items-center justify-center gap-2 rounded-full bg-brand-50 px-3 py-1 text-xs text-brand-700"
          hidden
        >
          <span><AppIcon name="mic" size={20} /> 話してもOK</span>
          <span class="text-brand-400">・</span>
          <span><AppIcon name="point-down" size={20} /> タップでもOK</span>
        </div>

        <!-- 音声モード（質問なし時のループ待機） -->
        <div id="ui-voice" class="flex flex-col items-center gap-2 py-3">
          <div id="voice-indicator" class="grid place-items-center">
            <AppIcon name="mic" size={32} class="text-slate-500" />
          </div>
          <p class="text-center text-xs text-slate-500">
            話しかけてください
          </p>
        </div>

        <!--
          選択式 (chip 単一 / multi 複数 / list 多件数) は**すべて同じ選択画面**を使う。
          件数と収まり具合で ボトムシート / 全画面 / 全画面+検索 に自動で切り替わる
          (実装 src/scripts/chat/choice-picker.ts)。以前は chip だけインラインのカード、
          multi だけ別のボトムシートで、デザイン案と見た目が揃っていなかった。
        -->
        <div id="ui-list" class="flex flex-col gap-2" hidden>
          <button id="list-open" type="button" class="btn-primary w-full">
            <AppIcon name="list" size={20} /> 選択肢から選ぶ
          </button>
          <p id="list-summary" class="text-center text-sm text-slate-600"></p>
        </div>

        <!-- matrix マトリクス選択 (項目 × 頻度) -->
        <div id="ui-matrix" class="flex flex-col gap-2" hidden>
          <button id="matrix-open" type="button" class="btn-primary w-full">
            <AppIcon name="folder" size={20} /> 項目ごとに選ぶ
          </button>
          <p id="matrix-summary" class="text-center text-xs text-slate-500"></p>
        </div>

        <!-- slider 1-10 -->
        <div id="ui-slider" class="flex flex-col gap-3" hidden>
          <div class="flex items-center justify-center gap-3">
            <span id="slider-low" class="text-xs text-slate-500">低</span>
            <div
              id="slider-value"
              class="grid h-14 w-14 place-items-center rounded-2xl bg-brand-600 text-2xl font-bold text-white"
            >5</div>
            <span id="slider-high" class="text-xs text-slate-500">高</span>
          </div>
          <input id="slider-input" type="range" min="1" max="10" value="5" class="range-slider" />
          <button id="slider-submit" type="button" class="btn-primary">この値で回答</button>
        </div>

        <!-- stepper -->
        <div id="ui-stepper" class="flex flex-col gap-3" hidden>
          <div class="flex items-center justify-center gap-4">
            <button id="stepper-minus" type="button" class="stepper-btn" aria-label="減らす">−</button>
            <div class="flex items-baseline gap-1">
              <span id="stepper-value" class="text-3xl font-bold tabular-nums">0</span>
              <span id="stepper-unit" class="text-sm text-slate-500">本</span>
            </div>
            <button id="stepper-plus" type="button" class="stepper-btn" aria-label="増やす">＋</button>
          </div>
          <button id="stepper-submit" type="button" class="btn-primary">この量で回答</button>
        </div>

        <!-- free text -->
        <div id="ui-text" class="flex flex-col gap-2" hidden>
          <p id="text-example" class="text-xs text-slate-500" hidden></p>
          <textarea
            id="text-input"
            rows="2"
            class="resize-none rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
            placeholder="自由にお答えください"
          ></textarea>
          <button id="text-submit" type="button" class="btn-primary">送信</button>
        </div>

        <!-- 共通: スキップ -->
        <div class="mt-3 flex items-center justify-center gap-2">
          <button
            id="skip-btn"
            type="button"
            class="text-xs text-slate-500 hover:text-slate-700 hover:underline"
            hidden
          >答えたくない</button>
        </div>
      </div>
    </section>

    <!-- 常時併設: 補助テキスト入力（フリー入力。音声モードでも常に使える） -->
    <div id="fallback-text" class="flex items-end gap-2" hidden>
      <textarea
        id="fallback-input"
        rows="1"
        class="min-h-[44px] flex-1 resize-none rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
        placeholder="質問や補足を入力"
      ></textarea>
      <button id="fallback-send" type="button" class="btn-primary shrink-0">送信</button>
    </div>
  </main>

</BaseLayout>

<script>
  import { initLiveController } from '../scripts/chat/live-controller';

  function $<T extends HTMLElement = HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Element #${id} not found`);
    return el as T;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const main = document.getElementById('chat-main');
    const diagnosticUserId = main?.dataset.diagnosticUserId || null;

    void initLiveController({
      diagnosticUserId,
      log: $('chat-log'),
      status: $('chat-status'),
      resetBtn: $<HTMLButtonElement>('reset-btn'),
      resumeBanner: $('chat-resume'),

      progressText: $('progress-text'),
      sectionLabel: $('section-label'),
      sectionDots: $('section-dots'),

      modeToggle: $('mode-toggle'),
      micBtn: $<HTMLButtonElement>('mic-btn'),
      startBtn: $<HTMLButtonElement>('start-btn'),
      speakerBtn: $<HTMLButtonElement>('speaker-btn'),

      startHero: $('start-hero'),
      qaArea: $('qa-area'),
      dualHint: $('dual-hint'),
      answerPanel: $('answer-panel'),
      questionText: $('question-text'),

      uiVoice: $('ui-voice'),
      uiList: $('ui-list'),
      uiMatrix: $('ui-matrix'),
      uiSlider: $('ui-slider'),
      uiStepper: $('ui-stepper'),
      uiText: $('ui-text'),

      sliderInput: $<HTMLInputElement>('slider-input'),
      sliderValue: $('slider-value'),
      sliderLow: $('slider-low'),
      sliderHigh: $('slider-high'),
      sliderSubmit: $<HTMLButtonElement>('slider-submit'),

      stepperValue: $('stepper-value'),
      stepperUnit: $('stepper-unit'),
      stepperMinus: $<HTMLButtonElement>('stepper-minus'),
      stepperPlus: $<HTMLButtonElement>('stepper-plus'),
      stepperSubmit: $<HTMLButtonElement>('stepper-submit'),

      textInput: $<HTMLTextAreaElement>('text-input'),
      textSubmit: $<HTMLButtonElement>('text-submit'),
      textExample: $('text-example'),


      listOpen: $<HTMLButtonElement>('list-open'),
      listSummary: $('list-summary'),
      matrixOpen: $<HTMLButtonElement>('matrix-open'),
      matrixSummary: $('matrix-summary'),

      fallbackZone: $('fallback-text'),
      fallbackInput: $<HTMLTextAreaElement>('fallback-input'),
      fallbackSend: $<HTMLButtonElement>('fallback-send'),

      skipBtn: $<HTMLButtonElement>('skip-btn'),
    });
  });
</script>
