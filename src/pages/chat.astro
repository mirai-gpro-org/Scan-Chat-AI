---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="AI 問診 | Scan-Chat Medical AI">
  <header class="hero-gradient relative px-5 pt-5 pb-3">
    <div class="flex items-center justify-between">
      <a href="/" class="text-sm text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
        ‹ メニュー
      </a>
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <h1 class="text-base font-semibold">AI 問診</h1>
      </div>
      <button
        id="reset-btn"
        type="button"
        class="text-xs text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white"
      >
        リセット
      </button>
    </div>

    <div class="mt-3 flex items-center gap-1.5" id="section-dots" aria-label="セクション進捗">
      <div class="section-dot" data-section-dot="0"></div>
      <div class="section-dot" data-section-dot="1"></div>
      <div class="section-dot" data-section-dot="2"></div>
      <div class="section-dot" data-section-dot="3"></div>
      <div class="section-dot" data-section-dot="4"></div>
    </div>

    <div class="mt-2 flex items-center justify-between text-xs">
      <span id="section-label" class="font-medium text-slate-700 dark:text-slate-200">準備中…</span>
      <span id="progress-text" class="text-slate-500">0%</span>
    </div>
  </header>

  <div class="flex items-center justify-between px-5 pt-2 pb-1">
    <div class="inline-flex rounded-full bg-slate-100 p-1 dark:bg-slate-800" role="tablist" id="mode-toggle">
      <button type="button" data-mode="voice" class="mode-pill on" role="tab" aria-selected="true">
        🎙 音声
      </button>
      <button type="button" data-mode="text" class="mode-pill" role="tab" aria-selected="false">
        ⌨ テキスト
      </button>
    </div>
    <span id="chat-status" class="text-xs text-slate-500">未接続</span>
  </div>

  <div
    id="chat-resume"
    class="mx-5 mt-1 rounded-xl border border-amber-300 bg-amber-50 px-3 py-2 text-xs text-amber-900 dark:border-amber-700/60 dark:bg-amber-900/30 dark:text-amber-100"
    hidden
  >
    前回の続きから再開します。
  </div>

  <main class="flex flex-1 flex-col gap-3 px-5 pt-3 pb-4">
    <div
      id="chat-log"
      class="card flex-1 space-y-3 overflow-y-auto"
      style="min-height: 22vh; max-height: 45vh;"
      aria-live="polite"
      aria-atomic="false"
    >
      <div id="chat-empty" class="flex h-full flex-col items-center justify-center gap-2 py-6 text-center text-slate-400">
        <span class="text-4xl">💬</span>
        <p class="text-xs">下の <span class="font-medium text-brand-600">🩺 問診を開始</span> から始めてください</p>
      </div>
    </div>

    <section
      id="answer-panel"
      class="card border-brand-200 dark:border-brand-500/30"
      style="background: linear-gradient(180deg, rgba(99,102,241,0.04) 0%, rgba(255,255,255,0) 60%);"
    >
      <!-- ━━━ START HERO（未接続時のみ表示） ━━━ -->
      <div id="start-hero" class="flex flex-col items-center gap-3 py-2">
        <p class="text-center text-xs text-slate-500">
          下のボタンで問診を開始します
        </p>
        <button
          id="start-btn"
          type="button"
          class="mic-fab mic-fab-hero"
          aria-label="問診を開始する"
        >
          <svg
            class="mic-icon"
            width="44" height="44" viewBox="0 0 24 24"
            fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M11 2v2"/>
            <path d="M5 2v2"/>
            <path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/>
            <path d="M8 15a6 6 0 0 0 12 0v-3"/>
            <circle cx="20" cy="10" r="2"/>
          </svg>
          <span class="mic-label mt-1 text-xs font-semibold">問診を開始</span>
        </button>
        <div class="mt-1 flex items-center gap-2 rounded-full bg-slate-50 px-3 py-1.5 text-[11px] text-slate-600 dark:bg-slate-800/60 dark:text-slate-300">
          <span>🎙 話す</span>
          <span class="text-slate-400">/</span>
          <span>👆 選んでタップ</span>
          <span class="text-slate-400">—</span>
          <span class="font-medium text-brand-700 dark:text-brand-300">どちらでも OK</span>
        </div>
      </div>

      <!-- ━━━ QA AREA（接続時のみ表示） ━━━ -->
      <div id="qa-area" hidden>
        <div class="mb-3 flex items-start gap-3">
          <div id="question-text" class="flex-1 text-sm font-medium leading-relaxed text-slate-800 dark:text-slate-100">
            …
          </div>
          <button
            id="mic-btn"
            type="button"
            class="mic-fab compact shrink-0"
            aria-label="問診を中断"
          >
            <span class="mic-icon text-lg">⏸</span>
            <span class="mic-label text-[10px]">中断</span>
          </button>
        </div>

        <!-- 二刀流ヒント（widget 表示時のみ） -->
        <div
          id="dual-hint"
          class="mb-2 flex items-center justify-center gap-2 rounded-full bg-brand-50 px-3 py-1 text-[11px] text-brand-700 dark:bg-brand-500/10 dark:text-brand-300"
          hidden
        >
          <span>🎙 話してもOK</span>
          <span class="text-brand-400">・</span>
          <span>👇 タップでもOK</span>
        </div>

        <!-- 音声モード（質問なし時のループ待機） -->
        <div id="ui-voice" class="flex flex-col items-center gap-2 py-3">
          <div id="voice-indicator" class="grid place-items-center">
            <span class="text-4xl animate-pulse">🎙</span>
          </div>
          <p class="text-center text-xs text-slate-500">
            話しかけてください
          </p>
        </div>

        <!-- chip 単一選択 -->
        <div id="ui-chip" class="stagger flex flex-col gap-2" hidden></div>

        <!-- multi 複数選択 -->
        <div id="ui-multi" class="flex flex-col gap-2" hidden>
          <button id="multi-open" type="button" class="btn-primary w-full">
            ＋ 選択肢から選ぶ
          </button>
          <p id="multi-summary" class="text-center text-xs text-slate-500"></p>
        </div>

        <!-- slider 1-10 -->
        <div id="ui-slider" class="flex flex-col gap-3" hidden>
          <div class="flex items-center justify-center gap-3">
            <span id="slider-low" class="text-xs text-slate-500">低</span>
            <div
              id="slider-value"
              class="grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-brand-500 to-cyan-500 text-2xl font-bold text-white shadow-md"
            >5</div>
            <span id="slider-high" class="text-xs text-slate-500">高</span>
          </div>
          <input id="slider-input" type="range" min="1" max="10" value="5" class="range-slider" />
          <button id="slider-submit" type="button" class="btn-primary">この値で回答</button>
        </div>

        <!-- stepper -->
        <div id="ui-stepper" class="flex flex-col gap-3" hidden>
          <div class="flex items-center justify-center gap-4">
            <button id="stepper-minus" type="button" class="stepper-btn" aria-label="減らす">−</button>
            <div class="flex items-baseline gap-1">
              <span id="stepper-value" class="text-3xl font-bold tabular-nums">0</span>
              <span id="stepper-unit" class="text-sm text-slate-500">本</span>
            </div>
            <button id="stepper-plus" type="button" class="stepper-btn" aria-label="増やす">＋</button>
          </div>
          <button id="stepper-submit" type="button" class="btn-primary">この量で回答</button>
        </div>

        <!-- free text -->
        <div id="ui-text" class="flex flex-col gap-2" hidden>
          <textarea
            id="text-input"
            rows="2"
            class="resize-none rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100 dark:border-slate-700 dark:bg-slate-900"
            placeholder="自由にお答えください"
          ></textarea>
          <button id="text-submit" type="button" class="btn-primary">送信</button>
        </div>

        <!-- 共通: スキップ -->
        <div class="mt-3 flex items-center justify-center gap-2">
          <button
            id="skip-btn"
            type="button"
            class="text-xs text-slate-500 hover:text-slate-700 hover:underline dark:hover:text-slate-200"
            hidden
          >答えたくない</button>
        </div>
      </div>
    </section>

    <!-- 常時併設: 補助テキスト入力（フリー入力。音声モードでも常に使える） -->
    <div id="fallback-text" class="flex items-end gap-2" hidden>
      <textarea
        id="fallback-input"
        rows="1"
        class="min-h-[44px] flex-1 resize-none rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100 dark:border-slate-700 dark:bg-slate-900"
        placeholder="質問や補足を入力"
      ></textarea>
      <button id="fallback-send" type="button" class="btn-primary shrink-0">送信</button>
    </div>
  </main>

  <!-- マルチ選択モーダル (ボトムシート) -->
  <div id="multi-modal" hidden>
    <div class="sheet-backdrop" data-close-modal></div>
    <div class="sheet-panel" role="dialog" aria-modal="true" aria-labelledby="multi-title">
      <div class="sheet-handle"></div>
      <h2 id="multi-title" class="mb-3 text-base font-semibold">該当するものを選んでください</h2>
      <p class="mb-4 text-xs text-slate-500">複数選択できます</p>
      <div id="multi-options" class="space-y-2"></div>
      <div class="mt-5 flex gap-2">
        <button type="button" class="btn-secondary flex-1" data-close-modal>キャンセル</button>
        <button id="multi-confirm" type="button" class="btn-primary flex-1">決定</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { initLiveController } from '../scripts/chat/live-controller';

  function $<T extends HTMLElement = HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Element #${id} not found`);
    return el as T;
  }

  document.addEventListener('DOMContentLoaded', () => {
    void initLiveController({
      log: $('chat-log'),
      status: $('chat-status'),
      resetBtn: $<HTMLButtonElement>('reset-btn'),
      resumeBanner: $('chat-resume'),

      progressText: $('progress-text'),
      sectionLabel: $('section-label'),
      sectionDots: Array.from(
        document.querySelectorAll<HTMLElement>('[data-section-dot]'),
      ),

      modeToggle: $('mode-toggle'),
      micBtn: $<HTMLButtonElement>('mic-btn'),
      startBtn: $<HTMLButtonElement>('start-btn'),

      startHero: $('start-hero'),
      qaArea: $('qa-area'),
      dualHint: $('dual-hint'),
      answerPanel: $('answer-panel'),
      questionText: $('question-text'),

      uiVoice: $('ui-voice'),
      uiChip: $('ui-chip'),
      uiMulti: $('ui-multi'),
      uiSlider: $('ui-slider'),
      uiStepper: $('ui-stepper'),
      uiText: $('ui-text'),

      sliderInput: $<HTMLInputElement>('slider-input'),
      sliderValue: $('slider-value'),
      sliderLow: $('slider-low'),
      sliderHigh: $('slider-high'),
      sliderSubmit: $<HTMLButtonElement>('slider-submit'),

      stepperValue: $('stepper-value'),
      stepperUnit: $('stepper-unit'),
      stepperMinus: $<HTMLButtonElement>('stepper-minus'),
      stepperPlus: $<HTMLButtonElement>('stepper-plus'),
      stepperSubmit: $<HTMLButtonElement>('stepper-submit'),

      textInput: $<HTMLTextAreaElement>('text-input'),
      textSubmit: $<HTMLButtonElement>('text-submit'),

      multiOpen: $<HTMLButtonElement>('multi-open'),
      multiSummary: $('multi-summary'),
      multiModal: $('multi-modal'),
      multiOptions: $('multi-options'),
      multiTitle: $('multi-title'),
      multiConfirm: $<HTMLButtonElement>('multi-confirm'),

      fallbackZone: $('fallback-text'),
      fallbackInput: $<HTMLTextAreaElement>('fallback-input'),
      fallbackSend: $<HTMLButtonElement>('fallback-send'),

      skipBtn: $<HTMLButtonElement>('skip-btn'),
    });
  });
</script>
