---
import BaseLayout from '../layouts/BaseLayout.astro';
import UrgentAlertBanner from '../components/dashboard/UrgentAlertBanner.astro';
import MetricCard from '../components/dashboard/MetricCard.astro';
import DailyQuests from '../components/dashboard/DailyQuests.astro';
import HealthCoachPreview from '../components/dashboard/HealthCoachPreview.astro';
import SituationalCards from '../components/dashboard/SituationalCards.astro';
import KitProgressCard from '../components/dashboard/KitProgressCard.astro';
import HealthInsightCard from '../components/dashboard/HealthInsightCard.astro';
import MetricTrendChart from '../components/dashboard/MetricTrendChart.astro';
import TestHistoryList from '../components/dashboard/TestHistoryList.astro';
import { loadDashboard, formatGreeting, getMetricTrend } from '../lib/dashboard-queries';
import { countUnreadImportant } from '../lib/notice-queries';
import {
  extractMetricCards,
  extractUrgentAlert,
  extractDailyQuests,
  extractSituationalCards,
  findSection,
} from '../lib/elith-parser';

export const prerender = false;

const url = new URL(Astro.request.url);
const u = url.searchParams.get('u');

// 認証連携が有効 (Google One Tap が設定済) かつ ?u= が無い場合は、
// 他人のデフォルトデータを露出させないように sign-in gate を出す。
const authEnabled = !!import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
const needsSignIn = authEnabled && !u;

const result = needsSignIn ? null : await loadDashboard(u);

const hasError = result ? 'error' in result : false;
const data = !result || hasError ? null : (result as Exclude<typeof result, { error: string }>);

const metricTrend = data ? await getMetricTrend(data.diagnosticUserId) : [];

// ヘッダーの「お知らせ」バッジ用 — 未読の重要なお知らせ件数
const unreadNotices = data ? await countUnreadImportant(data.diagnosticUserId) : 0;
const noticesHref = u ? `/notices?u=${encodeURIComponent(u)}` : '/notices';

const greeting    = data ? formatGreeting(data) : '';
const sections    = data?.elithSections ?? [];
const urgentAlert = data ? extractUrgentAlert(sections) : null;
const metrics     = data ? extractMetricCards(sections) : [];
const quests      = data ? extractDailyQuests(sections) : [];
const situations  = data ? extractSituationalCards(sections) : [];
const abstract    = findSection(sections, 'アブストラクト');
const totalChars  = sections.reduce((sum, s) => sum + (s.char_count || 0), 0);

// OEM 相手先ブランド向けデモ顧客 (山田太郎 / da000001) はロゴを差し替える
const DEMO_OEM_UID = 'da000001-0000-0000-0000-000000000000';
const isDemoBrand = data?.diagnosticUserId === DEMO_OEM_UID;
const logoSrc = isDemoBrand ? '/gan-checker-logo.svg' : '/wellfort_logo.png';
const logoAlt = isDemoBrand ? 'がんチェッカー' : 'Wellfort';
---

<BaseLayout title={data ? `${greeting} | Wellfort` : 'マイページ | Wellfort'}>
  {needsSignIn && (
    <main class="flex flex-1 flex-col items-center justify-center gap-3 px-6 text-center">
      <img src="/wellfort_logo.png" alt="Wellfort" width="48" height="54" class="h-12 w-auto opacity-80" />
      <span class="inline-flex h-5 w-5 animate-spin rounded-full border-2 border-slate-300 border-t-brand-500"></span>
    </main>
  )}

  {hasError && (
    <main class="flex flex-1 flex-col items-center justify-center gap-3 px-5 text-center">
      <span class="text-4xl">⚠️</span>
      <h1 class="text-lg font-bold">ダッシュボードを読み込めませんでした</h1>
      <p class="text-sm text-red-700">{(result as { error: string }).error}</p>
      <p class="text-xs text-slate-500">supabase/README.md の手順で local stack が起動しているか確認してください。</p>
    </main>
  )}

  {!needsSignIn && !hasError && (
    <>
      <header class="hero-gradient px-5 pt-6 pb-4">
        <div class="flex items-center justify-between">
          <span class="w-9"></span>
          <img
            src={logoSrc}
            alt={logoAlt}
            height="40"
            class="h-10 w-auto select-none"
          />
          <a
            href={noticesHref}
            class="relative flex flex-col items-center text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200"
            aria-label="お知らせ"
          >
            <span class="text-xl leading-none">🔔</span>
            <span class="text-[10px] font-medium">お知らせ</span>
            {unreadNotices > 0 && (
              <span class="absolute -right-1 -top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-rose-500 px-1 text-[9px] font-bold text-white">
                {unreadNotices > 9 ? '9+' : unreadNotices}
              </span>
            )}
          </a>
        </div>
        <h1 class="mt-3 text-xl font-bold tracking-tight">
          {greeting}、こんにちは。
        </h1>
        {data?.latestResult?.received_at && (
          <p class="mt-1 text-[11px] text-slate-600 dark:text-slate-300">
            最新の AI 診断: {new Date(data.latestResult.received_at).toLocaleDateString('ja-JP')} ·
            <span class="ml-1 rounded-full bg-emerald-100 px-1.5 py-0.5 text-[10px] font-medium text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">
              {data.latestResult.status === 'published' ? '公開済' : data.latestResult.status}
            </span>
          </p>
        )}
      </header>

      <main class="flex flex-1 flex-col gap-4 px-5 pb-8">

        {urgentAlert && <UrgentAlertBanner alert={urgentAlert} />}

        {/* AI 問診 + AI スキャン への動線 */}
        <section class="grid grid-cols-2 gap-2">
          <a
            href={u ? `/chat?u=${encodeURIComponent(u)}` : '/chat'}
            class="group flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-br from-brand-500 via-indigo-500 to-cyan-500 px-3 py-3 text-white shadow-md shadow-brand-500/30 transition hover:-translate-y-0.5 hover:shadow-lg"
          >
            <span class="text-xl">🩺</span>
            <span class="text-sm font-semibold">AI 問診を始める</span>
          </a>
          <a
            href={u ? `/scan?u=${encodeURIComponent(u)}` : '/scan'}
            class="group flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-3 py-3 text-slate-800 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
          >
            <span class="text-xl">📸</span>
            <span class="text-sm font-semibold">AI スキャン</span>
          </a>
        </section>

        {metrics.length > 0 && (() => {
          // 各指標から「原本 PDF の該当ページ」へ deep link を作る:
          //   尿酸・中性脂肪・血糖値 → 血液検査 (test_type='blood') の latest artifact
          //   血圧 → 同上 (血液検査内に最高/最低血圧が含まれるため)
          // PDF は 1pg 単位なので page=1 固定で十分。
          const bloodArtifact = data?.artifacts.find((a) => a.test_type === 'blood') ?? null;
          const linkFor = (_label: string): string | null => {
            if (!bloodArtifact || !u) return null;
            return `/result/${bloodArtifact.id}?u=${encodeURIComponent(u)}&mode=full&page=1#pdf-viewer`;
          };
          return (
          <section>
            <header class="mb-2 flex items-center justify-between">
              <h2 class="text-sm font-bold text-slate-800 dark:text-slate-100">📈 直近の検査結果</h2>
              <span class="text-[10px] text-slate-500">AI診断結果 (Wellfort-Elith)</span>
            </header>
            <div class="grid grid-cols-3 gap-2">
              {metrics.map((m) => <MetricCard metric={m} href={linkFor(m.label)} />)}
            </div>
          </section>
          );
        })()}

        <DailyQuests quests={quests} />

        <HealthCoachPreview
          greeting={greeting}
          summaryHint={data?.latestResult?.summary_text}
          diagnosticUserId={data?.diagnosticUserId}
        />

        <HealthInsightCard diagnosticUserId={data?.diagnosticUserId ?? ''} />

        <MetricTrendChart series={metricTrend} />

        {situations.length > 0 && <SituationalCards cards={situations} />}

        <KitProgressCard
          shipments={data?.shipments ?? []}
          nextTestAt={data?.subscription?.next_test_at}
          planName={data?.subscription?.plan_name}
          diagnosticUserId={data?.diagnosticUserId ?? ''}
        />

        <TestHistoryList artifacts={data?.artifacts ?? []} diagnosticUserId={data?.diagnosticUserId} />

        {/* dev / debug 用フッタ */}
        <details class="rounded-2xl border border-dashed border-slate-300 p-3 dark:border-slate-700">
          <summary class="cursor-pointer text-xs font-medium text-slate-500">🛠 デバッグ (開発用)</summary>
          <dl class="mt-2 space-y-1 text-[11px] text-slate-600 dark:text-slate-400">
            <div class="flex justify-between"><dt>diagnostic_user_id:</dt><dd class="font-mono">{data?.diagnosticUserId}</dd></div>
            <div class="flex justify-between"><dt>artifacts:</dt><dd>{data?.artifacts.length} 件</dd></div>
            <div class="flex justify-between"><dt>shipments:</dt><dd>{data?.shipments.length} 件</dd></div>
            <div class="flex justify-between"><dt>Elith sections:</dt><dd>{sections.length} 件 / {totalChars.toLocaleString()} 字</dd></div>
            <div class="flex justify-between"><dt>abstract:</dt><dd>{abstract ? `${abstract.char_count}字` : 'なし'}</dd></div>
            <p class="pt-2 text-[10px]">他ユーザーで試す:</p>
            <div class="flex flex-wrap gap-1 pt-1">
              <a href="/dashboard?u=d0000001-0000-0000-0000-000000000000" class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300">真鍋 (主役)</a>
              <a href="/dashboard?u=d0000002-0000-0000-0000-000000000000" class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300">田中</a>
              <a href="/dashboard?u=d0000003-0000-0000-0000-000000000000" class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300">山田</a>
              <a href="/dashboard?u=d0000007-0000-0000-0000-000000000000" class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300">渡辺</a>
              <a href="/dashboard?u=da000001-0000-0000-0000-000000000000" class="rounded bg-emerald-100 px-1.5 py-0.5 text-[10px] text-emerald-800 hover:bg-emerald-200 dark:bg-emerald-900/40 dark:text-emerald-200">山田太郎 (OEMデモ)</a>
            </div>
          </dl>
        </details>
      </main>
    </>
  )}
</BaseLayout>
