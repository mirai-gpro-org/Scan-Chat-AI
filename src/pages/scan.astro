---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScanOverlay from '../components/ScanOverlay.astro';
import { getUserUploads } from '../lib/scan-queries';
import { testTypeLabel, formatJpDate } from '../lib/dashboard-queries';

export const prerender = false;

const url = new URL(Astro.request.url);
const rawU = url.searchParams.get('u');
const diagnosticUserId = rawU && /^[0-9a-f-]{36}$/i.test(rawU)
  ? rawU
  : (rawU ? `${rawU.slice(0, 8)}-0000-0000-0000-000000000000` : null);
const uploads = diagnosticUserId ? await getUserUploads(diagnosticUserId) : [];
const dashUrl = diagnosticUserId ? `/dashboard?u=${encodeURIComponent(diagnosticUserId)}` : '/dashboard';
---

<BaseLayout title="スキャン | Scan-Chat Medical AI">
  <header class="flex items-center justify-between px-5 pt-6 pb-3">
    <a href={diagnosticUserId ? `/?u=${encodeURIComponent(diagnosticUserId)}` : '/'} class="-ml-2 inline-flex h-10 w-10 items-center justify-center text-2xl text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200" aria-label="戻る">‹</a>
    <h1 class="text-base font-semibold">スキャン</h1>
    <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
      1 / 3
    </span>
  </header>

  <main class="flex flex-1 flex-col px-5 pb-8">

    <!-- ============================================================== -->
    <!-- パネル: ready（カメラ起動前のオンボーディング）                  -->
    <!-- ============================================================== -->
    <section id="panel-ready" class="flex flex-1 flex-col items-center gap-5 pt-2 text-center">
      <div class="flex h-20 w-20 items-center justify-center rounded-3xl bg-brand-50 text-4xl dark:bg-brand-600/10">
        📋
      </div>
      <div class="space-y-1">
        <h2 class="text-lg font-bold">健診結果をスキャン</h2>
        <p class="text-xs text-slate-600 dark:text-slate-300">
          検査用紙をカメラで読み取り、AI が項目を自動で認識します。
        </p>
      </div>
      {/* ━━━ メインアクション: ファイル (primary) + カメラ (secondary) ━━━ */}
      <div class="w-full space-y-2">
        <label
          for="scan-file"
          class="group flex w-full cursor-pointer flex-col items-center justify-center gap-1 rounded-2xl bg-gradient-to-br from-brand-600 to-cyan-600 px-5 py-5 text-center font-semibold text-white shadow-lg shadow-brand-500/30 transition hover:from-brand-700 hover:to-cyan-700 hover:shadow-xl active:scale-[0.98]"
        >
          <span class="text-3xl">📎</span>
          <span class="text-base">ファイルをアップロード</span>
          <span class="text-[11px] font-normal text-white/85">PDF / JPEG / PNG / WebP / HEIC<span class="text-white/65"> (最大 4 MB)</span></span>
        </label>
        <input
          id="scan-file"
          type="file"
          class="hidden"
          accept="application/pdf,image/jpeg,image/png,image/webp,image/heic,image/heif"
        />

        <button
          id="scan-start"
          class="flex w-full items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 active:scale-[0.98] dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          <span class="text-lg">📷</span>
          <span>カメラで撮影</span>
        </button>
      </div>

      {/* ━━━ これまでにスキャンした検査一覧 ━━━ */}
      {uploads.length > 0 && (
        <section class="w-full text-left">
          <header class="mb-2 flex items-center justify-between px-1">
            <h3 class="flex items-center gap-1.5 text-xs font-bold text-slate-700 dark:text-slate-200">
              <span>📚</span>
              <span>これまでにスキャンした検査</span>
            </h3>
            <a href={dashUrl} class="text-[10px] text-brand-600 hover:underline">全件 ›</a>
          </header>
          <ul class="space-y-1.5">
            {uploads.slice(0, 5).map((a) => {
              const tt = testTypeLabel(a.test_type);
              const href = diagnosticUserId
                ? `/result/${a.id}?u=${encodeURIComponent(diagnosticUserId)}`
                : `/result/${a.id}`;
              return (
                <li>
                  <a
                    href={href}
                    class="flex items-center gap-2.5 rounded-xl border border-slate-200 bg-white px-3 py-2 transition hover:border-brand-300 hover:shadow-sm dark:border-slate-700 dark:bg-slate-900"
                  >
                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-gradient-to-br from-brand-50 to-cyan-50 text-base dark:from-brand-500/20 dark:to-cyan-500/20">
                      {tt.emoji}
                    </span>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-baseline justify-between gap-2">
                        <h4 class="truncate text-sm font-medium text-slate-800 dark:text-slate-100">{tt.name}</h4>
                        <time class="shrink-0 text-[10px] text-slate-500">{formatJpDate(a.test_date)}</time>
                      </div>
                      <p class="mt-0.5 truncate text-[10px] text-slate-500">
                        {a.lab_name ?? 'ユーザー UL'}
                        {a.page_count && a.page_count > 1 && <span> · {a.page_count}pg</span>}
                      </p>
                    </div>
                    <span class="shrink-0 text-slate-400">›</span>
                  </a>
                </li>
              );
            })}
          </ul>
          {uploads.length > 5 && (
            <p class="mt-2 text-center text-[10px] text-slate-500">
              他 {uploads.length - 5} 件 — <a href={dashUrl} class="text-brand-600 hover:underline">ダッシュボードで確認</a>
            </p>
          )}
        </section>
      )}

      {/* ━━━ 撮影のコツ (折りたたみ) ━━━ */}
      <details class="w-full text-left">
        <summary class="cursor-pointer text-xs font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400">
          💡 きれいに読み取るコツ
        </summary>
        <ul class="mt-2 space-y-1 rounded-xl bg-slate-50 p-3 text-xs text-slate-700 dark:bg-slate-900 dark:text-slate-200">
          <li class="flex gap-2"><span aria-hidden>💡</span>明るい場所で撮影してください</li>
          <li class="flex gap-2"><span aria-hidden>📄</span>用紙全体が枠に収まるようにかざします</li>
          <li class="flex gap-2"><span aria-hidden>🔒</span>画像はサーバに保存されません</li>
        </ul>
      </details>
    </section>

    <!-- ============================================================== -->
    <!-- パネル: active / busy（カメラ起動中・解析中）                   -->
    <!-- ============================================================== -->
    <section id="panel-active" class="flex flex-1 flex-col gap-4" hidden>
      <div class="relative aspect-[3/4] w-full overflow-hidden rounded-2xl bg-black">
        <video
          id="scan-video"
          class="h-full w-full object-cover"
          playsinline
          muted
          autoplay></video>
        <ScanOverlay id="scan-overlay" />
        <canvas id="scan-canvas" class="hidden"></canvas>

        <!-- 撮影ガイド枠 -->
        <div class="pointer-events-none absolute inset-4 rounded-xl border-2 border-white/70"></div>

        <!-- 信頼度の凡例 -->
        <div class="pointer-events-none absolute left-3 top-3 rounded-full bg-black/55 px-2.5 py-1 text-xs text-white backdrop-blur-sm">
          <span class="mr-1 inline-block h-2 w-2 rounded-full bg-emerald-400 align-middle"></span>
          高信頼
          <span class="ml-2 mr-1 inline-block h-2 w-2 rounded-full bg-amber-300 align-middle"></span>
          要確認
        </div>

        <!-- 解析中オーバーレイ -->
        <div id="busy-overlay" class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-black/60 text-white backdrop-blur-sm" hidden>
          <div class="h-10 w-10 animate-spin rounded-full border-2 border-white/30 border-t-white"></div>
          <p class="text-sm font-medium">AI が解析しています…</p>
        </div>
      </div>

      <!-- セカンダリ操作行 -->
      <div class="flex items-center justify-between gap-2">
        <label class="inline-flex items-center gap-2 text-sm">
          <input
            id="scan-detect-toggle"
            type="checkbox"
            class="h-4 w-4 rounded border-slate-400 text-brand-600 focus:ring-brand-500"
          />
          AR 検知
        </label>
        <button id="hint-toggle" type="button" class="chip text-xs">
          💡 補足を追加
        </button>
      </div>

      <!-- ヒント入力（折りたたみ） -->
      <div id="hint-panel" hidden>
        <input
          id="scan-hint"
          type="text"
          class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100 dark:border-slate-700 dark:bg-slate-900"
          placeholder="例: 右前腕、3 日前から赤み"
          maxlength="200"
        />
      </div>

      <p id="scan-status" class="min-h-5 text-center text-xs text-slate-500 dark:text-slate-400" aria-live="polite"></p>

      <!-- プライマリ CTA -->
      <button id="scan-shot" class="btn-primary !py-4 text-lg">
        📷 撮影 & 解析
      </button>
    </section>

    <!-- ============================================================== -->
    <!-- パネル: result（解析結果 + ユーザー検証）                       -->
    <!-- ============================================================== -->
    <section id="panel-result" class="flex flex-1 flex-col gap-4" hidden>
      <!-- サマリ -->
      <div class="flex items-center gap-3 rounded-2xl bg-slate-100 px-4 py-3 text-slate-800 dark:bg-slate-800 dark:text-slate-100">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-500 text-white">📋</span>
        <p id="scan-result-summary" class="text-sm font-semibold">解析結果</p>
      </div>

      <!-- 表全体のトリミング画像 + ブロックオーバーレイ -->
      <section class="card !p-0">
        <h3 class="border-b border-slate-100 px-4 py-3 text-sm font-semibold dark:border-slate-800">
          表全体 (タップでブロックを確認)
        </h3>
        <div id="trimmed-image" class="p-3"></div>
      </section>

      <!-- 選択ブロックの詳細 -->
      <section id="block-detail" class="card !p-0" hidden>
        <header class="flex items-center justify-between border-b border-slate-100 px-4 py-3 dark:border-slate-800">
          <h3 id="block-detail-title" class="text-sm font-semibold">ブロック詳細</h3>
          <button id="block-detail-close" type="button" class="text-slate-400 hover:text-slate-700 dark:text-slate-500 dark:hover:text-slate-200" aria-label="閉じる">✕</button>
        </header>
        <div id="block-detail-body" class="overflow-x-auto p-3"></div>
      </section>

      <!-- 詳細データ (デバッグ) -->
      <details class="rounded-2xl border border-dashed border-slate-300 p-3 dark:border-slate-700">
        <summary class="cursor-pointer text-xs font-medium text-slate-500">詳細データ (開発用)</summary>
        <div class="mt-2 space-y-3">
          <div>
            <p class="mb-1 text-[10px] uppercase tracking-wide text-slate-400">
              Gemini raw markdown <span id="scan-finish" class="ml-1 rounded bg-slate-200 px-1.5 py-0.5 text-[10px] font-normal text-slate-700 dark:bg-slate-700 dark:text-slate-200"></span>
            </p>
            <pre id="scan-raw" class="max-h-[480px] overflow-auto whitespace-pre-wrap break-words rounded bg-slate-50 p-2 text-xs text-slate-700 dark:bg-slate-900 dark:text-slate-200"></pre>
          </div>
          <div>
            <p class="mb-1 text-[10px] uppercase tracking-wide text-slate-400">下流診断 AI 送信用 Markdown (編集反映)</p>
            <pre id="scan-result" class="max-h-72 overflow-auto whitespace-pre-wrap break-words rounded bg-slate-50 p-2 text-xs text-slate-700 dark:bg-slate-900 dark:text-slate-200"></pre>
          </div>
        </div>
      </details>

      <!-- CTA: 確認して送信 / 再撮影 -->
      <div class="mt-auto flex flex-col gap-2 pt-2">
        <button id="scan-submit" type="button" class="btn-primary !py-4 text-lg" disabled>
          ✓ 確認して送信
        </button>
        <p id="scan-submit-hint" class="text-center text-xs text-slate-500" aria-live="polite"></p>
        <button id="scan-retake" type="button" class="btn-secondary">
          もう一度撮影する
        </button>
      </div>
    </section>

    <!-- 行修正モーダル: セル単位で疑念解消 -->
    <div id="row-edit-modal" class="fixed inset-0 z-50 flex items-end justify-center bg-slate-900/60 p-4 md:items-center" hidden>
      <div class="flex max-h-[90vh] w-full max-w-lg flex-col rounded-2xl bg-white shadow-2xl dark:bg-slate-900" role="dialog" aria-modal="true">
        <header class="flex items-start justify-between gap-2 border-b border-slate-100 px-4 py-3 dark:border-slate-800">
          <h4 id="row-edit-title" class="text-base font-semibold">行の修正</h4>
          <button id="row-edit-cancel" type="button" class="text-slate-400 hover:text-slate-700 dark:text-slate-500 dark:hover:text-slate-200" aria-label="閉じる">✕</button>
        </header>
        <div id="row-edit-cells" class="flex-1 space-y-2 overflow-y-auto px-3 py-3"></div>
        <footer class="border-t border-slate-100 px-4 py-3 dark:border-slate-800">
          <p class="mb-2 text-[10px] text-slate-500">
            <span class="inline-block h-2 w-2 rounded bg-amber-300"></span> 要確認のセル: 修正を入力するか「このまま OK」で解消します。
          </p>
          <button id="row-edit-save" type="button" class="btn-primary w-full !py-2 text-sm">💾 保存して閉じる</button>
        </footer>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- パネル: error                                                   -->
    <!-- ============================================================== -->
    <section id="panel-error" class="flex flex-1 flex-col items-center justify-center gap-6 text-center" hidden>
      <div class="flex h-20 w-20 items-center justify-center rounded-3xl bg-rose-50 text-4xl dark:bg-rose-900/30">
        ⚠
      </div>
      <div class="space-y-2">
        <h2 class="text-lg font-bold">スキャンを開始できません</h2>
        <p id="error-message" class="text-sm text-slate-600 dark:text-slate-300"></p>
      </div>
      <div class="mt-auto flex w-full flex-col gap-2">
        <button id="error-retry" class="btn-primary w-full !py-4 text-lg">再試行</button>
        <a href={diagnosticUserId ? `/?u=${encodeURIComponent(diagnosticUserId)}` : '/'} class="btn-secondary text-center">トップへ戻る</a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { initCameraScan } from '../scripts/camera-scan';
  import type { AnalyzeResult, ScanState } from '../scripts/camera-scan';
  import { ScanVerificationController } from '../scripts/scan-verification';
  import { getOrCreateDiagnosticId } from '../lib/diagnostic-id';

  function $<T extends HTMLElement = HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Element #${id} not found`);
    return el as T;
  }

  type Panel = 'ready' | 'active' | 'result' | 'error';
  const panels: Record<Panel, HTMLElement> = {
    ready: $('panel-ready'),
    active: $('panel-active'),
    result: $('panel-result'),
    error: $('panel-error'),
  };

  function show(panel: Panel): void {
    (Object.keys(panels) as Panel[]).forEach((key) => {
      panels[key].hidden = key !== panel;
    });
  }

  async function renderResult(r: AnalyzeResult): Promise<void> {
    // Gemini 生 markdown (推論値列含む) — 監査の透明性のため raw のまま表示
    ($('scan-raw') as HTMLPreElement).textContent = r.markdown || '(empty)';
    const finish = r.finishReason ?? '';
    const finishEl = $('scan-finish');
    finishEl.textContent = finish ? `finish: ${finish}` : '';
    const hasBadFinish = finish === 'MAX_TOKENS' || finish === 'SAFETY';
    finishEl.classList.toggle('bg-rose-200', hasBadFinish);
    finishEl.classList.toggle('text-rose-900', hasBadFinish);

    // 検証 UI: 表トリミング画像 + ブロック詳細 + 行修正モーダル
    const diagnosticId = getOrCreateDiagnosticId();
    const controller = new ScanVerificationController(
      {
        trimmedImage: $('trimmed-image'),
        blockDetail: $('block-detail'),
        blockDetailTitle: $('block-detail-title'),
        blockDetailBody: $('block-detail-body'),
        resultSummary: $('scan-result-summary'),
        downstreamPreview: $('scan-result'),
        submitBtn: $<HTMLButtonElement>('scan-submit'),
        submitHint: $('scan-submit-hint'),
        rowEditModal: $('row-edit-modal'),
        rowEditTitle: $('row-edit-title'),
        rowEditCellsContainer: $('row-edit-cells'),
        rowEditSaveBtn: $<HTMLButtonElement>('row-edit-save'),
        rowEditCancelBtn: $<HTMLButtonElement>('row-edit-cancel'),
      },
      r,
      diagnosticId,
    );
    await controller.render();

    // block-detail パネルの閉じるボタン
    $('block-detail-close').onclick = () => {
      $('block-detail').hidden = true;
    };
  }

  document.addEventListener('DOMContentLoaded', () => {
    const controller = initCameraScan({
      video: $<HTMLVideoElement>('scan-video'),
      canvas: $<HTMLCanvasElement>('scan-canvas'),
      shotBtn: $<HTMLButtonElement>('scan-shot'),
      status: $('scan-status'),
      hint: $<HTMLInputElement>('scan-hint'),
      onStateChange: (state: ScanState) => {
        $('busy-overlay').hidden = state !== 'busy';
        const shot = $<HTMLButtonElement>('scan-shot');
        shot.textContent = state === 'busy' ? '解析中…' : '📷 撮影 & 解析';
      },
      onAnalyze: (result) => {
        void renderResult(result);
        controller.stop();
        show('result');
      },
      onError: (msg) => {
        $('error-message').textContent = msg;
        show('error');
      },
    });

    $('scan-start').addEventListener('click', async () => {
      show('active');
      await controller.start();
    });

    // ファイルアップロード経路 (PDF / 画像)
    $<HTMLInputElement>('scan-file').addEventListener('change', async (e) => {
      const target = e.target as HTMLInputElement;
      const file = target.files?.[0];
      if (!file) return;
      target.value = ''; // 同じファイルの再選択を許可

      const MAX_BYTES = 4 * 1024 * 1024;
      if (file.size > MAX_BYTES) {
        $('error-message').textContent =
          `ファイルサイズが大きすぎます (${(file.size / 1024 / 1024).toFixed(1)} MB)。4 MB 以下にしてください。`;
        show('error');
        return;
      }

      try {
        const dataUrl = await readFileAsDataUrl(file);
        // ファイル経由はカメラ起動なしで panel-active を表示し、video エリアは非表示にする
        show('active');
        $('scan-video').hidden = true;
        const label = file.type === 'application/pdf' ? `PDF (${file.name})` : `画像 (${file.name})`;
        await controller.analyzeDataUrl(dataUrl, { sourceLabel: label });
      } catch (err) {
        $('error-message').textContent = String(err);
        show('error');
      }
    });

    function readFileAsDataUrl(file: File): Promise<string> {
      return new Promise((resolve, reject) => {
        const fr = new FileReader();
        fr.onload = () => resolve(String(fr.result));
        fr.onerror = () => reject(new Error('ファイルの読み込みに失敗しました'));
        fr.readAsDataURL(file);
      });
    }

    $('scan-retake').addEventListener('click', async () => {
      show('active');
      $('scan-video').hidden = false; // ファイル経由で隠していた場合の復旧
      await controller.start();
    });

    $('error-retry').addEventListener('click', () => {
      $('error-message').textContent = '';
      show('ready');
    });

    $('hint-toggle').addEventListener('click', () => {
      const h = $('hint-panel');
      h.hidden = !h.hidden;
      if (!h.hidden) ($('scan-hint') as HTMLInputElement).focus();
    });

    window.addEventListener('pagehide', () => controller.stop());

    show('ready');
  });
</script>
