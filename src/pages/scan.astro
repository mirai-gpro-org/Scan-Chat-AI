---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScanOverlay from '../components/ScanOverlay.astro';
---

<BaseLayout title="スキャン | Scan-Chat Medical AI">
  <header class="mx-auto flex w-full max-w-3xl items-center justify-between px-5 pt-6 pb-3 md:max-w-6xl">
    <a href="/" class="-ml-2 inline-flex h-10 w-10 items-center justify-center text-2xl text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200" aria-label="戻る">‹</a>
    <h1 class="text-base font-semibold md:text-lg">スキャン</h1>
    <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300 md:text-sm">
      1 / 3
    </span>
  </header>

  <main class="mx-auto flex w-full max-w-3xl flex-1 flex-col px-5 pb-8 md:max-w-6xl">

    <!-- ============================================================== -->
    <!-- パネル: ready（カメラ起動前のオンボーディング）                  -->
    <!-- ============================================================== -->
    <section id="panel-ready" class="mx-auto flex w-full max-w-md flex-1 flex-col items-center justify-center gap-6 text-center md:max-w-lg md:gap-8">
      <div class="flex h-24 w-24 items-center justify-center rounded-3xl bg-brand-50 text-5xl dark:bg-brand-600/10 md:h-32 md:w-32 md:text-6xl">
        📋
      </div>
      <div class="space-y-2">
        <h2 class="text-xl font-bold md:text-2xl">健診結果をスキャン</h2>
        <p class="text-sm text-slate-600 dark:text-slate-300 md:text-base">
          検査用紙をカメラで読み取り、ネイティブマルチモーダル AI が
          表構造・手書き・強調マークを統合的に理解して値を抽出します。
        </p>
      </div>
      <ul class="w-full space-y-2 rounded-2xl bg-slate-50 p-4 text-left text-sm text-slate-700 dark:bg-slate-900 dark:text-slate-200 md:p-5 md:text-base">
        <li class="flex gap-2"><span aria-hidden>💡</span>明るい場所で撮影してください</li>
        <li class="flex gap-2"><span aria-hidden>📄</span>用紙全体が枠に収まるようにかざします</li>
        <li class="flex gap-2"><span aria-hidden>🔒</span>画像はサーバに保存されません</li>
      </ul>
      <div class="mt-auto flex w-full flex-col gap-2">
        <button id="scan-start" class="btn-primary w-full !py-4 text-lg md:!py-5 md:text-xl">
          📷 スキャンを開始
        </button>
        <p class="text-center text-xs text-slate-500 md:text-sm">
          タップするとカメラへのアクセス許可を求めます
        </p>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- パネル: active / busy（カメラ起動中・解析中）                   -->
    <!-- ============================================================== -->
    <section id="panel-active" class="mx-auto flex w-full max-w-xl flex-1 flex-col gap-4 md:max-w-3xl" hidden>
      <div class="relative aspect-[3/4] w-full overflow-hidden rounded-2xl bg-black md:aspect-[4/3]">
        <video
          id="scan-video"
          class="h-full w-full object-cover"
          playsinline
          muted
          autoplay></video>
        <ScanOverlay id="scan-overlay" />
        <canvas id="scan-canvas" class="hidden"></canvas>

        <!-- 撮影ガイド枠 -->
        <div class="pointer-events-none absolute inset-4 rounded-xl border-2 border-white/70 md:inset-6"></div>

        <!-- 信頼度の凡例 -->
        <div class="pointer-events-none absolute left-3 top-3 rounded-full bg-black/55 px-2.5 py-1 text-xs text-white backdrop-blur-sm md:left-4 md:top-4 md:px-3 md:py-1.5 md:text-sm">
          <span class="mr-1 inline-block h-2 w-2 rounded-full bg-emerald-400 align-middle"></span>
          高信頼
          <span class="ml-2 mr-1 inline-block h-2 w-2 rounded-full bg-amber-300 align-middle"></span>
          要確認
        </div>

        <!-- 解析中オーバーレイ（ストリーミング進捗付き）-->
        <div id="busy-overlay" class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-black/60 text-white backdrop-blur-sm md:gap-4" hidden>
          <div class="h-10 w-10 animate-spin rounded-full border-2 border-white/30 border-t-white md:h-14 md:w-14"></div>
          <p id="busy-label" class="text-sm font-medium md:text-base">AI が解析しています…</p>
          <p id="busy-progress" class="text-xs text-white/70 md:text-sm"></p>
        </div>
      </div>

      <!-- セカンダリ操作行 -->
      <div class="flex items-center justify-between gap-2 md:gap-3">
        <label class="inline-flex items-center gap-2 text-sm md:text-base">
          <input
            id="scan-detect-toggle"
            type="checkbox"
            class="h-4 w-4 rounded border-slate-400 text-brand-600 focus:ring-brand-500 md:h-5 md:w-5"
            checked
          />
          AR 検知
        </label>
        <button id="hint-toggle" type="button" class="chip text-xs md:text-sm">
          💡 補足を追加
        </button>
      </div>

      <!-- ヒント入力（折りたたみ） -->
      <div id="hint-panel" hidden>
        <input
          id="scan-hint"
          type="text"
          class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100 dark:border-slate-700 dark:bg-slate-900 md:text-base"
          placeholder="例: 右前腕、3 日前から赤み"
          maxlength="200"
        />
      </div>

      <p id="scan-status" class="min-h-5 text-center text-xs text-slate-500 dark:text-slate-400 md:text-sm" aria-live="polite"></p>

      <!-- プライマリ CTA -->
      <button id="scan-shot" class="btn-primary !py-4 text-lg md:!py-5 md:text-xl">
        📷 撮影 & 解析
      </button>
    </section>

    <!-- ============================================================== -->
    <!-- パネル: result（解析結果・タブレットでは 2 カラム）             -->
    <!-- ============================================================== -->
    <section id="panel-result" class="flex flex-1 flex-col gap-4 md:gap-6" hidden>
      <div class="flex items-center gap-3 rounded-2xl bg-emerald-50 px-4 py-3 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-200 md:px-5 md:py-4">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-500 text-white md:h-10 md:w-10 md:text-lg">✓</span>
        <p id="result-count" class="text-sm font-semibold md:text-base">解析が完了しました</p>
      </div>

      <!-- 2 カラム: タブレット以上で画像と項目を横並びに -->
      <div class="grid grid-cols-1 gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] md:gap-6">
        <!-- 左: 撮影画像プレビュー（ベリファイ用に紙原本と並べて見られる） -->
        <section class="card !p-3 md:sticky md:top-4 md:self-start md:!p-4">
          <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500 md:text-sm">
            撮影画像（原本との照合用）
          </h3>
          <div class="overflow-hidden rounded-xl bg-slate-100 dark:bg-slate-900">
            <img id="result-image" alt="撮影した検査用紙" class="block w-full" />
          </div>
        </section>

        <!-- 右: 認識項目 -->
        <section class="card !p-0">
          <h3 class="border-b border-slate-100 px-4 py-3 text-sm font-semibold dark:border-slate-800 md:px-5 md:py-4 md:text-base">
            認識項目
          </h3>
          <ul id="items-list" class="divide-y divide-slate-100 dark:divide-slate-800">
            <li class="px-4 py-6 text-center text-sm text-slate-500 md:py-8 md:text-base">項目は検出されませんでした</li>
          </ul>
        </section>
      </div>

      <!-- Raw JSON（開発用） -->
      <details open class="rounded-2xl border border-dashed border-slate-300 p-3 dark:border-slate-700 md:p-4">
        <summary class="cursor-pointer text-xs font-medium text-slate-500 md:text-sm">詳細データ (JSON)</summary>
        <div class="mt-2 space-y-3 md:mt-3">
          <div>
            <p class="mb-1 text-[10px] uppercase tracking-wide text-slate-400 md:text-xs">
              Gemini raw response <span id="scan-finish" class="ml-1 rounded bg-slate-200 px-1.5 py-0.5 text-[10px] font-normal text-slate-700 dark:bg-slate-700 dark:text-slate-200 md:text-xs"></span>
            </p>
            <pre id="scan-raw" class="max-h-[480px] overflow-auto whitespace-pre-wrap break-words rounded bg-slate-50 p-2 text-xs text-slate-700 dark:bg-slate-900 dark:text-slate-200 md:p-3 md:text-sm"></pre>
          </div>
          <div>
            <p class="mb-1 text-[10px] uppercase tracking-wide text-slate-400 md:text-xs">Parsed result</p>
            <pre id="scan-result" class="max-h-72 overflow-auto whitespace-pre-wrap break-words rounded bg-slate-50 p-2 text-xs text-slate-700 dark:bg-slate-900 dark:text-slate-200 md:p-3 md:text-sm"></pre>
          </div>
        </div>
      </details>

      <!-- CTA -->
      <div class="mt-auto flex flex-col gap-2 pt-2 md:flex-row-reverse md:gap-3">
        <a href="/chat" class="btn-primary !py-4 text-lg md:flex-1 md:!py-5 md:text-xl">
          問診を開始する →
        </a>
        <button id="scan-retake" type="button" class="btn-secondary md:flex-1 md:!py-5 md:text-lg">
          もう一度撮影する
        </button>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- パネル: error                                                   -->
    <!-- ============================================================== -->
    <section id="panel-error" class="mx-auto flex w-full max-w-md flex-1 flex-col items-center justify-center gap-6 text-center md:max-w-lg" hidden>
      <div class="flex h-20 w-20 items-center justify-center rounded-3xl bg-rose-50 text-4xl dark:bg-rose-900/30 md:h-24 md:w-24 md:text-5xl">
        ⚠
      </div>
      <div class="space-y-2">
        <h2 class="text-lg font-bold md:text-xl">スキャンを開始できません</h2>
        <p id="error-message" class="whitespace-pre-wrap text-sm text-slate-600 dark:text-slate-300 md:text-base"></p>
      </div>
      <div class="mt-auto flex w-full flex-col gap-2">
        <button id="error-retry" class="btn-primary w-full !py-4 text-lg md:!py-5 md:text-xl">再試行</button>
        <a href="/" class="btn-secondary text-center">トップへ戻る</a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { initCameraScan } from '../scripts/camera-scan';
  import type { AnalyzeResult, ScanItem, ScanState } from '../scripts/camera-scan';

  function $<T extends HTMLElement = HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Element #${id} not found`);
    return el as T;
  }

  type Panel = 'ready' | 'active' | 'result' | 'error';
  const panels: Record<Panel, HTMLElement> = {
    ready: $('panel-ready'),
    active: $('panel-active'),
    result: $('panel-result'),
    error: $('panel-error'),
  };

  function show(panel: Panel): void {
    (Object.keys(panels) as Panel[]).forEach((key) => {
      panels[key].hidden = key !== panel;
    });
  }

  function escapeHtml(s: unknown): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderItem(it: ScanItem): string {
    const handwritten = it.kind === 'handwritten';
    const lowConf = it.confidence === 'low';
    const flagBadge =
      it.flag === 'H'
        ? '<span class="rounded bg-rose-100 px-1.5 py-0.5 text-[10px] font-bold text-rose-800 dark:bg-rose-900/40 dark:text-rose-200 md:text-xs">H</span>'
        : it.flag === 'L'
          ? '<span class="rounded bg-sky-100 px-1.5 py-0.5 text-[10px] font-bold text-sky-800 dark:bg-sky-900/40 dark:text-sky-200 md:text-xs">L</span>'
          : '';
    const kindBadge = handwritten
      ? '<span class="rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-medium text-amber-800 dark:bg-amber-900/40 dark:text-amber-200 md:text-xs">✍ 手書</span>'
      : '<span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200 md:text-xs">印字</span>';
    const markedBadge = it.marked
      ? '<span class="rounded bg-rose-100 px-1.5 py-0.5 text-[10px] font-medium text-rose-800 dark:bg-rose-900/40 dark:text-rose-200 md:text-xs">⬤ 強調</span>'
      : '';
    const confBadge = lowConf
      ? '<span class="rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-medium text-amber-800 dark:bg-amber-900/40 dark:text-amber-200 md:text-xs">要確認</span>'
      : '';
    const ref =
      it.ref_low || it.ref_high
        ? `<span class="text-[11px] text-slate-500 md:text-xs">基準 ${escapeHtml(it.ref_low ?? '')} – ${escapeHtml(it.ref_high ?? '')}</span>`
        : '';
    const unit = it.unit
      ? `<span class="ml-1 text-xs text-slate-500 md:text-sm">${escapeHtml(it.unit)}</span>`
      : '';
    const labelDetail = it.label_detail
      ? `<span class="ml-1 text-xs text-slate-500 md:text-sm">${escapeHtml(it.label_detail)}</span>`
      : '';
    const no = it.no
      ? `<span class="mr-1 inline-block w-6 text-right text-[10px] text-slate-400 md:w-8 md:text-xs">${escapeHtml(it.no)}</span>`
      : '';
    const valueDisplay = it.value
      ? `<span class="text-base font-semibold md:text-lg">${escapeHtml(it.value)}</span>${unit}`
      : '<span class="italic text-slate-400">（読み取り不可）</span>';
    return `
      <li class="px-4 py-3 md:px-5 md:py-4">
        <div class="flex flex-wrap items-center gap-1.5 md:gap-2">
          ${no}
          <p class="min-w-0 flex-1 truncate text-sm font-medium md:text-base">${escapeHtml(it.label)}${labelDetail}</p>
          ${flagBadge}
          ${kindBadge}
          ${markedBadge}
          ${confBadge}
        </div>
        <div class="mt-1 flex flex-wrap items-baseline justify-between gap-3 pl-7 md:pl-9">
          <div>${valueDisplay}</div>
          ${ref}
        </div>
      </li>
    `;
  }

  function renderResult(r: AnalyzeResult): void {
    const items: ScanItem[] = r.items ?? [];
    $('result-count').textContent = items.length
      ? `${items.length} 項目を読み取りました`
      : '解析が完了しました';

    // items（ベリファイ表示: 結果 / 単位 / 基準範囲 / 強調マーク / 信頼度）
    const itemsList = $('items-list') as HTMLUListElement;
    if (items.length) {
      itemsList.innerHTML = items.map(renderItem).join('');
    } else {
      itemsList.innerHTML =
        '<li class="px-4 py-6 text-center text-sm text-slate-500 md:text-base">項目は検出されませんでした</li>';
    }

    // debug panes
    ($('scan-raw') as HTMLPreElement).textContent = r.raw ?? '(empty)';
    const finish = r.finishReason ?? '';
    const finishEl = $('scan-finish');
    finishEl.textContent = finish ? `finish: ${finish}` : '';
    finishEl.classList.toggle('bg-rose-200', finish === 'MAX_TOKENS' || finish === 'SAFETY');
    finishEl.classList.toggle('text-rose-900', finish === 'MAX_TOKENS' || finish === 'SAFETY');
    const { raw: _omit, finishReason: _omit2, ...withoutRaw } = r;
    ($('scan-result') as HTMLPreElement).textContent = JSON.stringify(withoutRaw, null, 2);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const controller = initCameraScan({
      video: $<HTMLVideoElement>('scan-video'),
      canvas: $<HTMLCanvasElement>('scan-canvas'),
      overlay: $<HTMLCanvasElement>('scan-overlay'),
      shotBtn: $<HTMLButtonElement>('scan-shot'),
      detectToggle: $<HTMLInputElement>('scan-detect-toggle'),
      status: $('scan-status'),
      hint: $<HTMLInputElement>('scan-hint'),
      onStateChange: (state: ScanState) => {
        $('busy-overlay').hidden = state !== 'busy';
        const shot = $<HTMLButtonElement>('scan-shot');
        shot.textContent = state === 'busy' ? '解析中…' : '📷 撮影 & 解析';
        if (state !== 'busy') {
          $('busy-progress').textContent = '';
        }
      },
      onCapture: (dataUrl) => {
        ($('result-image') as HTMLImageElement).src = dataUrl;
      },
      onStreamProgress: (progress) => {
        $('busy-progress').textContent = `${progress.totalLen.toLocaleString()} 文字`;
      },
      onAnalyze: (result) => {
        renderResult(result);
        controller.stop();
        show('result');
      },
      onError: (msg) => {
        $('error-message').textContent = msg;
        show('error');
      },
    });

    $('scan-start').addEventListener('click', async () => {
      show('active');
      await controller.start();
    });

    $('scan-retake').addEventListener('click', async () => {
      show('active');
      await controller.start();
    });

    $('error-retry').addEventListener('click', () => {
      $('error-message').textContent = '';
      show('ready');
    });

    $('hint-toggle').addEventListener('click', () => {
      const h = $('hint-panel');
      h.hidden = !h.hidden;
      if (!h.hidden) ($('scan-hint') as HTMLInputElement).focus();
    });

    window.addEventListener('pagehide', () => controller.stop());

    show('ready');
  });
</script>
