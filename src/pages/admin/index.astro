---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { gateByUid, notFoundForNonAdmin } from '../../lib/admin-auth';

export const prerender = false;

const url = new URL(Astro.request.url);
const u = url.searchParams.get('u');
const { allowed, uid } = gateByUid(u);
if (!allowed) {
  return notFoundForNonAdmin();
}
const qs = `?u=${encodeURIComponent(uid!)}`;
---

<BaseLayout title="管理画面 | Scan-Chat AI">
  <header class="hero-gradient px-5 pt-6 pb-4">
    <div class="flex items-center justify-between">
      <a href={`/${qs}`} class="text-xs text-slate-500 hover:text-slate-700 dark:text-slate-400">‹ メニュー</a>
      <p class="text-xs font-medium uppercase tracking-wider text-red-600/80 dark:text-red-300/80">ADMIN</p>
      <span class="w-10"></span>
    </div>
    <h1 class="mt-3 text-xl font-bold tracking-tight">⚙️ 管理画面</h1>
    <p class="mt-1 text-[11px] text-slate-600 dark:text-slate-300">
      ウェルフォート関係者向け管理機能
    </p>
  </header>

  <main class="flex flex-1 flex-col gap-3 px-5 pb-8">
    <a
      href={`/admin/lab-results/upload${qs}`}
      class="card flex items-center gap-4 transition hover:-translate-y-0.5 hover:shadow-md"
    >
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 text-white shadow-md text-xl">
        📤
      </div>
      <div class="flex-1">
        <h2 class="text-base font-semibold">検査結果アップロード</h2>
        <p class="text-xs text-slate-600 dark:text-slate-300">
          PDF / CSV を一括アップロードして Scan-Chat AI に取り込み
        </p>
      </div>
      <span aria-hidden class="text-slate-400">›</span>
    </a>

    <a
      href={`/admin/elith-batch${qs}`}
      class="card flex items-center gap-4 transition hover:-translate-y-0.5 hover:shadow-md"
    >
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-rose-500 to-red-500 text-white shadow-md text-xl">
        🧪
      </div>
      <div class="flex-1">
        <h2 class="text-base font-semibold">Elith バッチ生成</h2>
        <p class="text-xs text-slate-600 dark:text-slate-300">
          検査結果画像を AIスキャン → Elith 形式 JSON + 元画像を S3 へ (がんリスク・遺伝子 等)
        </p>
      </div>
      <span aria-hidden class="text-slate-400">›</span>
    </a>

    <div class="card text-center text-xs text-slate-500 dark:text-slate-400">
      <p>その他の管理機能は順次追加予定</p>
    </div>

    <p class="mt-4 text-center text-[10px] text-slate-400">
      この画面は管理者専用です
    </p>
  </main>
</BaseLayout>
