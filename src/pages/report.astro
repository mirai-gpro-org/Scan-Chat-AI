---
import AppIcon from '../components/AppIcon.astro';
import AppNav from '../components/AppNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadReportVM } from '../lib/elith-report-queries';
import { renderReportMarkdown } from '../lib/report-view';
import { countUnreadImportant } from '../lib/notice-queries';
import { refreshConfig, cfg } from '../lib/app-config';
import { loadDashboard, withHonorific } from '../lib/dashboard-queries';
import { AI_PREVENTION_REPORT_LABEL } from '../lib/display-names';
import { WELLNESS_AGE_LABEL } from '../lib/wellness-age';
import type { ChapterVM } from '../lib/report-model';

/**
 * AI疾病予防報告書 — 受領 JSON からアプリが組み立てた 1 本の読み物。
 *
 * 正本: `docs/elith/ai_prevention_report_generation_spec.md`
 *
 * 【役割は可読化】Elith の出力は文章の羅列で読み通せない。**並べ替えと構造化だけ**を行い、
 *   要約・言い換え・良否の判定はしない (ミッション④)。
 *   **報告書は Elith の出力以上の表記・表現を一切しない** (spec §1.0)。
 *
 * 【この画面が知っているのは表示モデルだけ】受領形式の解釈は
 *   `report-adapter.ts` が持つ。ここに正規表現を置かない (spec §1.3.3 / §1.3.4)。
 *
 * 【章立てはレジストリ駆動】順序・表示可否・見出し・既定の開閉は `app_config` から
 *   変更できる (spec §1.3.2)。この .astro に章を直書きしない。
 *
 * 【画面と印刷は同じレンダラ】`?print=1` は**モード引数**であって別実装ではない
 *   (spec §1.3.5)。章を 1 つ足したら印刷ビューにも自動で載る。
 *
 * 【旧 3 モード (a サマリー / b 要注意 / c 全編 PDF) は廃止】新形式に `[pN]` が無く
 *   原本 PDF へのページジャンプが成立しないため (spec §5.1 / §9.1)。
 */

export const prerender = false;

const url = new URL(Astro.request.url);
const u = url.searchParams.get('u');

/**
 * 印刷専用ビュー (spec §3.3)。
 * iOS の 共有→PDF は `@media print` を通らないため、**通常の画面 CSS で**
 * 全展開・UI なしの紙面を出す。どちらの経路でも同じ紙面になる。
 */
const isPrint = url.searchParams.get('print') === '1';
/** 端末別の保存手順を出すか (spec §3.6)。 */
const showSaveGuide = url.searchParams.get('save') === '1';

const authEnabled = !!import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
const needsSignIn = authEnabled && !u;

const result = needsSignIn ? null : await loadDashboard(u);
const data = !result || 'error' in result ? null : result;
const unreadNotices = data && !isPrint ? await countUnreadImportant(data.diagnosticUserId) : 0;

await refreshConfig();
const supportContact = cfg('ui.support_contact');

// ── 表示モデル ────────────────────────────────────────────────
// タイプ判定は**アプリが持つ** (その回の入力にがんリスク検査があったか)。
// Elith の出力から推測しない (spec §1.0.3)。
const hasCancerRiskTest = (data?.artifacts ?? []).some((a) => a.test_type === 'cancer_urine');
const sub = data?.subscription ?? null;

const vm = await loadReportVM(data?.diagnosticUserId ?? null, {
  name: data?.customer?.family_name
    ? withHonorific(`${data.customer.family_name} ${data.customer.given_name ?? ''}`.trim())
    : data?.appUser?.display_name_cache
      ? withHonorific(data.appUser.display_name_cache)
      : null,
  dateOfBirth: data?.customer?.date_of_birth ?? null,
  hasCancerRiskTest,
  // 検査サイクルは `customer.subscriptions` が持つ (spec §4.0.0.2)。
  // 単品購入には行が無いので、そのまま null = 表紙に出ない。
  cycle: sub?.current_cycle_seq
    ? { seq: sub.current_cycle_seq, total: 4, nextAt: sub.next_test_at ?? null }
    : null,
});

const md = (t: string): string => renderReportMarkdown(t, { u, basePath: '/report' });
const qs = (extra: Record<string, string> = {}): string => {
  const p = new URLSearchParams();
  if (u) p.set('u', u);
  for (const [k, v] of Object.entries(extra)) p.set(k, v);
  const s = p.toString();
  return s ? `?${s}` : '';
};

/** 目次。章とその見出しを並べるだけで、内容の解釈は含まない。 */
const toc = vm.chapters
  .filter((c) => c.topics.length > 0)
  .map((c) => ({ title: c.title, anchor: c.anchor, topics: c.topics }));

const axisA: ChapterVM[] = vm.chapters.filter((c) => c.axis === 'A');
const axisB: ChapterVM[] = vm.chapters.filter((c) => c.axis === 'B');

/** 印刷ビューでは折りたたまない (畳んだ状態が紙面に漏れると本文が欠ける・spec §3.2)。 */
const collapsible = (c: ChapterVM): boolean => !isPrint && c.blocks.length > 1;
---

<BaseLayout title={`${AI_PREVENTION_REPORT_LABEL} | Welltect`} width="flow">
  {!isPrint && (
    <AppNav u={u} current="/report" unreadNotices={unreadNotices} supportContact={supportContact} />
  )}

  <main class={isPrint ? 'report-print flex flex-col gap-6 px-5 pb-12 pt-6' : 'flex flex-1 flex-col gap-5 px-5 pb-12 pt-5'}>

    {/* ══════════ 表紙 ══════════ */}
    <section class="card card-hairline">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-700">Welltect</p>
      <h1 class="mt-1 flex items-center gap-2 text-2xl font-bold tracking-tight text-navy-800">
        {!isPrint && <AppIcon name="report" size={26} class="text-brand-700" />}
        {AI_PREVENTION_REPORT_LABEL}
      </h1>

      {vm.cover.name && (
        <p class="mt-2 text-lg font-bold text-navy-800">{vm.cover.name}</p>
      )}

      {/*
        作成日と版は**必ず印字する**。端末に保存された控えは回収も更新もできないので、
        その紙だけで古いかどうかを判別できる必要がある (spec §3.6 / §1.3.9)。
      */}
      <p class="mt-1 text-sm text-slate-600">
        作成日 {vm.cover.issuedOn} ・ 紙面 {vm.cover.templateVersion}
      </p>

      {vm.cover.cycle && (
        <p class="mt-1 text-sm text-slate-600">
          第 {vm.cover.cycle.seq} 回 / 全 {vm.cover.cycle.total} 回
          {vm.cover.cycle.nextAt && ` ・ 次回 ${vm.cover.cycle.nextAt.slice(0, 10)}`}
        </p>
      )}

      {vm.isSample && !isPrint && (
        <p class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-sm text-amber-800">
          <AppIcon name="info" size={14} />
          サンプル表示（受取仕様の確定前）
        </p>
      )}

      {/*
        ウェルネス年齢は **Elith 出力の値のみ**。併記しない (spec §1.3.8)。
        アプリが CABA で算出して Elith へ渡した値がそのまま返るので、本来必ず一致する。
      */}
      {vm.cover.wellnessAge != null && (
        <div class="mt-4 flex flex-wrap items-baseline gap-x-5 gap-y-1 border-t border-slate-200 pt-4">
          <span class="text-sm text-slate-600">{WELLNESS_AGE_LABEL}</span>
          <span class="text-3xl font-semibold tabular-nums text-brand-700">{vm.cover.wellnessAge}</span>
          <span class="text-sm text-slate-600">歳</span>
          {vm.cover.actualAge != null && (
            <span class="text-sm text-slate-600">（実年齢 {vm.cover.actualAge} 歳）</span>
          )}
        </div>
      )}

      {vm.cover.abstract && (
        <div class="md-region md-summary mt-4 border-t border-slate-200 pt-4" set:html={md(vm.cover.abstract)} />
      )}
    </section>

    {/*
      ══════════ 保存・印刷の導線 ══════════

      **手順は印刷専用ビューでなく、この普通の画面に出す。**
      spec §3.6 は「印刷専用ビューへ遷移して手順を出す」としているが、そうすると
      **手順そのものが保存された PDF に載る**。`@media print` で隠しても
      iOS の 共有→PDF は印刷 CSS を通らない (§3.2) ので、隠せる保証がない。
      → 手順はここで読ませ、`?print=1` は**本文だけ**にする。目的 (端末別の手順を
        必要な瞬間に出す) は満たしつつ、保存物を汚さない。
    */}
    {!isPrint && (
      <section class="card">
        <h2 class="mb-1 flex items-center gap-2 text-lg font-bold text-navy-800">
          <AppIcon name="download" size={20} class="text-brand-700" />
          手元に残す
        </h2>
        <p class="mb-3 text-sm leading-relaxed text-slate-600">
          この報告書はアプリからしか入手できません。端末に保存しておくと、通信が無いときでも読めます。
        </p>

        {!showSaveGuide ? (
          <div class="flex flex-col gap-2 sm:flex-row">
            <a
              href={`/report${qs({ save: '1' })}#save-guide`}
              class="btn-pair btn-data inline-flex min-h-touch flex-1 items-center justify-center gap-1.5 no-underline"
            >
              <AppIcon name="download" size={16} />端末に保存する
            </a>
            <a
              href={`/report${qs({ print: '1' })}`}
              class="btn-pair btn-graph inline-flex min-h-touch flex-1 items-center justify-center gap-1.5 no-underline"
            >
              <AppIcon name="report" size={16} />印刷用の表示
            </a>
          </div>
        ) : (
          /* 端末別の手順 (spec §3.6)。OS 更新で文言が変わるので**メニュー名を断定せず形で示す**。 */
          <div id="save-guide" class="flex flex-col gap-3 scroll-mt-24">
            <ol class="ml-5 flex list-decimal flex-col gap-1 text-base leading-relaxed text-slate-800">
              <li>下の<b>「印刷用の表示を開く」</b>を押します（本文だけの表示になります）</li>
              <li>お使いの端末で、次の操作をして保存します</li>
            </ol>

            <a
              href={`/report${qs({ print: '1' })}`}
              class="btn-pair btn-data inline-flex min-h-touch items-center justify-center gap-1.5 no-underline"
            >
              <AppIcon name="report" size={16} />印刷用の表示を開く
            </a>

            <dl class="flex flex-col gap-2.5 text-base leading-relaxed text-slate-800">
              <div>
                <dt class="font-semibold text-navy-800">iPhone・iPad</dt>
                <dd class="ml-0">
                  画面下（または上）の<b>共有ボタン（四角に上向きの矢印）</b>を押し、
                  一覧を上へスクロールして<b>「ファイルに保存」</b>を選びます。
                  以後は<b>「ファイル」アプリ</b>から開けます。
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-navy-800">Android</dt>
                <dd class="ml-0">
                  ブラウザの<b>メニュー（点が縦に 3 つ）</b>から<b>「印刷」</b>を選び、
                  送信先で<b>「PDF に保存」</b>を選びます。
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-navy-800">パソコン</dt>
                <dd class="ml-0"><b>Ctrl+P（Mac は ⌘+P）</b>を押し、送信先で「PDF に保存」を選びます。</dd>
              </div>
            </dl>

            <p class="text-sm leading-relaxed text-slate-600">
              保存した控えは<b>その時点のものです</b>。新しい報告書が届いても、保存済みの控えは変わりません。
              紙面の作成日（{vm.cover.issuedOn}）と版（{vm.cover.templateVersion}）でご確認ください。
            </p>
          </div>
        )}
      </section>
    )}

    {/* ══════════ 目次 ══════════ */}
    {!isPrint && toc.length > 0 && (
      <section class="card">
        <h2 class="mb-3 flex items-center gap-2 text-lg font-bold text-navy-800">
          <AppIcon name="result" size={20} class="text-brand-700" />
          この報告書の内容
        </h2>
        <ul class="flex flex-col gap-3">
          {toc.map((t) => (
            <li>
              <p class="text-base font-semibold text-navy-800">{t.title}</p>
              <ul class="mt-1 flex flex-col gap-1">
                {t.topics.map((tp) => (
                  <li>
                    <a href={`#${tp.id}`} class="text-base text-brand-800 hover:underline">{tp.heading}</a>
                    {tp.teaser && <span class="ml-1 text-sm text-slate-600">— {tp.teaser}</span>}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* ══════════ A: 初期がんの早期発見 ══════════ */}
    {axisA.map((c) => (
      <section class="card card-hairline" id={c.anchor}>
        <h2 class="mb-2 flex items-center gap-2 text-lg font-bold text-navy-800">
          <AppIcon name="cancer-risk" size={20} class="text-brand-700" />
          {c.title}
        </h2>
        <div class="md-region md-summary" set:html={md(c.body)} />
      </section>
    ))}

    {/* ══════════ B: AI 診断による疾病予防アドバイス ══════════ */}
    {axisB.map((c) => (
      <section class="card" id={c.anchor}>
        <h2 class="mb-2 text-lg font-bold text-navy-800">{c.title}</h2>

        {/* 検査値の表。**アプリは値と基準値を比べない** — 判定は Elith の原文だけ (spec §5.3)。 */}
        {c.source === 'measurements' && (
          <>
            {c.topics.map((tp) => (
              <div class="mb-3 rounded-xl border border-slate-200 bg-white p-4" id={tp.id}>
                <p class="text-base font-semibold text-navy-800">{tp.heading}</p>
                <p class="mt-1 text-base leading-relaxed text-slate-800">{tp.teaser}</p>
              </div>
            ))}
            {c.measurements.length > 0 && (
              <div class="overflow-x-auto">
                <table class="w-full text-base">
                  <thead>
                    <tr>
                      <th class="border-b border-slate-200 px-2 py-1 text-left text-sm font-semibold text-slate-600">項目</th>
                      <th class="border-b border-slate-200 px-2 py-1 text-left text-sm font-semibold text-slate-600">今回</th>
                      <th class="border-b border-slate-200 px-2 py-1 text-left text-sm font-semibold text-slate-600">基準値</th>
                    </tr>
                  </thead>
                  <tbody>
                    {c.measurements.map((m) => (
                      <tr>
                        <td class="border-b border-slate-100 px-2 py-1.5 align-baseline">
                          {m.name}{m.unit && <span class="ml-1 text-sm text-slate-500">{m.unit}</span>}
                          {/* 出どころ (spec §7.2)。2 ファイルは包含関係にないので、本文にしかない値も載せる。 */}
                          {m.source === 'report_text' && (
                            <span class="ml-1.5 whitespace-nowrap rounded border border-slate-300 px-1 text-xs text-slate-600">本文</span>
                          )}
                        </td>
                        <td class="border-b border-slate-100 px-2 py-1.5 align-baseline tabular-nums">
                          {m.value}
                          {/*
                            同名別値 (spec §7.1)。**どちらかを勝手に選ばない。**
                            届いた値をそのまま並べ、判断はしない。
                          */}
                          {m.conflict && (
                            <span class="ml-1.5 inline-flex items-center gap-1 whitespace-nowrap rounded border border-status-watch px-1 text-xs text-status-watch">
                              <AppIcon name="watch" size={11} />{new Set(m.conflict).size} 通り
                            </span>
                          )}
                        </td>
                        <td class="border-b border-slate-100 px-2 py-1.5 align-baseline text-sm text-slate-600">
                          {m.reference ?? ''}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            <p class="mt-2 text-sm leading-relaxed text-slate-600">
              値は検査機関の記載どおりです。基準値は報告書の本文に書かれている項目にだけ付いています。
              <b>本文</b>の印は、検査値の一覧ではなく報告書の文章に書かれていた値です。
            </p>
            {c.measurements.some((m) => m.conflict) && (
              <p class="mt-1 text-sm leading-relaxed text-slate-600">
                値の横に<b>「N 通り」</b>の印がある項目は、<b>同じ項目名で値が 2 通り届いています。</b>
                どちらが正しいかを当社では判断できないため、届いたまま並べています。
              </p>
            )}
          </>
        )}

        {/* 生活習慣は【現状評価】→【行動提案】のペア。維持/改善の分類はしない (spec §4.2.2)。 */}
        {c.source === 'lifestyle' && c.pairs.length > 0 && (
          <div class="flex flex-col gap-3">
            {c.pairs.map((p) => (
              <div class="rounded-xl border border-slate-200 bg-white p-4">
                <p class="text-base font-semibold text-navy-800">{p.topic}</p>
                {p.current && (
                  <div class="mt-1.5">
                    <p class="text-sm font-semibold text-slate-600">いまの状態</p>
                    <div class="md-region md-summary" set:html={md(p.current)} />
                  </div>
                )}
                {p.proposal && (
                  <div class="mt-2 border-t border-slate-100 pt-2">
                    <p class="text-sm font-semibold text-brand-700">今回の提案</p>
                    <div class="md-region md-summary" set:html={md(p.proposal)} />
                  </div>
                )}
              </div>
            ))}
            <p class="text-sm leading-relaxed text-slate-600">
              生活全体を変える提案ではありません。続けられている項目はそのままで構いません。
            </p>
          </div>
        )}

        {/* それ以外の章は見出し単位に並べる。画面では折りたためる (印刷では畳まない)。 */}
        {c.source !== 'measurements' && c.source !== 'lifestyle' && (
          c.blocks.map((b) => (
            !b.heading ? (
              <div class="md-region md-summary" id={b.id} set:html={md(b.body)} />
            ) : collapsible(c) ? (
              <details open class="border-t border-slate-100 py-1 first:border-t-0" id={b.id}>
                <summary class="cursor-pointer list-none py-1.5 text-base font-semibold text-navy-800 marker:content-none">
                  {b.heading}
                </summary>
                <div class="md-region md-summary" set:html={md(b.body)} />
              </details>
            ) : (
              <div class="border-t border-slate-100 py-1 first:border-t-0" id={b.id}>
                <p class="py-1.5 text-base font-semibold text-navy-800">{b.heading}</p>
                <div class="md-region md-summary" set:html={md(b.body)} />
              </div>
            )
          ))
        )}
      </section>
    ))}

    <p class="text-sm leading-relaxed text-slate-600">
      本報告書は Elith 社の AI が作成した診断結果をもとにしています。
      Welltect は内容を要約・加工せず、書かれている内容をそのまま整理して表示しています。
      値・基準値・判定はいずれも検査機関および Elith の記載によるもので、当社が判定を加えることはありません。
      診断・治療の判断は医療機関にご相談ください。
    </p>

    {isPrint && (
      <p class="no-print">
        <a href={`/report${qs()}`} class="text-base font-medium text-brand-700 hover:underline">← 報告書に戻る</a>
      </p>
    )}
  </main>
</BaseLayout>

<style is:global>
  /*
    印刷 CSS は**上乗せ**。`?print=1` の画面 CSS だけで紙面が成立していることが前提
    (iOS の 共有→PDF は @media print を通らない・spec §3.2 / §3.3)。
  */
  @media print {
    .no-print { display: none !important; }
    /* 章の途中で切れないようにする (spec §3.7)。 */
    .report-print section,
    .report-print table { break-inside: avoid; }
    .report-print details { break-inside: auto; }
  }
</style>
