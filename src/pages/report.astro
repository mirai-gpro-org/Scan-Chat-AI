---
import AppIcon from '../components/AppIcon.astro';
import AppNav from '../components/AppNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadReportVM } from '../lib/elith-report-queries';
import { renderReportMarkdown } from '../lib/report-view';
import { countUnreadImportant } from '../lib/notice-queries';
import { refreshConfig, cfg } from '../lib/app-config';
import { loadDashboard, getHealthAge, withHonorific, formatJpDate } from '../lib/dashboard-queries';
import { AI_PREVENTION_REPORT_LABEL } from '../lib/display-names';
import { WELLNESS_AGE_LABEL } from '../lib/wellness-age';
import { resolveViewer } from '../lib/viewer';

/**
 * AI疾病予防報告書 — 受領 JSON からアプリが生成する報告書。
 *
 * 正本: docs/elith/AI疾病予防報告書_仕様書.md  ※ § 番号は旧版 docs/旧版・ボツ/ai_prevention_report_generation_spec.md
 *
 * 【この画面の役割は可読化だけ】(spec §1.1)
 *   Elith の出力は文章の羅列で読み通せない。**出す文を選んで構造に置く**ことで読ませる。
 *   要約・言い換え・当社の散文の追加はしない (spec §1.0.0)。実測: 受領本文 20,046 字に対し
 *   最初に読む面 (ダイジェスト) は 1,567 字 = 92.2% 減。全文は下の「全編」に畳んで置く。
 *
 * 【章を直書きしない】(spec §1.3.2 / §1.3.5)
 *   構成は `report-sections.ts` のレジストリと `app_config` が決め、この画面は
 *   表示モデル (`report-model.ts`) を回すだけ。**章を足したら印刷ビューにも自動で載る。**
 *
 * 【`?print=1` は別実装ではなくモード引数】(spec §4.4)
 *   iOS の「共有 → PDF」は `@media print` を通らないため、印刷 CSS に依存した設計は採れない。
 *   全展開・UI なしを**通常の画面 CSS で**出し、`@media print` は上乗せに留める。
 */
export const prerender = false;

const url = new URL(Astro.request.url);
// 入場は Cookie で本人を判定する (`src/lib/viewer.ts`)。`?u=` は admin の代理表示のみ。
const viewer = await resolveViewer(Astro);
const u = viewer.uid;
/** 印刷/PDF 用ビュー。全展開・UI なし・ウェルネス年齢を冒頭に出す。 */
const isPrint = url.searchParams.get('print') === '1';
/** 端末に保存する手順を出すモード。**印刷ビューには置かない** (手順が PDF に載るため・spec §4.4)。 */
const showSave = url.searchParams.get('save') === '1';

const authEnabled = !!import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
const needsSignIn = authEnabled && !u;

const result = needsSignIn ? null : await loadDashboard(u);
const data = !result || 'error' in result ? null : result;
const unreadNotices = data ? await countUnreadImportant(data.diagnosticUserId) : 0;

await refreshConfig();
const supportContact = cfg('ui.support_contact');

const healthAge = data ? await getHealthAge(data.diagnosticUserId) : null;

/**
 * その回の入力にがんリスク検査があったか (spec §1.0.3)。**アプリが判定する。**
 * 見つかればその結果ページへ送れるので、主軸 A の導線もここから決まる。
 */
const cancerArtifact = (data?.artifacts ?? []).find((a) => a.test_type === 'cancer_urine') ?? null;

const vm = await loadReportVM({
  diagnosticUserId: data?.diagnosticUserId ?? null,
  name: data?.appUser?.display_name_cache ? withHonorific(data.appUser.display_name_cache) : 'お客様',
  chronologicalAge: healthAge?.latest?.chronologicalAge ?? null,
  ourWellnessAge: healthAge?.latest?.biologicalAge ?? null,
  // タイプ判定はアプリが持つ (spec §1.0.3)。Elith 出力から推測しない。
  hasCancerRisk: !!cancerArtifact,
  cycleSeq: data?.subscription?.current_cycle_seq ?? null,
});

const q = (extra: Record<string, string>) => {
  const p = new URLSearchParams();
  if (u) p.set('u', u);
  for (const [k, v] of Object.entries(extra)) p.set(k, v);
  const s = p.toString();
  return s ? `/report?${s}` : '/report';
};

const digestByAxis = (axis: 'a' | 'b') => vm.digest.filter((c) => c.axis === axis);
const chaptersByAxis = (axis: 'a' | 'b') => vm.chapters.filter((c) => c.axis === axis);
---

{/*
  幅は**ダッシュボードと同じ `app`** (発注者指示 2026-08-29)。この画面はダッシュボードの
  タイルから来るので、`flow` (lg 以上で 672px 止まり) だと PC・タブレットで直前の画面より
  急に狭くなる。**長文の行長は器ではなく本文側で 38em に止める** (`.report-prose`) ので、
  器を広げても和文 1 行が 90 字に伸びることはなく、表だけが広い幅を使える。
*/}
<BaseLayout title={`${AI_PREVENTION_REPORT_LABEL} | Welltect`} width="app">
  {!isPrint && (
    <AppNav u={u} current="/report" unreadNotices={unreadNotices} supportContact={supportContact} />
  )}

  <main class={`report-sheet flex flex-1 flex-col gap-4 px-5 pb-12 ${isPrint ? 'pt-6' : 'pt-5'}`}>

    {/* ══════════ ① 表紙 (見本 p1) ══════════
        見本の表紙は 上端 teal ルール / 淡色パネル / 右上の円モチーフ / タイトル /
        Powered by 行と細罫 / 氏名 / メタ の順。**要素の順序と装飾だけを写す**もので、
        中身 (氏名・作成日・第 N 回) はアプリのデータ (仕様書 §4.3)。 */}
    <header class="rp-cover -mx-5 px-5 py-7 sm:px-7">
      <h1 class="text-[1.75rem] font-bold leading-tight tracking-tight text-navy-800 sm:text-[2rem]">
        {AI_PREVENTION_REPORT_LABEL}
      </h1>
      <p class="rp-brandline mt-2 font-mono text-xs tracking-[0.14em] text-brand-700">
        Powered by Welltect AI Health Analysis
      </p>
      <p class="mt-5 text-lg font-bold text-navy-800">{vm.cover.name}</p>
      <p class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-600">
        <span>作成日 {formatJpDate(vm.cover.issuedOn) || vm.cover.issuedOn}</span>
        <span>紙面 {vm.cover.sheetVersion}</span>
        {vm.cover.testedOn && <span>検査 {formatJpDate(vm.cover.testedOn)}</span>}
        {vm.cover.cycleSeq && <span>第 {vm.cover.cycleSeq} 回 / 全 {vm.cover.cycleTotal} 回</span>}
      </p>

      {vm.isSample && !isPrint && (
        <p class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-sm text-amber-800">
          <AppIcon name="info" size={14} />
          サンプル表示（受取仕様の確定前）
        </p>
      )}
    </header>

    {/* ══════════ ② 2 連の大数字カード (見本 p1) ══════════
        【発注者裁定 D-C2・2026-08-29】見本は表紙に大数字を 2 連で置く。
        **画面版には出さない**（ダッシュボード上部で表示済み）が、**PDF 版は出す**
        — アプリから切り離されて単体で読まれるため (仕様書 §4.3.3)。 */}
    {isPrint && vm.cover.wellnessAge != null && (
      <div class="rp-nums">
        <div class="rp-num">
          <b class="block font-mono text-[2.4rem] font-medium leading-none text-brand-700">
            {vm.cover.wellnessAge}
          </b>
          <span class="mt-2 block text-sm text-slate-800">{WELLNESS_AGE_LABEL}</span>
        </div>
        <div class="rp-num">
          <b class="block font-mono text-[2.4rem] font-medium leading-none text-slate-700">
            {vm.cover.chronologicalAge ?? '—'}
          </b>
          <span class="mt-2 block text-sm text-slate-800">実年齢</span>
        </div>
      </div>
    )}

    {/* ══════════ 2 本柱 × ダイジェスト ══════════
        軸の帯は**常設**。材料が無い回でも消さない (spec §4.-1)。
        帯が持つのは見出しだけで、ポリシーの説明文は紙面に載せない。
        ⑤ 章扉 = 淡 teal 地 + 丸バッジ + 見出し (見本 p2/p9)。 */}
    {vm.axes.map((axis) => (
      <section class="flex flex-col gap-4">
        <div class="rp-axis mt-2 flex items-center gap-3 px-4 py-3">
          <span class="rp-badge">{axis.key === 'a' ? 'A' : 'B'}</span>
          <h2 class="text-lg font-bold leading-snug text-navy-800">{axis.title}</h2>
        </div>

        {digestByAxis(axis.key).map((card) => (
          <article class={`rp-card flex flex-col gap-2.5 ${
            card.tone === 'emergency' ? 'rp-er px-4 py-3.5' : ''
          }`}>
            {card.tone === 'emergency' && (
              <p class="inline-flex w-fit items-center gap-1.5 text-xs font-semibold text-status-action">
                <AppIcon name="error" size={14} />すぐ受診
              </p>
            )}
            {card.title && (
              <h3 class="rp-h3 text-base font-bold leading-snug text-navy-800">{card.title}</h3>
            )}

            {card.blocks.map((block) => (
              <>
                {block.kind === 'paragraphs' && block.items.map((t) => (
                  <p class="report-prose text-base leading-relaxed text-slate-800">{t}</p>
                ))}

                {/* ⑪ 箇条書き — marker は teal (見本 p3) */}
                {block.kind === 'steps' && (
                  <ol class="ml-5 flex list-decimal flex-col gap-2 text-base marker:font-semibold marker:text-brand-600">
                    {block.items.map((s) => (
                      <li>
                        <b class="text-navy-800">{s.heading}</b>
                        <span class="report-prose mt-0.5 block leading-relaxed text-slate-800">{s.text}</span>
                      </li>
                    ))}
                  </ol>
                )}

                {/* ⑩ 横テーブル — teal ヘッダ・白抜き・ゼブラなし (見本 p9/p12/p17) */}
                {block.kind === 'table' && (
                  <div class="-mx-1 overflow-x-auto">
                    <table class="rp-table text-sm">
                      <thead>
                        <tr>
                          <th>項目</th>
                          <th>今回</th>
                          <th>基準値</th>
                          <th>判定</th>
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((r) => (
                          <tr>
                            <td>
                              {r.name}
                              {/* 2 ファイルは包含関係でないので、本文にしかない値も載せる (spec §7.2)。 */}
                              {r.source === 'report_text' && (
                                <span class="ml-1 rounded bg-slate-100 px-1 text-[11px] text-slate-600">本文</span>
                              )}
                              {r.variants > 1 && (
                                <span class="ml-1 rounded bg-amber-50 px-1 text-[11px] text-amber-800">
                                  {r.variants} 通り
                                </span>
                              )}
                            </td>
                            <td class="whitespace-nowrap font-mono tabular-nums">{r.value}</td>
                            <td class="whitespace-nowrap text-xs text-slate-600">{r.reference || '—'}</td>
                            {/* 判定は Elith の原文をそのまま。色だけで意味を伝えない (アイコン+テキスト+色)。 */}
                            <td class={`min-w-[11rem] text-xs leading-snug ${
                              r.tone === 'flagged' ? 'font-semibold text-status-watch'
                              : r.tone === 'within' ? 'text-status-ok' : 'text-slate-500'
                            }`}>
                              {r.judgement || '—'}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}

                {/* ⑨ 左ラベル型テーブル (見本 p3/p6) — 現状評価 / 行動提案 */}
                {block.kind === 'pairs' && (
                  <div class="flex flex-col gap-4">
                    {block.items.map((p) => (
                      <div>
                        <h4 class="mb-1.5 text-sm font-bold text-brand-700">{p.heading}</h4>
                        <div class="rp-lrow text-base">
                          <span class="rp-lkey">現状評価</span>
                          <span class="rp-lval report-prose leading-relaxed text-slate-800">{p.current}</span>
                        </div>
                        <div class="rp-lrow text-base">
                          <span class="rp-lkey">行動提案</span>
                          <span class="rp-lval report-prose leading-relaxed text-slate-800">{p.action}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {/* 週プラン (左ラベル型の応用) */}
                {block.kind === 'weeks' && (
                  <div class="flex flex-col">
                    {block.items.map((w) => (
                      <div class="rp-wrow text-base">
                        <b class="rp-wkey">{w.heading}</b>
                        <span class="rp-wval report-prose leading-relaxed text-slate-800">{w.text}</span>
                      </div>
                    ))}
                  </div>
                )}
              </>
            ))}

            <p class="mt-0.5 font-mono text-[11px] text-slate-500">{card.source}</p>
          </article>
        ))}

        {/*
          主軸 A の導線 (spec §4.0.1「詳細はリンクで別画面へ送る」)。
          **その回にがんリスク検査があったときだけ出す。** 無い回 (タイプ 2) は送る先が
          存在しないので出さない — 押せば 404 になるリンクを置かない。
          A に材料が無い回でも帯は立つ。**アプリが代わりの所見を書かない** (spec §4.0.1)。
        */}
        {axis.key === 'a' && cancerArtifact && (
          <p class="px-1 text-sm text-slate-600">
            <a class="font-semibold text-brand-700 underline" href={`/result/${cancerArtifact.id}${u ? `?u=${u}` : ''}`}>
              がんリスク検査の結果を見る →
            </a>
          </p>
        )}

        {/*
          **軸が空でも当社の文で埋めない**【発注者裁定 D-C3・2026-08-29】
          「Elith の出力 JSON に無い文言・表現は使わない」。以前ここに当社の散文
          （「今回の受領分からは要点を取り出せませんでした」等）を置いていたが、
          裁定により撤去した。
          **黙って空になることの検知は紙面ではなく抽出監査で行う**（仕様書 §4.4 / §5.2）。
        */}
      </section>
    ))}

    {/* ══════════ 全編 ══════════
        ダイジェストで選ばれなかった文はここに全部ある。捨てていない。
        `?print=1` では**折りたたみを使わない** — 畳んだ状態が PDF に漏れると本文が欠ける
        (iOS の「共有 → PDF」は印刷 CSS を通らない・spec §4.4)。 */}
    {!!vm.chapters.length && (
      <section class="mt-4 flex flex-col gap-3">
        <h2 class="border-t border-slate-200 pt-5 text-lg font-bold text-navy-800">全編</h2>
        {(['a', 'b'] as const).flatMap((ax) => chaptersByAxis(ax)).map((ch) => (
          <details class="rp-card card" open={isPrint || !ch.collapsed}>
            <summary class={`cursor-pointer text-base font-bold text-navy-800 ${isPrint ? 'list-none' : ''}`}>
              {ch.title}
            </summary>
            <div class="md-region md-summary mt-3 flex flex-col gap-4">
              {ch.topics.map((t) => (
                <div id={t.anchor}>
                  {t.heading && <h3 class="rp-h3 text-base font-bold text-navy-800">{t.heading}</h3>}
                  <div set:html={renderReportMarkdown(t.body)} />
                </div>
              ))}

              {/* 受領した検査値の全行。ダイジェストは Elith が取り上げた 8 項目だけを出している。 */}
              {ch.table && !!ch.table.length && (
                <div class="overflow-x-auto">
                  <table class="rp-table text-sm">
                    <thead>
                      <tr>
                        <th>項目</th>
                        <th>今回</th>
                        <th>基準値</th>
                        <th>判定</th>
                      </tr>
                    </thead>
                    <tbody>
                      {ch.table.map((r) => (
                        <tr>
                          <td>
                            {r.name}
                            {r.source === 'report_text' && (
                              <span class="ml-1 rounded bg-slate-100 px-1 text-[11px] text-slate-600">本文</span>
                            )}
                            {r.variants > 1 && (
                              <span class="ml-1 rounded bg-amber-50 px-1 text-[11px] text-amber-800">
                                {r.variants} 通り
                              </span>
                            )}
                          </td>
                          <td class="whitespace-nowrap font-mono tabular-nums">{r.value}</td>
                          <td class="whitespace-nowrap text-xs text-slate-600">{r.reference || '—'}</td>
                          <td class="text-xs leading-snug text-slate-600">{r.judgement || '—'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </details>
        ))}
      </section>
    )}

    {/* ══════════ ⑬ フッター (見本 全ページ) ══════════
        見本は全ページ下に 左=報告書名/氏名・中央=ページ番号・右=作成日 の帯を置く。
        画面では不要なので **印刷時だけ** 出す (`.rp-sheet-foot`)。
        ページ番号は CSS だけでは採番できないため入れない (捏造しない)。 */}
    <div class="rp-sheet-foot hidden border-t border-slate-200 pt-2 font-mono text-[10px] text-slate-500">
      <span>{AI_PREVENTION_REPORT_LABEL}｜{vm.cover.name}</span>
      <span class="float-right">{formatJpDate(vm.cover.issuedOn) || vm.cover.issuedOn}</span>
    </div>

    {/* ══════════ 端末に残す (spec §4.4) ══════════
        主要利用者は 50〜65 代。共有シートを自力で辿らせない。
        **印刷ビューには置かない** — 手順そのものが保存された PDF に載るため。 */}
    {!isPrint && (
      <section class="mt-4 flex flex-col gap-2 border-t border-slate-200 pt-5">
        <h2 class="text-base font-bold text-navy-800">手元に残す</h2>
        <div class="flex flex-wrap gap-2">
          <a class="btn-pair btn-data" href={q({ print: '1' })}>
            <AppIcon name="report" size={16} />印刷用の紙面をひらく
          </a>
          <a class="btn-pair btn-graph" href={q({ save: '1' })}>
            <AppIcon name="download" size={16} />端末に保存する
          </a>
        </div>

        {showSave && (
          <div class="card mt-1 flex flex-col gap-2 text-base leading-relaxed">
            <p class="text-sm text-slate-700">
              印刷用の紙面をひらいてから、次の手順で保存します。
            </p>
            <ol class="ml-5 flex list-decimal flex-col gap-1 text-base">
              <li>画面下（または上）の<b>共有ボタン（□に↑の形）</b>を押します。</li>
              <li>一覧から <b>プリント</b> を選びます。</li>
              <li>出てきた紙面を <b>指 2 本で広げる</b> と PDF になります。</li>
              <li>もう一度 共有ボタン → <b>「ファイル」に保存</b> を選びます。</li>
            </ol>
            <p class="text-sm text-slate-600">
              端末や OS の版によってメニューの名前が変わることがあります。
              保存した紙面は、この画面を開かなくても読めます。
            </p>
          </div>
        )}
      </section>
    )}
  </main>
</BaseLayout>

<style is:global>
  /*
    印刷 CSS は**上乗せだけ**。`?print=1` は通常の画面 CSS で紙面が成立しているので、
    印刷 CSS が効かない経路 (iOS の 共有 → PDF) でも同じ紙面になる (spec §4.4)。
  */
  @media print {
    nav, header.app-nav, .no-print { display: none !important; }
    .report-sheet { padding: 0 !important; }
    .card, .rp-card, .report-sheet table, .report-sheet details { break-inside: avoid; }
    details > summary { list-style: none; }
  }
</style>
