---
import '../styles/global.css';
import GoogleOneTap from '../components/GoogleOneTap.astro';
import { LOGO } from '../lib/brand.ts';

interface Props {
  title?: string;
  description?: string;
  /**
   * 本文の最大幅。
   *   'app'   … 業務画面 (ダッシュボード/進捗/結果)。PC まで広げる。
   *   'flow'  … 単一導線 (問診/スキャン/サインイン)。読みやすさ優先で中幅に留める。
   *   'full'  … 幅制御を親に委ねる。
   * 既定は 'flow' (従来の max-w-md 相当の挙動に最も近い)。
   */
  width?: 'app' | 'flow' | 'full';
}

const {
  title = 'Welltect',
  description = 'Welltect — 検査結果とAI診断を、わかりやすく整理してお届けします。',
  width = 'flow',
} = Astro.props;

// F-A3 のブレークポイント (sm640 / md768 / lg1024 / xl1280) に沿う。
// 従来は全ページ max-w-md 固定で、PC で極端に間延びしていた。
const WIDTH = {
  // 業務画面は PC で本文が間延びしない範囲まで広げる。lg 以上は 2 カラムに
  // 組む前提の幅で、単一カラムのまま広げるとタブレット表示のまま巨大化する。
  //
  // **md (768px) の段を必ず置く**。sm(640) の次が lg(1024) だと、その間の
  // タブレット (iPad 縦 834px 等) が 672px で頭打ちになり、左右に 80px ずつ
  // 余白が残って間延びして見える (実測 2026-08)。
  app:  'w-full max-w-md sm:max-w-2xl md:max-w-3xl lg:max-w-5xl xl:max-w-7xl 2xl:max-w-[88rem]',
  // flow は読み物向けなので意図的に狭い (和文 38 字前後に収める)。広げない。
  flow: 'w-full max-w-md sm:max-w-xl lg:max-w-2xl',
  full: 'w-full',
} as const;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <!-- Executive Navy。ダークモードは提供しないため単一値。 -->
    <meta name="theme-color" content="#102B3A" />
    {/*
      Welltect ロゴ (public/welltect_logo.svg 等) が置かれていればそれを favicon に使う。
      未配置のあいだは暫定の favicon.svg にフォールバックする。
    */}
    <link
      rel="icon"
      type={LOGO.pending ? 'image/svg+xml' : undefined}
      href={LOGO.pending ? '/favicon.svg' : LOGO.src}
    />

    {/*
      ホーム画面に追加したときのアイコン / 表示名。
        - Android (Chrome) は manifest の icons を使う。192 と 512 が必須
          (web.dev/articles/install-criteria の installability criteria)。
        - iOS Safari は manifest ではなく `apple-touch-icon` を使う
          (Apple: Configuring Web Applications)。180x180 を 1 枚置く。
        - 画像は scripts/build-pwa-icons.mjs が Welltect ロゴから生成する
          (ロゴは加工せず、白地の正方形に余白付きで配置するだけ)。
    */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Welltect" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <title>{title}</title>
  </head>
  <body class="min-h-full">
    <div class={`mx-auto flex min-h-screen flex-col safe-top safe-bottom ${WIDTH[width]}`}>
      <slot />
    </div>
    {/* Google One Tap (PUBLIC_GOOGLE_CLIENT_ID 未設定なら何もレンダリングしない) */}
    <GoogleOneTap />
  </body>
</html>
